---
// PerfMonitor.astro — Automated Performance Telemetry Collector & Server Logger
---

<div id="perf-monitor-hud" class="perf-hud hidden">
    <div class="perf-pill" id="perf-hud-trigger" title="Click or press Shift+P to toggle details">
        <span class="perf-status-dot" id="perf-status-dot"></span>
        <span class="perf-metric" id="perf-fps-val">60 FPS</span>
        <span class="perf-divider">|</span>
        <span class="perf-metric" id="perf-mem-val">-- MB</span>
        <span class="perf-spike-badge hidden" id="perf-spike-badge">⚡ 0</span>
    </div>

    <!-- Detailed Diagnostic Panel -->
    <div class="perf-panel hidden" id="perf-hud-panel">
        <div class="perf-panel-header">
            <span class="perf-panel-title">PERFORMANCE TELEMETRY LOG</span>
            <button id="perf-panel-close" class="perf-panel-close-btn" type="button">&times;</button>
        </div>

        <div class="perf-grid">
            <div class="perf-card">
                <span class="perf-card-label">Frame Rate</span>
                <span class="perf-card-value" id="perf-fps-detail">60 FPS</span>
                <span class="perf-card-sub" id="perf-fps-target">Target: 60 FPS</span>
            </div>
            <div class="perf-card">
                <span class="perf-card-label">JS Heap Memory</span>
                <span class="perf-card-value" id="perf-mem-detail">-- MB</span>
                <span class="perf-card-sub" id="perf-mem-limit">Limit: -- MB</span>
            </div>
            <div class="perf-card">
                <span class="perf-card-label">Main Thread Spikes</span>
                <span class="perf-card-value" id="perf-spikes-detail">0</span>
                <span class="perf-card-sub" id="perf-last-spike">Last: None</span>
            </div>
            <div class="perf-card">
                <span class="perf-card-label">Active Canvases</span>
                <span class="perf-card-value" id="perf-canvas-count">0</span>
                <span class="perf-card-sub" id="perf-dom-count">DOM: -- nodes</span>
            </div>
        </div>

        <div class="perf-section-title">Media & Canvas Inspection</div>
        <div class="perf-media-list" id="perf-media-list">
            <div class="perf-media-empty">Scanning page elements...</div>
        </div>

        <div class="perf-panel-footer">
            <span>Logging to <code style="color:#42bd49">perf-telemetry.json</code> (Press Shift+P)</span>
        </div>
    </div>
</div>

<style>
    .perf-hud {
        position: fixed;
        bottom: 16px;
        left: 16px;
        z-index: 999999;
        font-family: var(--font-mono, monospace);
        font-size: 11px;
        user-select: none;
        pointer-events: auto;
    }

    .perf-hud.hidden {
        display: none !important;
    }

    .perf-pill {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 5px 12px;
        background: rgba(15, 15, 18, 0.88);
        backdrop-filter: blur(12px) saturate(180%);
        -webkit-backdrop-filter: blur(12px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 999px;
        color: #e4e4e7;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
        cursor: pointer;
        transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease;
    }

    .perf-pill:hover {
        transform: translateY(-1px);
        border-color: var(--accent-secondary, #42bd49);
        background: rgba(20, 20, 25, 0.95);
    }

    .perf-status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 8px #22c55e;
        transition: background 0.3s ease, box-shadow 0.3s ease;
    }

    .perf-status-dot.warning {
        background: #eab308;
        box-shadow: 0 0 8px #eab308;
    }

    .perf-status-dot.danger {
        background: #ef4444;
        box-shadow: 0 0 10px #ef4444;
        animation: perf-pulse 1s infinite;
    }

    @keyframes perf-pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }

    .perf-metric {
        font-weight: 500;
        letter-spacing: -0.02em;
    }

    .perf-divider {
        opacity: 0.3;
    }

    .perf-spike-badge {
        background: rgba(239, 68, 68, 0.2);
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.4);
        padding: 1px 6px;
        border-radius: 4px;
        font-size: 10px;
        font-weight: 600;
    }

    .perf-spike-badge.hidden {
        display: none !important;
    }

    .perf-panel {
        position: absolute;
        bottom: 38px;
        left: 0;
        width: 320px;
        max-height: 420px;
        background: rgba(12, 12, 14, 0.94);
        backdrop-filter: blur(20px) saturate(200%);
        -webkit-backdrop-filter: blur(20px) saturate(200%);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 12px;
        padding: 14px;
        box-shadow: 0 12px 36px rgba(0, 0, 0, 0.6);
        display: flex;
        flex-direction: column;
        gap: 12px;
        overflow: hidden;
        animation: perf-slide-up 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .perf-panel.hidden {
        display: none !important;
    }

    @keyframes perf-slide-up {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .perf-panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 8px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .perf-panel-title {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: #a1a1aa;
        text-transform: uppercase;
    }

    .perf-panel-close-btn {
        background: transparent;
        border: none;
        color: #71717a;
        font-size: 16px;
        cursor: pointer;
        line-height: 1;
        padding: 0 4px;
    }

    .perf-panel-close-btn:hover {
        color: #ffffff;
    }

    .perf-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .perf-card {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 8px;
        padding: 8px 10px;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .perf-card-label {
        font-size: 9px;
        color: #71717a;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .perf-card-value {
        font-size: 14px;
        font-weight: 700;
        color: #f4f4f5;
    }

    .perf-card-sub {
        font-size: 9px;
        color: #a1a1aa;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .perf-section-title {
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #71717a;
        margin-top: 4px;
    }

    .perf-media-list {
        max-height: 140px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding-right: 2px;
    }

    .perf-media-item {
        font-size: 10px;
        padding: 5px 8px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 6px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #d4d4d8;
    }

    .perf-media-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 190px;
    }

    .perf-media-badge {
        font-size: 9px;
        padding: 1px 5px;
        border-radius: 4px;
        background: rgba(59, 130, 246, 0.2);
        color: #93c5fd;
        font-weight: 600;
    }

    .perf-media-badge.heavy {
        background: rgba(239, 68, 68, 0.2);
        color: #fca5a5;
    }

    .perf-media-empty {
        font-size: 10px;
        color: #71717a;
        font-style: italic;
        padding: 8px 0;
    }

    .perf-panel-footer {
        font-size: 9px;
        color: #71717a;
        text-align: center;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        padding-top: 8px;
    }

    kbd {
        background: rgba(255, 255, 255, 0.1);
        padding: 1px 4px;
        border-radius: 3px;
        color: #d4d4d8;
    }
</style>

<script>
    function setupPerfTelemetry() {
        const hud = document.getElementById('perf-monitor-hud');
        if (!hud) return;

        // Toggle UI HUD with Shift+P or URL ?perf=1
        let hudVisible = localStorage.getItem('portfolio_perf_hud') === 'true' || new URLSearchParams(window.location.search).has('perf');
        if (hudVisible) {
            hud.classList.remove('hidden');
        }

        const trigger = document.getElementById('perf-hud-trigger');
        const panel = document.getElementById('perf-hud-panel');
        const closeBtn = document.getElementById('perf-panel-close');

        const fpsVal = document.getElementById('perf-fps-val');
        const memVal = document.getElementById('perf-mem-val');
        const statusDot = document.getElementById('perf-status-dot');
        const spikeBadge = document.getElementById('perf-spike-badge');

        const fpsDetail = document.getElementById('perf-fps-detail');
        const memDetail = document.getElementById('perf-mem-detail');
        const memLimit = document.getElementById('perf-mem-limit');
        const spikesDetail = document.getElementById('perf-spikes-detail');
        const lastSpike = document.getElementById('perf-last-spike');
        const canvasCount = document.getElementById('perf-canvas-count');
        const domCount = document.getElementById('perf-dom-count');
        const mediaList = document.getElementById('perf-media-list');

        trigger?.addEventListener('click', (e) => {
            e.stopPropagation();
            panel?.classList.toggle('hidden');
            if (!panel?.classList.contains('hidden')) {
                inspectPageMedia();
            }
        });

        closeBtn?.addEventListener('click', () => {
            panel?.classList.add('hidden');
        });

        window.addEventListener('keydown', (e) => {
            if (e.shiftKey && (e.key === 'P' || e.key === 'p')) {
                hudVisible = !hudVisible;
                localStorage.setItem('portfolio_perf_hud', String(hudVisible));
                if (hudVisible) {
                    hud.classList.remove('hidden');
                } else {
                    hud.classList.add('hidden');
                }
            }
        });

        // ===== 1. FPS Tracker =====
        let frameCount = 0;
        let lastFpsCheck = performance.now();
        let currentFps = 60;

        function calcFps(now: number) {
            frameCount++;
            const delta = now - lastFpsCheck;
            if (delta >= 1000) {
                currentFps = Math.round((frameCount * 1000) / delta);
                frameCount = 0;
                lastFpsCheck = now;
                updateHudUI();
            }
            requestAnimationFrame(calcFps);
        }
        requestAnimationFrame(calcFps);

        // ===== 2. Long Task & Spike Detector =====
        let spikeCount = 0;
        let lastSpikeDuration = 0;
        let lastSpikeTime = '';

        if ('PerformanceObserver' in window) {
            try {
                const observer = new PerformanceObserver((list) => {
                    for (const entry of list.getEntries()) {
                        if (entry.duration > 50) { // Spikes > 50ms
                            spikeCount++;
                            lastSpikeDuration = Math.round(entry.duration);
                            const nowStr = new Date().toLocaleTimeString();
                            lastSpikeTime = `${lastSpikeDuration}ms @ ${nowStr}`;

                            // Report lag spike to server API immediately
                            reportTelemetryToServer('SPIKE', lastSpikeDuration);

                            if (spikeBadge) {
                                spikeBadge.classList.remove('hidden');
                                spikeBadge.textContent = `⚡ ${spikeCount}`;
                            }
                        }
                    }
                });
                observer.observe({ entryTypes: ['longtask'] });
            } catch {
                // longtask observer not supported
            }
        }

        // ===== 3. Automatic Telemetry Reporter to Server (/api/log-perf) =====
        let lastLoggedMem = 0;

        async function reportTelemetryToServer(eventReason = 'PERIODIC', spikeMs = 0) {
            try {
                const perfObj = (performance as any);
                let usedMemMb = 0;
                let totalMemMb = 0;

                if (perfObj.memory) {
                    usedMemMb = Math.round(perfObj.memory.usedJSHeapSize / (1024 * 1024));
                    totalMemMb = Math.round(perfObj.memory.jsHeapSizeLimit / (1024 * 1024));
                }

                // Collect media summary
                const canvasElements = Array.from(document.querySelectorAll('canvas')).map((c) => ({
                    id: c.id || 'anonymous-canvas',
                    width: c.width,
                    height: c.height,
                }));

                const heavyImages = Array.from(document.querySelectorAll('img'))
                    .filter((img) => img.src.endsWith('.gif') || img.naturalWidth > 1200)
                    .map((img) => img.src.split('/').pop()?.split('?')[0] || 'Image');

                const pdfCount = document.querySelectorAll('.pdf-viewer-wrapper').length;

                const payload = {
                    event: eventReason,
                    route: window.location.pathname,
                    fps: currentFps,
                    usedMemMb,
                    totalMemMb,
                    spikeMs,
                    canvasesCount: canvasElements.length,
                    canvases: canvasElements,
                    domNodes: document.querySelectorAll('*').length,
                    pdfCount,
                    heavyMedia: heavyImages,
                };

                await fetch('/api/log-perf', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload),
                    keepalive: true,
                });
            } catch {
                // Ignore API network errors
            }
        }

        // Report periodic snapshot every 5 seconds, or if memory jumps > 30MB
        setInterval(() => {
            const perfObj = (performance as any);
            const currentMem = perfObj.memory ? Math.round(perfObj.memory.usedJSHeapSize / (1024 * 1024)) : 0;

            if (Math.abs(currentMem - lastLoggedMem) > 30 || currentFps < 45) {
                lastLoggedMem = currentMem;
                reportTelemetryToServer('MEM_CHANGE');
            } else {
                reportTelemetryToServer('PERIODIC');
            }
        }, 5000);

        // Initial snapshot
        setTimeout(() => reportTelemetryToServer('INIT'), 1000);

        // ===== 4. Memory & UI Updater =====
        function updateHudUI() {
            const perfObj = (performance as any);
            let usedMemMb = 0;
            let totalMemMb = 0;

            if (perfObj.memory) {
                usedMemMb = Math.round(perfObj.memory.usedJSHeapSize / (1024 * 1024));
                totalMemMb = Math.round(perfObj.memory.jsHeapSizeLimit / (1024 * 1024));
            }

            if (fpsVal) fpsVal.textContent = `${currentFps} FPS`;
            if (memVal) memVal.textContent = usedMemMb > 0 ? `${usedMemMb} MB` : 'N/A';

            if (statusDot) {
                if (currentFps < 30 || usedMemMb > 400) {
                    statusDot.className = 'perf-status-dot danger';
                } else if (currentFps < 50 || usedMemMb > 250) {
                    statusDot.className = 'perf-status-dot warning';
                } else {
                    statusDot.className = 'perf-status-dot';
                }
            }

            if (!panel?.classList.contains('hidden')) {
                if (fpsDetail) fpsDetail.textContent = `${currentFps} FPS`;
                if (memDetail) memDetail.textContent = usedMemMb > 0 ? `${usedMemMb} MB` : 'N/A';
                if (memLimit) memLimit.textContent = totalMemMb > 0 ? `Limit: ${totalMemMb} MB` : 'Browser managed';
                if (spikesDetail) spikesDetail.textContent = String(spikeCount);
                if (lastSpike) lastSpike.textContent = lastSpikeTime ? `Last: ${lastSpikeTime}` : 'Last: None';

                const canvases = document.querySelectorAll('canvas');
                if (canvasCount) canvasCount.textContent = String(canvases.length);
                if (domCount) domCount.textContent = `DOM: ${document.querySelectorAll('*').length} nodes`;
            }
        }

        function inspectPageMedia() {
            if (!mediaList) return;
            mediaList.innerHTML = '';

            const items: { name: string; info: string; isHeavy: boolean }[] = [];

            document.querySelectorAll('canvas').forEach((c, idx) => {
                const idStr = c.id ? `#${c.id}` : `Canvas ${idx + 1}`;
                const res = `${c.width}x${c.height}px`;
                items.push({
                    name: idStr,
                    info: res,
                    isHeavy: c.width > 2000 || c.height > 2000,
                });
            });

            document.querySelectorAll('img').forEach((img) => {
                const src = img.src || '';
                const filename = src.split('/').pop()?.split('?')[0] || 'Image';
                const isGif = src.endsWith('.gif');
                if (isGif || img.width > 1200) {
                    items.push({
                        name: filename,
                        info: isGif ? 'Animated GIF' : `${img.naturalWidth || img.width}px`,
                        isHeavy: isGif,
                    });
                }
            });

            document.querySelectorAll('.pdf-viewer-wrapper').forEach((_, idx) => {
                items.push({
                    name: `PDF Embed ${idx + 1}`,
                    info: 'PDF.js Canvas',
                    isHeavy: true,
                });
            });

            if (items.length === 0) {
                mediaList.innerHTML = '<div class="perf-media-empty">No heavy media or canvases on page</div>';
                return;
            }

            items.slice(0, 8).forEach((item) => {
                const row = document.createElement('div');
                row.className = 'perf-media-item';
                row.innerHTML = `
                    <span class="perf-media-name" title="${item.name}">${item.name}</span>
                    <span class="perf-media-badge ${item.isHeavy ? 'heavy' : ''}">${item.info}</span>
                `;
                mediaList.appendChild(row);
            });
        }

        setInterval(updateHudUI, 1000);
    }

    setupPerfTelemetry();
    document.addEventListener('astro:page-load', setupPerfTelemetry);
</script>
