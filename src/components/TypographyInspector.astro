---
// TypographyInspector.astro
// Dynamic visual typography editor widget for selecting and tuning element styles in real-time.
// Activated by holding Ctrl (or Cmd) and clicking any text element.
---

<!-- Editor Control Panel Panel -->
<aside class="inspector-panel typo-inspector-widget" id="typo-inspector-panel" data-lenis-prevent style="display: none;">
  <div class="panel-header">
    <div class="header-title-row">
      <h3>Typography Editor</h3>
      <button class="close-btn" id="typo-inspector-close" aria-label="Close panel">&times;</button>
    </div>
    <p class="panel-subtitle">Hold <kbd class="key-cap">Ctrl</kbd> or <kbd class="key-cap">Cmd</kbd> and click any text to edit.</p>
  </div>

  <!-- Active Style Controls -->
  <div class="controls-content" id="typo-controls-content" data-lenis-prevent>
    <div class="control-group">
      <label for="typo-selector-input">CSS Target Selector</label>
      <input type="text" id="typo-selector-input" class="text-input" placeholder="e.g. h1, .bio-text" />
      <span class="helper-text">Edits will apply to all elements matching this selector.</span>
    </div>

    <div class="control-group">
      <label for="typo-font-family">Font Family</label>
      <select id="typo-font-family" class="dropdown-input">
        <option value="geist">Geist (Default)</option>
        <option value="google-sans">Google Sans</option>
        <option value="public-sans">Public Sans</option>
        <option value="noto-sans">Noto Sans</option>
        <option value="general-sans">General Sans</option>
        <option value="inter">Inter</option>
        <option value="instrument-sans">Instrument Sans</option>
        <option value="serif">System Serif</option>
        <option value="nunito-sans">Nunito Sans</option>
        <option value="ibm-plex">IBM Plex Sans</option>
        <option value="bricolage-grotesque">Bricolage Grotesque</option>
        <option value="open-sans">Open Sans</option>
      </select>
    </div>

    <div class="control-group">
      <div class="label-row">
        <label for="typo-font-size">Font Size</label>
        <span class="value-badge" id="val-typo-size">16px</span>
      </div>
      <input type="range" id="typo-font-size" min="8" max="120" value="16" step="1" />
    </div>

    <div class="control-group">
      <div class="label-row">
        <label for="typo-font-weight">Font Weight (Thickness)</label>
        <span class="value-badge" id="val-typo-weight">400</span>
      </div>
      <input type="range" id="typo-font-weight" min="100" max="900" value="400" step="50" />
    </div>

    <div class="control-group">
      <div class="label-row">
        <label for="typo-letter-spacing">Letter Spacing</label>
        <span class="value-badge" id="val-typo-spacing">0em</span>
      </div>
      <input type="range" id="typo-letter-spacing" min="-0.08" max="0.3" value="0" step="0.005" />
    </div>

    <div class="control-group">
      <div class="label-row">
        <label for="typo-line-height">Line Height</label>
        <span class="value-badge" id="val-typo-lh">1.2</span>
      </div>
      <input type="range" id="typo-line-height" min="0.8" max="2.5" value="1.2" step="0.05" />
    </div>

    <div class="export-section">
      <div class="export-header">
        <h4>CSS Override Code</h4>
        <button class="copy-code-btn" id="typo-copy-code">Copy</button>
      </div>
      <pre class="code-preview" id="typo-code-preview">/* Select an element to generate code */</pre>
    </div>

    <div class="action-buttons-row">
      <button class="action-btn btn-save" id="typo-save-btn">Save to Code</button>
      <button class="action-btn btn-reset" id="typo-reset-btn">Reset</button>
    </div>
  </div>
</aside>

<style>
  /* Inspector widget scoping and styling */
  .typo-inspector-widget {
    display: none; /* Controlled via JS */
    position: fixed;
    z-index: 10000;
    width: 320px;
    max-height: calc(100vh - 100px);
    background: rgba(14, 14, 14, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
    flex-direction: column;
    gap: 16px;
    color: #DADDD0;
    font-family: 'Google Sans', -apple-system, sans-serif;
    animation: zoomIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes zoomIn {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .panel-header {
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 12px;
  }

  .header-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }

  .header-title-row h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .close-btn {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.4);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    margin-top: -6px;
    transition: color 0.15s ease;
  }

  .close-btn:hover {
    color: #ffffff;
  }

  .panel-subtitle {
    font-size: 0.72rem;
    color: #888888;
    line-height: 1.3;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .key-cap {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 1px 4px;
    border-radius: 4px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 10px;
    color: #ffffff;
    line-height: 1;
  }

  /* Controls list container */
  .controls-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-height: 380px;
    overflow-y: auto;
    padding-right: 2px;
  }

  .controls-content::-webkit-scrollbar {
    width: 4px;
  }

  .controls-content::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 99px;
  }

  .control-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .control-group label {
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.7);
  }

  .label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .value-badge {
    font-family: 'Geist Mono', monospace;
    font-size: 0.7rem;
    color: var(--accent-secondary, #42BD49);
    background: rgba(66, 189, 73, 0.08);
    padding: 1px 6px;
    border-radius: 4px;
  }

  .text-input,
  .dropdown-input {
    width: 100%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    color: #ffffff;
    padding: 6px 10px;
    font-size: 0.8rem;
    outline: none;
    transition: border 0.15s ease;
  }

  .text-input:focus,
  .dropdown-input:focus {
    border-color: var(--accent-secondary, #42BD49);
  }

  .helper-text {
    font-size: 0.65rem;
    color: #666666;
    margin-top: 1px;
  }

  input[type="range"] {
    width: 100%;
    height: 4px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 99px;
    outline: none;
    accent-color: var(--accent-secondary, #42BD49);
    transition: background 0.15s ease;
  }

  /* Code output block */
  .export-section {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    padding: 10px;
    margin-top: 6px;
  }

  .export-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }

  .export-header h4 {
    margin: 0;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.5);
  }

  .copy-code-btn {
    background: rgba(255, 255, 255, 0.08);
    border: none;
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 500;
    padding: 2px 8px;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .copy-code-btn:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .code-preview {
    margin: 0;
    font-family: 'Geist Mono', monospace;
    font-size: 0.68rem;
    color: #88ee88;
    white-space: pre-wrap;
    word-break: break-all;
    max-height: 140px;
    overflow-y: auto;
  }

  /* Action buttons */
  .action-buttons-row {
    display: flex;
    gap: 8px;
    margin-top: 4px;
  }

  .action-btn {
    flex: 1;
    padding: 8px;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-save {
    background: var(--accent-secondary, #42BD49);
    border: 1px solid rgba(0, 0, 0, 0.1);
    color: #000000;
  }

  .btn-save:hover {
    background: #52cd59;
  }

  .btn-reset {
    background: transparent;
    border: 1px solid rgba(255, 82, 82, 0.4);
    color: #FF5252;
  }

  .btn-reset:hover {
    background: rgba(255, 82, 82, 0.1);
  }

  /* Highlight outlines on the page elements */
  :global(.typo-inspect-hover) {
    outline: 1.5px dashed var(--accent-secondary, #42BD49) !important;
    outline-offset: 2px !important;
    cursor: crosshair !important;
  }
  :global(.typo-inspect-selected) {
    outline: 2px solid var(--accent-secondary, #42BD49) !important;
    outline-offset: 2px !important;
  }
</style>

<script>
  // Typography Inspector Client Script
  const FONTS_MAP: Record<string, { family: string; cdn?: string }> = {
    geist: { family: "'Geist', sans-serif" },
    "google-sans": {
      family: "'Google Sans', sans-serif",
      cdn: "https://cdn.jsdelivr.net/npm/@fontsource/google-sans@5.0.1/index.min.css"
    },
    "public-sans": {
      family: "'Public Sans', sans-serif",
      cdn: "https://fonts.googleapis.com/css2?family=Public+Sans:wght@100..900&display=swap"
    },
    "noto-sans": {
      family: "'Noto Sans', sans-serif",
      cdn: "https://fonts.googleapis.com/css2?family=Noto+Sans:wght@100..900&display=swap"
    },
    "general-sans": {
      family: "'General Sans', sans-serif",
      cdn: "https://api.fontshare.com/v2/css?f[]=general-sans@200,300,400,500,600,700,800&display=swap"
    },
    inter: {
      family: "'Inter', sans-serif",
      cdn: "https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap"
    },
    "instrument-sans": {
      family: "'Instrument Sans', sans-serif",
      cdn: "https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400..700&display=swap"
    },
    serif: { family: "Georgia, 'Times New Roman', serif" },
    "nunito-sans": {
      family: "'Nunito Sans', sans-serif",
      cdn: "https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@200..900&display=swap"
    },
    "ibm-plex": {
      family: "'IBM Plex Sans', sans-serif",
      cdn: "https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@100..700&display=swap"
    },
    "bricolage-grotesque": {
      family: "'Bricolage Grotesque', sans-serif",
      cdn: "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@200..800&display=swap"
    },
    "open-sans": {
      family: "'Open Sans', sans-serif",
      cdn: "https://fonts.googleapis.com/css2?family=Open+Sans:wght@300..800&display=swap"
    }
  };

  // State Variables
  let selectedElement: HTMLElement | null = null;
  let hoveredElement: HTMLElement | null = null;

  // DOM Elements
  const closeBtn = document.getElementById('typo-inspector-close');
  const panel = document.getElementById('typo-inspector-panel') as HTMLElement;

  // Control Inputs
  const selectorInput = document.getElementById('typo-selector-input') as HTMLInputElement;
  const fontSelect = document.getElementById('typo-font-family') as HTMLSelectElement;
  const sizeSlider = document.getElementById('typo-font-size') as HTMLInputElement;
  const weightSlider = document.getElementById('typo-font-weight') as HTMLInputElement;
  const spacingSlider = document.getElementById('typo-letter-spacing') as HTMLInputElement;
  const lhSlider = document.getElementById('typo-line-height') as HTMLInputElement;

  // Value Badges
  const valSize = document.getElementById('val-typo-size');
  const valWeight = document.getElementById('val-typo-weight');
  const valSpacing = document.getElementById('val-typo-spacing');
  const valLh = document.getElementById('val-typo-lh');

  // Clipboard / Actions
  const codePreview = document.getElementById('typo-code-preview');
  const copyBtn = document.getElementById('typo-copy-code');
  const saveBtn = document.getElementById('typo-save-btn');
  const resetBtn = document.getElementById('typo-reset-btn');

  // Dynamic overrides store
  const activeOverrides: Record<string, {
    family: string;
    size: string;
    weight: string;
    spacing: string;
    lh: string;
  }> = {};

  let currentEditingSelector = '';

  if (closeBtn) {
    closeBtn.addEventListener('click', closeInspector);
  }

  function closeInspector() {
    if (panel) {
      panel.style.display = 'none';
    }
    clearSelection();
    clearHighlight();
  }

  // Hover and selection Event Listeners triggered by holding Ctrl/Cmd
  document.body.addEventListener('mousemove', (e) => {
    const isCtrl = e.ctrlKey || e.metaKey;
    
    if (!isCtrl) {
      clearHighlight();
      return;
    }

    const target = e.target as HTMLElement;
    if (!target || target.closest('.typo-inspector-widget')) return;
    
    // Check if element has text
    if (!hasTextContent(target)) {
      clearHighlight();
      return;
    }

    if (hoveredElement && hoveredElement !== target) {
      hoveredElement.classList.remove('typo-inspect-hover');
    }
    
    hoveredElement = target;
    hoveredElement.classList.add('typo-inspect-hover');
  });

  // Ensure highlight clears when Ctrl/Cmd is released
  window.addEventListener('keyup', (e) => {
    if (e.key === 'Control' || e.key === 'Meta') {
      clearHighlight();
    }
  });

  document.body.addEventListener('click', (e) => {
    const isCtrl = e.ctrlKey || e.metaKey;
    if (!isCtrl) return;

    const target = e.target as HTMLElement;
    if (!target || target.closest('.typo-inspector-widget')) return;

    if (!hasTextContent(target)) return;

    e.preventDefault();
    e.stopPropagation();

    selectElement(target, e);
  });

  function hasTextContent(el: HTMLElement): boolean {
    const tags = ['P', 'SPAN', 'A', 'H1', 'H2', 'H3', 'H4', 'H5', 'H6', 'LI', 'STRONG', 'B', 'EM', 'I', 'CODE', 'LABEL', 'BUTTON'];
    if (tags.includes(el.tagName)) return true;

    // Check if direct child nodes have any text
    for (let i = 0; i < el.childNodes.length; i++) {
      if (el.childNodes[i].nodeType === Node.TEXT_NODE && el.childNodes[i].textContent?.trim() !== '') {
        return true;
      }
    }
    return false;
  }

  function selectElement(el: HTMLElement, clickEvent: MouseEvent) {
    clearSelection();
    selectedElement = el;
    selectedElement.classList.add('typo-inspect-selected');
    clearHighlight();

    // Populate panel selector
    const selector = getSelector(el);
    currentEditingSelector = selector;
    if (selectorInput) {
      selectorInput.value = selector;
    }

    // Read Computed Style Properties
    const style = window.getComputedStyle(el);
    
    // Font family mapping
    let familyName = style.fontFamily.replace(/['"]/g, '');
    let matchedFamily = 'geist';
    for (const [key, font] of Object.entries(FONTS_MAP)) {
      const compareFamily = font.family.replace(/['"]/g, '').split(',')[0];
      if (familyName.toLowerCase().includes(compareFamily.toLowerCase())) {
        matchedFamily = key;
        break;
      }
    }
    if (fontSelect) fontSelect.value = matchedFamily;

    // Font size parser
    const computedSize = parseFloat(style.fontSize);
    if (sizeSlider) {
      sizeSlider.value = computedSize.toString();
      if (valSize) valSize.textContent = `${Math.round(computedSize)}px`;
    }

    // Font weight parser
    const computedWeight = parseInt(style.fontWeight) || 400;
    if (weightSlider) {
      weightSlider.value = computedWeight.toString();
      if (valWeight) valWeight.textContent = computedWeight.toString();
    }

    // Letter spacing parser
    let computedSpacing = parseFloat(style.letterSpacing);
    if (isNaN(computedSpacing)) computedSpacing = 0;
    const spacingEm = computedSpacing / computedSize;
    if (spacingSlider) {
      spacingSlider.value = spacingEm.toFixed(3);
      if (valSpacing) valSpacing.textContent = `${spacingEm.toFixed(3)}em`;
    }

    // Line height parser
    let ratio = 1.2;
    if (style.lineHeight && style.lineHeight !== 'normal') {
      const lhPx = parseFloat(style.lineHeight);
      const fsPx = parseFloat(style.fontSize);
      if (!isNaN(lhPx) && !isNaN(fsPx) && fsPx > 0) {
        ratio = parseFloat((lhPx / fsPx).toFixed(2));
      }
    }
    if (lhSlider) {
      lhSlider.value = ratio.toString();
      if (valLh) valLh.textContent = ratio.toString();
    }

    updateCSSPreview();

    // Show and Position the Panel right under the click cursor
    if (panel) {
      panel.style.display = 'flex';
      
      const panelWidth = 320;
      const clickX = clickEvent.clientX;
      const clickY = clickEvent.clientY;
      
      // Horizontal bounds checking
      let left = clickX;
      if (left + panelWidth > window.innerWidth) {
        left = window.innerWidth - panelWidth - 20;
      }
      left = Math.max(20, left);

      // Position below the clicked cursor coordinates
      let top = clickY + 15;
      
      panel.style.left = `${left}px`;
      panel.style.top = `${top}px`;
      panel.style.bottom = 'auto';

      // Vertical bounds checking (wait for DOM rendering to measure height)
      setTimeout(() => {
        const panelHeight = panel.offsetHeight;
        if (top + panelHeight > window.innerHeight) {
          // Position it above the click cursor instead
          top = clickY - panelHeight - 15;
          top = Math.max(20, top);
          panel.style.top = `${top}px`;
        }
      }, 0);
    }
  }

  function getSelector(el: HTMLElement): string {
    if (el.id) return `#${el.id}`;
    
    const path: string[] = [];
    let current: HTMLElement | null = el;
    
    while (current && current.tagName !== 'BODY' && current.tagName !== 'HTML') {
      let segment = current.tagName.toLowerCase();
      
      // Stop building path if we hit the inspector itself
      if (current.classList.contains('typo-inspector-widget')) {
        break;
      }
      
      if (current.id) {
        path.unshift(`#${current.id}`);
        break;
      }
      
      if (current.classList && current.classList.length > 0) {
        const classes = Array.from(current.classList)
          .filter(c => c !== 'typo-inspect-hover' && c !== 'typo-inspect-selected' && !c.startsWith('astro-') && !c.startsWith('data-astro'));
        if (classes.length > 0) {
          segment += '.' + classes.join('.');
        }
      }
      
      path.unshift(segment);
      
      // Stop walking up if we hit a major layout container to keep selectors reasonably clean
      if (current.classList.contains('project-section') || 
          current.classList.contains('hero') || 
          current.classList.contains('universal-layout') ||
          current.classList.contains('layout-sidebar') ||
          current.classList.contains('layout-content')) {
        break;
      }
      
      current = current.parentElement;
    }
    
    return path.join(' > ');
  }

  function clearSelection() {
    if (selectedElement) {
      selectedElement.classList.remove('typo-inspect-selected');
      selectedElement = null;
    }
  }

  function clearHighlight() {
    if (hoveredElement) {
      hoveredElement.classList.remove('typo-inspect-hover');
      hoveredElement = null;
    }
  }

  // Load font stylesheet CDN dynamically
  function loadFontCDN(fontId: string) {
    const fontData = FONTS_MAP[fontId];
    if (fontData && fontData.cdn) {
      const linkId = `font-cdn-${fontId}`;
      if (!document.getElementById(linkId)) {
        const link = document.createElement('link');
        link.id = linkId;
        link.rel = 'stylesheet';
        link.href = fontData.cdn;
        document.head.appendChild(link);
      }
    }
  }

  // Live styling updates
  function updateStyles() {
    if (!selectedElement) return;

    const selector = selectorInput.value.trim() || getSelector(selectedElement);

    // If the selector name changed, remove the old key to prevent accumulation of intermediate typed states
    if (currentEditingSelector && currentEditingSelector !== selector) {
      delete activeOverrides[currentEditingSelector];
      currentEditingSelector = selector;
    }

    const familyKey = fontSelect.value;
    const fontObj = FONTS_MAP[familyKey];
    const familyVal = fontObj?.family || "'Geist', sans-serif";
    const size = sizeSlider.value;
    const weight = weightSlider.value;
    const spacing = spacingSlider.value;
    const lh = lhSlider.value;

    loadFontCDN(familyKey);

    if (valSize) valSize.textContent = `${size}px`;
    if (valWeight) valWeight.textContent = weight;
    if (valSpacing) valSpacing.textContent = `${spacing}em`;
    if (valLh) valLh.textContent = lh;

    activeOverrides[selector] = {
      family: familyVal,
      size: `${size}px`,
      weight: weight,
      spacing: `${spacing}em`,
      lh: lh
    };

    // Save to localStorage
    localStorage.setItem('typo-inspector-overrides', JSON.stringify(activeOverrides));

    renderStyleOverrides();
    updateCSSPreview();
  }

  function renderStyleOverrides() {
    let styleEl = document.getElementById('typo-inspector-dynamic-rules');
    if (!styleEl) {
      styleEl = document.createElement('style');
      styleEl.id = 'typo-inspector-dynamic-rules';
      document.head.appendChild(styleEl);
    }

    let css = '';
    for (const [selector, style] of Object.entries(activeOverrides)) {
      css += `
        ${selector} {
          font-family: ${style.family} !important;
          font-size: ${style.size} !important;
          font-weight: ${style.weight} !important;
          letter-spacing: ${style.spacing} !important;
          line-height: ${style.lh} !important;
        }
      `;
    }
    styleEl.textContent = css;
  }

  function updateCSSPreview() {
    if (!selectedElement) return;

    const selector = selectorInput.value || getSelector(selectedElement);
    const familyKey = fontSelect.value;
    const familyVal = FONTS_MAP[familyKey]?.family || "'Geist', sans-serif";
    const sizePx = parseFloat(sizeSlider.value);
    const sizeRem = (sizePx / 18).toFixed(3);
    const weight = weightSlider.value;
    const spacing = spacingSlider.value;
    const lh = lhSlider.value;

    if (codePreview) {
      codePreview.textContent = 
`${selector} {
  font-family: ${familyVal};
  font-size: ${sizeRem}rem; /* ~${sizePx}px */
  font-weight: ${weight};
  letter-spacing: ${spacing}em;
  line-height: ${lh};
}`;
    }
  }

  // Bind slider events
  const sliders = [sizeSlider, weightSlider, spacingSlider, lhSlider];
  sliders.forEach(slider => {
    if (slider) {
      slider.addEventListener('input', updateStyles);
    }
  });

  if (fontSelect) {
    fontSelect.addEventListener('change', updateStyles);
  }

  if (selectorInput) {
    selectorInput.addEventListener('input', () => {
      updateStyles();
    });
  }

  // Reset Overrides
  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      const styleEl = document.getElementById('typo-inspector-dynamic-rules');
      if (styleEl) {
        styleEl.remove();
      }

      for (const prop of Object.keys(activeOverrides)) {
        delete activeOverrides[prop];
      }
      localStorage.removeItem('typo-inspector-overrides');

      closeInspector();
      
      if (codePreview) {
        codePreview.textContent = '/* Select an element to generate code */';
      }
      if (selectorInput) {
        selectorInput.value = '';
      }
    });
  }

  // Copy Code to Clipboard
  if (copyBtn && codePreview) {
    copyBtn.addEventListener('click', () => {
      const codeText = codePreview.textContent || '';
      if (codeText === '/* Select an element to generate code */') return;

      navigator.clipboard.writeText(codeText).then(() => {
        const originalText = copyBtn.textContent;
        copyBtn.textContent = 'Copied!';
        copyBtn.style.backgroundColor = '#42BD49';
        copyBtn.style.color = '#000000';
        setTimeout(() => {
          copyBtn.textContent = originalText;
          copyBtn.style.backgroundColor = '';
          copyBtn.style.color = '';
        }, 1500);
      });
    });
  }

  // Save Code to local overrides stylesheet via API
  if (saveBtn) {
    saveBtn.addEventListener('click', async () => {
      let css = '';
      for (const [selector, style] of Object.entries(activeOverrides)) {
        css += `${selector} {
  font-family: ${style.family} !important;
  font-size: ${style.size} !important;
  font-weight: ${style.weight} !important;
  letter-spacing: ${style.spacing} !important;
  line-height: ${style.lh} !important;
}\n\n`;
      }

      if (!css.trim()) {
        const originalText = saveBtn.textContent;
        saveBtn.textContent = 'No overrides to save!';
        saveBtn.style.backgroundColor = '#FF5252';
        saveBtn.style.color = '#ffffff';
        setTimeout(() => {
          saveBtn.textContent = originalText;
          saveBtn.style.backgroundColor = '';
          saveBtn.style.color = '';
        }, 2000);
        return;
      }

      try {
        const res = await fetch('/api/save-typography', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ css })
        });
        
        const data = await res.json();
        if (data.success) {
          const originalText = saveBtn.textContent;
          saveBtn.textContent = 'Saved in Code!';
          saveBtn.style.backgroundColor = '#42BD49';
          saveBtn.style.color = '#000000';
          setTimeout(() => {
            saveBtn.textContent = originalText;
            saveBtn.style.backgroundColor = '';
            saveBtn.style.color = '';
          }, 2000);
        } else {
          throw new Error(data.error || 'Server error');
        }
      } catch (err) {
        console.error('Failed to save typography:', err);
        const originalText = saveBtn.textContent;
        saveBtn.textContent = 'Save Failed!';
        saveBtn.style.backgroundColor = '#FF5252';
        saveBtn.style.color = '#ffffff';
        setTimeout(() => {
          saveBtn.textContent = originalText;
          saveBtn.style.backgroundColor = '';
          saveBtn.style.color = '';
        }, 2000);
      }
    });
  }

  function parseCSSOverrides(cssText: string) {
    const overrides: Record<string, any> = {};
    const blockRegex = /([^{]+)\{([^}]+)\}/g;
    let match;
    
    while ((match = blockRegex.exec(cssText)) !== null) {
      const selector = match[1].trim();
      const declarationsText = match[2];
      
      if (selector.startsWith('/*')) continue;
      
      const decls: Record<string, string> = {};
      const declRegex = /([^:\s]+)\s*:\s*([^;!]+?)(?:\s*!important)?\s*;/g;
      let declMatch;
      
      while ((declMatch = declRegex.exec(declarationsText)) !== null) {
        const prop = declMatch[1].trim();
        const val = declMatch[2].trim();
        decls[prop] = val;
      }
      
      if (Object.keys(decls).length > 0) {
        overrides[selector] = {
          family: decls['font-family'] || "'Geist', sans-serif",
          size: decls['font-size'] || "16px",
          weight: decls['font-weight'] || "400",
          spacing: decls['letter-spacing'] || "0em",
          lh: decls['line-height'] || "1.2"
        };
      }
    }
    
    return overrides;
  }

  async function initOverrides() {
    try {
      // Fetch the actual source CSS via dev API endpoint to avoid Vite module conversion
      const response = await fetch('/api/load-typography');
      if (response.ok) {
        const { css } = await response.json();
        const parsed = parseCSSOverrides(css || '');
        Object.assign(activeOverrides, parsed);
      }
    } catch (err) {
      console.warn('Failed to fetch overrides stylesheet via API, falling back to localStorage:', err);
      try {
        const saved = localStorage.getItem('typo-inspector-overrides');
        if (saved) {
          const parsed = JSON.parse(saved);
          Object.assign(activeOverrides, parsed);
        }
      } catch (e) {
        console.error('Error loading localStorage overrides:', e);
      }
    }

    // Load font CDNs and render rules
    for (const override of Object.values(activeOverrides)) {
      for (const [key, font] of Object.entries(FONTS_MAP)) {
        const compareFamily = font.family.replace(/['"]/g, '').split(',')[0];
        const overrideFamily = override.family.replace(/['"]/g, '').split(',')[0];
        if (overrideFamily.toLowerCase().includes(compareFamily.toLowerCase())) {
          loadFontCDN(key);
          break;
        }
      }
    }
    
    renderStyleOverrides();
    localStorage.setItem('typo-inspector-overrides', JSON.stringify(activeOverrides));
  }

  // Run initialization
  initOverrides();
</script>
