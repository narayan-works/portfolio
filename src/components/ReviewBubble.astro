---
interface Props {
    quote: string;
}

const { quote } = Astro.props;
---

<div class="review-bubble">
    <span class="quote-mark open">"</span>
    <p class="review-text">{quote}</p>
    <span class="quote-mark close">"</span>
</div>

<style>
    .review-bubble {
        /* Default: Dark Mode */
        background: #232323;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: var(--radius-md, 12px);
        padding: 2rem 2.5rem;
        position: relative;
        /* Dark mode bevel: Top inner highlight + Deeper drop shadow */
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.05),
            0 4px 12px rgba(0, 0, 0, 0.4),
            0 12px 24px rgba(0, 0, 0, 0.2);
        flex: 1 1 0;
        min-width: 0;
        display: flex;
        align-items: center;
    }

    :global([data-theme="light"]) .review-bubble {
        /* Light Mode Override */
        background: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.08); /* Revert to subtle dark border */
        /* Light Mode bevel */
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.8),
            0 2px 8px rgba(0, 0, 0, 0.06),
            0 8px 16px rgba(0, 0, 0, 0.04);
    }

    .quote-mark {
        position: absolute;
        font-size: 2.5rem;
        font-weight: 700;
        color: #ff9500;
        opacity: 0.3;
        line-height: 1;
        font-family: var(--font-sans);
    }

    .quote-mark.open {
        top: 0.75rem;
        left: 1rem;
    }

    .quote-mark.close {
        bottom: 0.5rem;
        right: 1rem;
    }

    .review-text {
        margin: 0;
        font-size: 0.9rem;
        line-height: 1.6;
        color: var(--text-primary);
        font-style: italic;
        text-align: center;
        width: 100%;
        font-family: var(--font-sans);
    }
</style>
