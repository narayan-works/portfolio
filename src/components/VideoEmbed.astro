---
interface Props {
    id: string;
    type: "vimeo" | "youtube";
    title?: string;
    description?: string;
    constrain?: boolean;
    class?: string;
}

const {
    id,
    type,
    title = "Video",
    description,
    constrain = true,
    class: className,
} = Astro.props;

let embedUrl = "";
let videoWidth = 16;
let videoHeight = 9;

if (type === "vimeo") {
    const match = id.match(/\d+/);
    const videoId = match ? match[0] : id;
    embedUrl = `https://player.vimeo.com/video/${videoId}?badge=0&autopause=0&player_id=0&app_id=58479`;

    // Fetch native dimensions from Vimeo oEmbed API at build time
    try {
        const res = await fetch(
            `https://vimeo.com/api/oembed.json?url=https://vimeo.com/${videoId}`,
        );
        if (res.ok) {
            const data = await res.json();
            if (data.width && data.height) {
                videoWidth = data.width;
                videoHeight = data.height;
            }
        }
    } catch (e) {
        // Fall back to 16:9 default
    }
} else if (type === "youtube") {
    embedUrl = `https://www.youtube.com/embed/${id}`;
}
---

<figure class:list={["video-embed", { constrained: constrain }, className]}>
    <div
        class="video-container"
        style={`aspect-ratio: ${videoWidth} / ${videoHeight};`}
    >
        <div class="media-loading-placeholder" aria-hidden="true">
            <div class="spinner-progress-wrap">
                <svg class="spinner-svg" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle class="spinner-track" cx="22" cy="22" r="18" stroke="currentColor" stroke-width="3" opacity="0.18" />
                    <circle class="spinner-bar" cx="22" cy="22" r="18" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                </svg>
                <span class="progress-val">12%</span>
            </div>
            <div class="placeholder-text-group">
                <h4 class="uhoh-heading">uh-oh</h4>
                <p class="apology-line">sorry for the inconvenience,</p>
                <p class="fun-line">this was supposed to load by now...</p>
            </div>
        </div>
        <iframe
            src={embedUrl}
            allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media"
            title={title}
            loading="lazy"
            onload="const c = this.closest('.video-container'); if(c){ c.classList.add('is-loaded'); const v = c.querySelector('.progress-val'); if(v) v.textContent='100%'; }"></iframe>
    </div>
    {description && <figcaption>{description}</figcaption>}
</figure>

<script>
    function setupVideoProgressSimulators() {
        document.querySelectorAll(".video-container:not(.is-loaded):not([data-progress-init])").forEach((container) => {
            container.setAttribute("data-progress-init", "true");
            const bar = container.querySelector(".spinner-bar") as SVGCircleElement | null;
            const val = container.querySelector(".progress-val") as HTMLElement | null;

            if (!bar || !val) return;

            let progress = Math.floor(Math.random() * 8) + 12;
            const circumference = 2 * Math.PI * 18;
            val.textContent = `${progress}%`;
            bar.style.strokeDasharray = `${circumference}`;
            bar.style.strokeDashoffset = `${circumference * (1 - progress / 100)}`;

            const interval = setInterval(() => {
                if (container.classList.contains("is-loaded")) {
                    val.textContent = "100%";
                    bar.style.strokeDashoffset = "0";
                    clearInterval(interval);
                    return;
                }
                if (progress < 94) {
                    progress += Math.floor(Math.random() * 8) + 3;
                    if (progress > 94) progress = 94;
                    val.textContent = `${progress}%`;
                    bar.style.strokeDashoffset = `${circumference * (1 - progress / 100)}`;
                }
            }, 180);
        });
    }

    setupVideoProgressSimulators();
    document.addEventListener("astro:page-load", setupVideoProgressSimulators);
</script>

<style>
    .video-embed {
        width: 100%;
        margin-top: 4rem;
        margin-bottom: 2rem;
        box-sizing: border-box;
    }

    .video-embed.constrained {
        padding-inline: 0;
    }

    .video-container {
        width: 100%;
        position: relative;
        overflow: hidden;
        border-radius: var(--radius-md);
        background: var(--surface-secondary, rgba(255, 255, 255, 0.03));
        border: 1px dashed var(--border-subtle, rgba(255, 255, 255, 0.15));
        transition: border-color 0.3s ease;
    }

    .video-container.is-loaded {
        border-color: transparent;
    }

    :global(html[data-theme="light"]) .video-container {
        background: rgba(0, 0, 0, 0.02);
        border-color: rgba(0, 0, 0, 0.12);
    }

    :global(html[data-theme="light"]) .video-container.is-loaded {
        border-color: transparent;
    }

    .media-loading-placeholder {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: flex-start;
        padding: 20px;
        box-sizing: border-box;
        text-align: left;
        z-index: 1;
        opacity: 1;
        transition: opacity 0.35s ease;
        pointer-events: none;
    }

    .video-container.is-loaded .media-loading-placeholder {
        opacity: 0;
    }

    .spinner-progress-wrap {
        position: relative;
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #22c55e;
    }

    .spinner-svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        transform: rotate(-90deg);
    }

    .spinner-track {
        color: #22c55e;
        opacity: 0.18;
    }

    .spinner-bar {
        color: #22c55e;
        transition: stroke-dashoffset 0.25s ease;
    }

    .progress-val {
        font-family: var(--font-sans, "Google Sans", sans-serif);
        font-size: 13px;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--text-primary);
    }

    .placeholder-text-group {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        gap: 2px;
    }

    .uhoh-heading {
        font-family: var(--font-sans, "Google Sans", sans-serif);
        font-size: 18px;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--text-primary);
        margin: 0 0 4px 0;
        line-height: 1.1;
    }

    .apology-line,
    .fun-line {
        font-family: var(--font-sans, "Google Sans", sans-serif);
        font-size: 13px;
        font-weight: 400;
        color: var(--text-secondary, rgba(255, 255, 255, 0.7));
        margin: 0;
        line-height: 1.35;
        letter-spacing: -0.01em;
    }

    :global(html[data-theme="light"]) .apology-line,
    :global(html[data-theme="light"]) .fun-line {
        color: rgba(0, 0, 0, 0.65);
    }

    .video-container iframe {
        display: block;
        width: 100%;
        height: 100%;
        position: relative;
        z-index: 2;
        border: none;
    }

    figcaption {
        text-align: center;
        font-size: 12px;
        color: var(--text-tertiary);
        margin-top: 0.75rem;
    }
</style>
