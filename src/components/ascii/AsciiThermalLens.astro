---
interface Props {
  color?: string;
  id?: string;
}

const { color = '#42BD49', id = 'ascii-thermal-lens' } = Astro.props;
---

<div class="ascii-canvas-container" id={`${id}-container`}>
  <canvas class="ascii-canvas" id={id}></canvas>
</div>

<script>
  function initThermalLens() {
    const containers = document.querySelectorAll('.ascii-canvas-container');
    containers.forEach((container) => {
      const canvas = container.querySelector('canvas') as HTMLCanvasElement;
      if (!canvas || canvas.dataset.lensInitialized) return;
      if (canvas.id.indexOf('lens') === -1 && canvas.id.indexOf('thermal') === -1 && canvas.id.indexOf('option-5') === -1) return;
      canvas.dataset.lensInitialized = 'true';

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      let animationFrameId: number;
      let width = 0;
      let height = 0;

      const fontSize = 13;
      let cols = 0;
      let rows = 0;

      let mouseX = -1000;
      let mouseY = -1000;
      let targetMouseX = -1000;
      let targetMouseY = -1000;
      let lensRadius = 160;

      const lowChars = ['.', '·', ',', ':', '`', '\'', ' '];
      const denseChars = ['░', '▒', '▓', '█', '@', '#', '$', '%', '&', 'W', 'M'];

      function resize() {
        const rect = container.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = rect.width;
        height = rect.height;
        canvas.width = width * dpr;
        canvas.height = height * dpr;
        ctx?.scale(dpr, dpr);

        cols = Math.floor(width / (fontSize * 0.75));
        rows = Math.floor(height / (fontSize * 1.1));
      }

      window.addEventListener('resize', resize);
      resize();

      container.addEventListener('mousemove', (e) => {
        const rect = container.getBoundingClientRect();
        targetMouseX = (e as MouseEvent).clientX - rect.left;
        targetMouseY = (e as MouseEvent).clientY - rect.top;
      });

      container.addEventListener('mouseleave', () => {
        targetMouseX = -1000;
        targetMouseY = -1000;
      });

      function draw() {
        // Smooth lerp lens position
        mouseX += (targetMouseX - mouseX) * 0.15;
        mouseY += (targetMouseY - mouseY) * 0.15;

        const currentColor = container.getAttribute('data-color') || '#42BD49';
        const bgFill = container.getAttribute('data-bg') || '#0a0a0a';

        ctx!.fillStyle = bgFill;
        ctx!.fillRect(0, 0, width, height);

        ctx!.font = '600 13px "Geist Mono", monospace';
        ctx!.textAlign = 'center';
        ctx!.textBaseline = 'middle';

        const cellW = fontSize * 0.75;
        const cellH = fontSize * 1.1;

        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const x = c * cellW + cellW / 2;
            const y = r * cellH + cellH / 2;

            const dx = x - mouseX;
            const dy = y - mouseY;
            const dist = Math.sqrt(dx * dx + dy * dy);

            let charToDraw = lowChars[(r * 13 + c * 7) % lowChars.length];
            let opacity = 0.2;
            let fillStyle = currentColor;

            // Thermal / Sonar Lens reveal
            if (dist < lensRadius) {
              const factor = 1 - dist / lensRadius;
              const denseIdx = Math.floor(factor * denseChars.length);
              charToDraw = denseChars[Math.min(denseChars.length - 1, denseIdx)];
              opacity = 0.35 + factor * 0.65;

              if (factor > 0.75) {
                fillStyle = '#FFFFFF';
              } else if (factor > 0.4) {
                fillStyle = currentColor;
              } else {
                fillStyle = currentColor;
              }
            }

            ctx!.fillStyle = fillStyle;
            ctx!.globalAlpha = opacity;
            ctx!.fillText(charToDraw, x, y);
          }
        }

        ctx!.globalAlpha = 1;
        animationFrameId = requestAnimationFrame(draw);
      }

      draw();
    });
  }

  document.addEventListener('DOMContentLoaded', initThermalLens);
  document.addEventListener('astro:page-load', initThermalLens);
</script>

<style>
  .ascii-canvas-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: auto;
    z-index: 0;
  }

  .ascii-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
