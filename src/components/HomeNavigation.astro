---
const isHomePage = Astro.url.pathname === "/";
const isAboutPage = Astro.url.pathname.startsWith("/about");
const isArchivePage = Astro.url.pathname.startsWith("/archive");
const isWorksPage = Astro.url.pathname.startsWith("/works");
---

<nav class="home-navigation">
    <div class="home-nav-container">
        <!-- Left: Logo & Name -->
        <a
            href="/"
            class={`home-nav-logo ${isHomePage || isWorksPage ? "home-nav-logo--hidden" : ""}`}
        >
            <div class="logo-img-wrapper">
                <span class="logo-circle">
                    <img
                        id="nav-logo-happy"
                        src="/logos/happy 1.png"
                        alt="na"
                        class="logo-img"
                        loading="eager"
                        decoding="async"
                        width="36"
                        height="36"
                    />
                </span>
            </div>
            <span class="logo-name"></span>
        </a>

        <!-- Right: Links -->
        <div class="home-nav-links">
            <a
                href={isHomePage ? "#" : "/"}
                id="nav-home-link"
                class="home-nav-link"
                data-section="home"
            >
                Home
            </a>
            <a
                href="/about"
                id="nav-about-link"
                class={`home-nav-link ${isAboutPage ? "active-scroll" : ""}`}
                data-section="about"
            >
                About
            </a>
            <a
                href={isHomePage ? "#works" : "/#works"}
                id="nav-works-link"
                class="home-nav-link"
                data-section="works"
            >
                Work
            </a>
            <a
                href="/archive"
                target="_blank"
                id="nav-archive-link"
                class={`home-nav-link ${isArchivePage ? "active-scroll" : ""}`}
            >
                Archive
            </a>
        </div>
    </div>
</nav>

<script>
    function setupScrollSpy() {
        // Home/Works highlighting is homepage-only scroll spying. About and
        // Archive are static per-page links, highlighted server-side
        // based on the current route (see isAboutPage/isArchivePage).
        const homeLink = document.getElementById("nav-home-link");
        const worksLink = document.getElementById("nav-works-link");
        const worksSection = document.getElementById("works");

        if (!worksSection) {
            homeLink?.classList.remove("active-scroll");
            worksLink?.classList.remove("active-scroll");
            return;
        }

        function updateHomeActiveState() {
            homeLink?.classList.remove("active-scroll");
            worksLink?.classList.remove("active-scroll");

            const worksTop = worksSection.offsetTop - 120;

            if (window.scrollY < worksTop) {
                homeLink?.classList.add("active-scroll");
            } else {
                worksLink?.classList.add("active-scroll");
            }
        }

        window.addEventListener("scroll", () => {
            window.requestAnimationFrame(updateHomeActiveState);
        });

        // Initial call
        updateHomeActiveState();
    }

    function setupLogoAnimation() {
        const img = document.getElementById(
            "nav-logo-happy",
        ) as HTMLImageElement | null;
        if (!img) return;

        const frames = [
            "/logos/happy 1.png",
            "/logos/happy 2.png",
            "/logos/happy 3.png",
        ];
        let frameIndex = 0;

        // Clear any interval left over from a previous page (the interval
        // itself persists across soft navigations since it's on `window`)
        const w = window as any;
        if (w._navLogoInterval) {
            clearInterval(w._navLogoInterval);
        }

        // Matches the idle walk-cycle speed used for the ghost in GhostRunner
        w._navLogoInterval = window.setInterval(() => {
            frameIndex = (frameIndex + 1) % frames.length;
            img.src = frames[frameIndex];
        }, 420);
    }

    // Run setup on load and on page transition (Astro View Transitions compatibility)
    setupScrollSpy();
    setupLogoAnimation();
    document.addEventListener("astro:page-load", setupScrollSpy);
    document.addEventListener("astro:page-load", setupLogoAnimation);
</script>

<style>
    .home-navigation {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 200;
        padding: 0 16px; /* No vertical padding, 16px horizontal */
        height: 52.5px; /* 1.5 times the 35px filter bar height */
        box-sizing: border-box;
        background: transparent;
        display: flex;
        align-items: center;
    }

    .home-nav-container {
        position: relative;
        isolation: isolate;
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        height: 100%;
    }

    .home-nav-container::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            rgba(255, 255, 255, 0.24) 0%,
            rgba(255, 255, 255, 0.2) 10%,
            rgba(255, 255, 255, 0.14) 24%,
            rgba(255, 255, 255, 0.08) 40%,
            rgba(255, 255, 255, 0.035) 58%,
            rgba(255, 255, 255, 0.012) 74%,
            rgba(255, 255, 255, 0) 100%
        );
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        -webkit-mask-image: linear-gradient(
            to bottom,
            black 0%,
            black 18%,
            rgba(0, 0, 0, 0.92) 34%,
            rgba(0, 0, 0, 0.6) 52%,
            rgba(0, 0, 0, 0.22) 70%,
            transparent 100%
        );
        mask-image: linear-gradient(
            to bottom,
            black 0%,
            black 18%,
            rgba(0, 0, 0, 0.92) 34%,
            rgba(0, 0, 0, 0.6) 52%,
            rgba(0, 0, 0, 0.22) 70%,
            transparent 100%
        );
        z-index: -1;
    }

    :global(html:not([data-theme="light"])) .home-nav-container::before {
        background: linear-gradient(
            to bottom,
            rgba(0, 0, 0, 0.6) 0%,
            rgba(0, 0, 0, 0.5) 10%,
            rgba(0, 0, 0, 0.35) 24%,
            rgba(0, 0, 0, 0.2) 40%,
            rgba(0, 0, 0, 0.09) 58%,
            rgba(0, 0, 0, 0.03) 74%,
            rgba(0, 0, 0, 0) 100%
        );
    }

    .home-nav-logo {
        display: flex;
        align-items: center;
        gap: 16px;
        text-decoration: none;
        color: var(--text-secondary);
        transition: color 0.2s ease;
        cursor: pointer;
        user-select: none;
        height: 100%;
    }

    .home-nav-logo:hover {
        color: var(--accent-secondary);
    }

    /* Hidden on Home (floating bio ghost takes over) and on Works/project
       pages. Still shown on About and Archive. */
    .home-nav-logo--hidden {
        visibility: hidden;
    }

    .home-nav-logo:hover .logo-name {
        font-weight: 600;
    }

    .logo-img-wrapper {
        width: 52.5px; /* Perfect square matching container height */
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-left: -16px; /* Pull to the absolute left edge of the navigation bar */
    }

    /* .logo-circle {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0px;
        border-radius: 50%;
        background-color: var(--accent-secondary);
    } */

    .logo-img {
        display: block;
        width: 42px;
        height: 42px;
        object-fit: contain;
    }

    .logo-name {
        font-family: var(--font-sans);
        font-size: 14px;
        font-weight: 450;
        text-transform: none;
        letter-spacing: 0.01rem;
        line-height: 1;
        cursor: pointer;
        transition:
            font-weight 0.2s ease,
            color 0.2s ease;
    }

    .home-nav-links {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .home-nav-link {
        font-family: var(--font-sans);
        font-size: 14px;
        font-weight: 450;
        text-transform: none;
        letter-spacing: 0;
        line-height: 1;
        color: var(--text-secondary);
        text-decoration: none;
        transition:
            font-weight 0.2s ease,
            color 0.2s ease;
    }

    .home-nav-link:hover {
        color: var(--accent-secondary);
        font-weight: 600;
        text-decoration: underline;
        text-decoration-color: var(--accent-secondary);
        text-decoration-thickness: 2px;
        text-underline-offset: 4px;
    }

    .home-nav-link.active-scroll {
        color: var(--accent-secondary);
        font-weight: 600;
        text-decoration: underline;
        text-decoration-color: var(--accent-secondary);
        text-decoration-thickness: 2px;
        text-underline-offset: 4px;
    }

    /* Responsive overrides */
    @media (max-width: 768px) {
        .home-nav-container {
            justify-content: space-between;
        }

        .logo-name {
            display: none;
        }

        .logo-img-wrapper {
            margin-left: -16px;
        }

        /* Center links absolutely within the bar */
        .home-nav-links {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            gap: 20px;
        }
    }
</style>
