---
const isHomePage = Astro.url.pathname === "/";
const isAboutPage = Astro.url.pathname.startsWith("/about");
const isArchivePage = Astro.url.pathname.startsWith("/archive");
const isWorksPage = Astro.url.pathname.startsWith("/works");
---

<nav class={`home-navigation ${isWorksPage ? "is-works-page" : ""}`}>
    <div class="home-nav-container">
        <!-- Left: Logo & Name -->
        <a
            href="/"
            class={`home-nav-logo ${isHomePage ? "home-nav-logo--hidden" : ""}`}
        >
            <div class="logo-img-wrapper">
                <span class="logo-circle">
                    <img
                        id="nav-logo-happy"
                        src="/logos/happy 1.png"
                        alt="na"
                        class="logo-img"
                        loading="eager"
                        decoding="async"
                        width="36"
                        height="36"
                    />
                </span>
            </div>
            <span class="logo-name"></span>
        </a>

        <!-- Right: Links -->
        <div class="home-nav-links">
            <a
                href={isHomePage ? "#" : "/"}
                id="nav-home-link"
                class="home-nav-link"
                data-section="home"
            >
                Home
            </a>
            <a
                href={isHomePage ? "#works" : "/#works"}
                id="nav-works-link"
                class={`home-nav-link ${isWorksPage ? "active-scroll" : ""}`}
                data-section="works"
            >
                Work
            </a>
            <a
                href="/about"
                id="nav-about-link"
                class={`home-nav-link ${isAboutPage ? "active-scroll" : ""}`}
                data-section="about"
            >
                About
            </a>
            <a
                href="/archive"
                target="_blank"
                id="nav-archive-link"
                class={`home-nav-link ${isArchivePage ? "active-scroll" : ""}`}
            >
                Archive
            </a>
        </div>
    </div>
</nav>

<script>
    function setupScrollSpy() {
        // Home/Works highlighting is homepage-only scroll spying. About and
        // Archive are static per-page links, highlighted server-side
        // based on the current route (see isAboutPage/isArchivePage).
        const homeLink = document.getElementById("nav-home-link");
        const worksLink = document.getElementById("nav-works-link");
        const worksSection = document.getElementById("works");

        if (!worksSection) {
            homeLink?.classList.remove("active-scroll");
            worksLink?.classList.remove("active-scroll");
            return;
        }

        function updateHomeActiveState() {
            homeLink?.classList.remove("active-scroll");
            worksLink?.classList.remove("active-scroll");

            const worksTop = worksSection.offsetTop - 120;

            if (window.scrollY < worksTop) {
                homeLink?.classList.add("active-scroll");
            } else {
                worksLink?.classList.add("active-scroll");
            }
        }

        window.addEventListener("scroll", () => {
            window.requestAnimationFrame(updateHomeActiveState);
        });

        // Initial call
        updateHomeActiveState();
    }

    function setupLogoAnimation() {
        const img = document.getElementById(
            "nav-logo-happy",
        ) as HTMLImageElement | null;
        if (!img) return;

        const frames = [
            "/logos/happy 1.png",
            "/logos/happy 2.png",
            "/logos/happy 3.png",
        ];
        let frameIndex = 0;

        // Clear any interval left over from a previous page (the interval
        // itself persists across soft navigations since it's on `window`)
        const w = window as any;
        if (w._navLogoInterval) {
            clearInterval(w._navLogoInterval);
        }

        // Matches the idle walk-cycle speed used for the ghost in GhostRunner
        w._navLogoInterval = window.setInterval(() => {
            frameIndex = (frameIndex + 1) % frames.length;
            img.src = frames[frameIndex];
        }, 420);
    }

    // Run setup on load and on page transition (Astro View Transitions compatibility)
    setupScrollSpy();
    setupLogoAnimation();
    document.addEventListener("astro:page-load", setupScrollSpy);
    document.addEventListener("astro:page-load", setupLogoAnimation);
</script>

<style>
    .home-navigation {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 20000;
        padding: 0 16px; /* No vertical padding, 16px horizontal */
        height: 52.5px; /* 1.5 times the 35px filter bar height */
        box-sizing: border-box;
        background: transparent;
        display: flex;
        align-items: center;
        view-transition-name: header-nav;
        transition: padding 0.48s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .home-nav-container {
        position: relative;
        isolation: isolate;
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        height: 100%;
    }

    .home-nav-container::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            rgba(255, 255, 255, 0.24) 0%,
            rgba(255, 255, 255, 0.24) 60%,
            rgba(255, 255, 255, 0.16) 74%,
            rgba(255, 255, 255, 0.06) 88%,
            rgba(255, 255, 255, 0) 100%
        );
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        -webkit-mask-image: linear-gradient(
            to bottom,
            black 0%,
            black 60%,
            rgba(0, 0, 0, 0.85) 72%,
            rgba(0, 0, 0, 0.45) 84%,
            rgba(0, 0, 0, 0.15) 94%,
            transparent 100%
        );
        mask-image: linear-gradient(
            to bottom,
            black 0%,
            black 60%,
            rgba(0, 0, 0, 0.85) 72%,
            rgba(0, 0, 0, 0.45) 84%,
            rgba(0, 0, 0, 0.15) 94%,
            transparent 100%
        );
        z-index: -1;
    }

    :global(html:not([data-theme="light"])) .home-nav-container::before {
        background: linear-gradient(
            to bottom,
            rgba(0, 0, 0, 0.6) 0%,
            rgba(0, 0, 0, 0.6) 60%,
            rgba(0, 0, 0, 0.4) 74%,
            rgba(0, 0, 0, 0.15) 88%,
            rgba(0, 0, 0, 0) 100%
        );
    }

    .home-nav-logo {
        display: flex;
        align-items: center;
        gap: 16px;
        text-decoration: none;
        color: var(--text-secondary);
        transition: color 0.2s ease;
        cursor: pointer;
        user-select: none;
        height: 100%;
        view-transition-name: header-nav-logo;
    }

    .home-nav-logo:hover {
        color: var(--accent-secondary);
    }

    /* Hidden on Home (floating bio ghost takes over) and on Works/project
       pages. Still shown on About and Archive. */
    .home-nav-logo--hidden {
        visibility: hidden;
    }

    .home-nav-logo:hover .logo-name {
        color: var(--accent-secondary);
    }

    .logo-img-wrapper {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-left: -15.75px;
    }

    .logo-img {
        display: block;
        width: 36px;
        height: 36px;
        object-fit: contain;
    }

    .logo-name {
        font-family: var(--font-sans);
        font-size: 14px;
        font-weight: 450;
        text-transform: none;
        letter-spacing: 0.01rem;
        line-height: 1;
        cursor: pointer;
        transition:
            text-shadow 0.2s ease,
            color 0.2s ease;
    }

    .home-nav-links {
        display: flex;
        align-items: center;
        gap: 16px;
        view-transition-name: header-nav-links;
        transition:
            width 0.48s cubic-bezier(0.25, 1, 0.5, 1),
            gap 0.48s cubic-bezier(0.25, 1, 0.5, 1);
    }

    /* Precision alignment for Case Study / Works Pages: 280px width (320px sidebar - 40px padding) */
    .home-navigation.is-works-page {
        padding: 0 20px;
    }

    @media (min-width: 1025px) {
        .home-navigation.is-works-page .home-nav-links {
            width: calc(320px - 40px);
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 0;
            align-items: center;
        }

        .home-navigation.is-works-page .home-nav-link:nth-child(1) {
            text-align: left;
        }

        .home-navigation.is-works-page .home-nav-link:nth-child(2),
        .home-navigation.is-works-page .home-nav-link:nth-child(3) {
            text-align: center;
        }

        .home-navigation.is-works-page .home-nav-link:nth-child(4) {
            text-align: right;
        }
    }

    .home-nav-link {
        font-family: var(--font-sans);
        font-size: 14px;
        font-weight: 450;
        text-transform: none;
        letter-spacing: 0;
        line-height: 1;
        color: var(--text-secondary);
        text-decoration: none;
        cursor: pointer;
        transition:
            text-shadow 0.2s ease,
            color 0.2s ease;
    }

    .home-nav-link:hover {
        color: var(--accent-secondary);
        text-decoration: underline;
        text-decoration-color: var(--accent-secondary);
        text-decoration-thickness: 2px;
        text-underline-offset: 4px;
    }

    .home-nav-link.active-scroll {
        color: var(--accent-secondary);
        text-decoration: underline;
        text-decoration-color: var(--accent-secondary);
        text-decoration-thickness: 2px;
        text-underline-offset: 4px;
    }

    /* Responsive overrides: Mobile & Tablet */
    @media (max-width: 1024px) {
        .home-navigation {
            width: 100% !important;
            left: 0 !important;
            right: 0 !important;
            padding: 0 20px !important;
            height: 52.5px !important;
            background: rgba(235, 235, 230, 0.82) !important;
            backdrop-filter: blur(16px) saturate(180%) !important;
            -webkit-backdrop-filter: blur(16px) saturate(180%) !important;
            border-bottom: 1px solid var(--border-subtle, rgba(0, 0, 0, 0.1)) !important;
        }

        :global(html:not([data-theme="light"])) .home-navigation {
            background: rgba(18, 18, 18, 0.82) !important;
            border-bottom: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.1)) !important;
        }

        .home-nav-container::before {
            display: none !important;
        }

        .home-nav-container {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            width: 100%;
        }

        .logo-name {
            display: none;
        }

        /* Mobile Home Page: Center-aligned navigation links */
        .home-navigation:not(.is-works-page) .home-nav-links {
            position: absolute !important;
            left: 50% !important;
            transform: translateX(-50%) !important;
            gap: 20px;
            display: flex;
            align-items: center;
            width: auto;
        }

        .home-navigation:not(.is-works-page) .home-nav-logo {
            order: 1;
            margin-left: -16px;
        }

        /* Mobile Case Study / Works Page: Left-aligned links (matching text margin) + Ghost on the RIGHT */
        .home-navigation.is-works-page .home-nav-links {
            position: static !important;
            transform: none !important;
            left: auto !important;
            order: 1;
            display: flex;
            gap: 18px;
            align-items: center;
            margin-left: 0 !important;
            margin-right: auto !important;
            padding-left: 0 !important;
            width: auto !important;
        }

        .home-navigation.is-works-page .home-nav-logo {
            order: 2;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            margin-left: auto !important;
            margin-right: 0 !important;
        }

        .logo-img-wrapper {
            margin-left: 0 !important;
            margin-right: 0 !important;
            width: 36px;
            height: 36px;
        }
    }

    @media (max-width: 480px) {
        .home-navigation:not(.is-works-page) .home-nav-links {
            gap: 16px;
        }

        .home-navigation.is-works-page .home-nav-links {
            gap: 14px;
        }

        .home-nav-link {
            font-size: 13px;
        }
    }
</style>
