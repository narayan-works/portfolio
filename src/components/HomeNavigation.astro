---
import { Image } from "astro:assets";
import happyLogo from "../assets/happy.png";
---

<nav class="home-navigation">
    <div class="home-nav-container">
        <!-- Left: Logo & Name -->
        <a href="/" class="home-nav-logo">
            <div class="logo-img-wrapper">
                <Image
                    src={happyLogo}
                    alt="na"
                    class="logo-img"
                    loading="eager"
                    decoding="async"
                    width={96}
                    height={96}
                />
            </div>
            <span class="logo-name">Narayan Ashanahalli</span>
        </a>

        <!-- Right: Links -->
        <div class="home-nav-links">
            <a
                href="#"
                id="nav-home-link"
                class="home-nav-link"
                data-section="home"
            >
                Home
            </a>
            <a
                href="#about"
                id="nav-about-link"
                class="home-nav-link"
                data-section="about"
            >
                About
            </a>
            <a
                href="#works"
                id="nav-works-link"
                class="home-nav-link"
                data-section="works"
            >
                Work
            </a>
            <a
                href="/elsewhere"
                target="_blank"
                class="home-nav-link"
            >
                Elsewhere
            </a>
        </div>
    </div>
</nav>

<script>
    function setupScrollSpy() {
        const homeLink = document.getElementById("nav-home-link");
        const aboutLink = document.getElementById("nav-about-link");
        const worksLink = document.getElementById("nav-works-link");
        const readMoreBtn = document.getElementById("read-more-btn");

        let isReadMoreExpanded = false;

        if (readMoreBtn) {
            const mutationObserver = new MutationObserver(() => {
                isReadMoreExpanded = readMoreBtn.classList.contains("active");
                updateHomeActiveState();
            });
            mutationObserver.observe(readMoreBtn, {
                attributes: true,
                attributeFilter: ["class"],
            });
        }

        function updateHomeActiveState() {
            // Reset all highlights
            homeLink?.classList.remove("active-scroll");
            aboutLink?.classList.remove("active-scroll");
            worksLink?.classList.remove("active-scroll");

            // 1. Read More expanded -> ABOUT
            if (isReadMoreExpanded) {
                aboutLink?.classList.add("active-scroll");
                return;
            }

            // 2. Home Zone (top of page, before works)
            const worksSection = document.getElementById("works");
            const worksTop = worksSection
                ? worksSection.offsetTop - 120
                : 99999;

            if (window.scrollY < worksTop) {
                homeLink?.classList.add("active-scroll");
                return;
            }

            // 3. Works Zone
            worksLink?.classList.add("active-scroll");
        }

        window.addEventListener("scroll", () => {
            window.requestAnimationFrame(updateHomeActiveState);
        });

        // Initial call
        updateHomeActiveState();
    }

    // Run setup on load and on page transition (Astro View Transitions compatibility)
    setupScrollSpy();
    document.addEventListener("astro:page-load", setupScrollSpy);
</script>

<style>
    .home-navigation {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 200;
        padding: 0 16px; /* No vertical padding, 16px horizontal */
        height: 52.5px; /* 1.5 times the 35px filter bar height */
        box-sizing: border-box;
        background: var(--bg-glass);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border-subtle);
        display: flex;
        align-items: center;
    }

    .home-nav-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        height: 100%;
    }

    .home-nav-logo {
        display: flex;
        align-items: center;
        gap: 16px;
        text-decoration: none;
        color: var(--text-secondary);
        transition: color 0.2s ease;
        cursor: pointer;
        user-select: none;
        height: 100%;
    }

    .home-nav-logo:hover {
        color: var(--accent-secondary);
    }

    .home-nav-logo:hover .logo-name {
        font-weight: 600;
    }

    .logo-img-wrapper {
        width: 52.5px; /* Perfect square matching container height */
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--accent-secondary); /* Green background */
        margin-left: -16px; /* Pull to the absolute left edge of the navigation bar */
    }

    .logo-img {
        display: block;
        width: 36px;
        height: 36px;
        object-fit: contain;
    }

    .logo-name {
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 450;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        line-height: 1;
        cursor: pointer;
        transition: font-weight 0.2s ease, color 0.2s ease;
    }

    .home-nav-links {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .home-nav-link {
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 450;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        line-height: 1;
        color: var(--text-secondary);
        text-decoration: none;
        transition: font-weight 0.2s ease, color 0.2s ease;
    }

    .home-nav-link:hover {
        color: var(--accent-secondary);
        font-weight: 600;
    }

    .home-nav-link.active-scroll {
        color: var(--text-primary);
        font-weight: 600;
    }

    /* Responsive overrides */
    @media (max-width: 768px) {
        .home-nav-container {
            justify-content: space-between;
        }

        .logo-name {
            display: none;
        }

        .logo-img-wrapper {
            margin-left: -16px;
        }

        /* Center links absolutely within the bar */
        .home-nav-links {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            gap: 20px;
        }
    }
</style>
