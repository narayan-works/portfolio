---

---

<div id="custom-cursor" class="cursor-wrapper">
    <!-- Figma Cursor SVG (Arrow) -->
    <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="cursor-icon arrow-icon"
    >
        <path
            d="M5.65376 12.3673H5.46026L5.31717 12.4976L0.500002 16.8829L0.500002 1.19841L11.7841 12.3673H5.65376Z"
            fill="var(--accent-primary)"
            stroke="white"
            stroke-width="2"
            stroke-linejoin="round"
            stroke-linecap="round"></path>
    </svg>

    <!-- Label -->
    <div class="cursor-label">You</div>
</div>

<style>
    .cursor-wrapper {
        display: none !important; /* Custom cursor disabled by user request — default OS cursors active */
        position: fixed;
        top: 0;
        left: 0;
        z-index: 99999;
        pointer-events: none;
        will-change: transform;
        opacity: 0;
        transition: opacity 0.2s ease;
        margin-top: -3px;
        margin-left: -3px;
        filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.25));
    }

    .cursor-icon {
        position: relative;
        z-index: 2;
        transform-origin: 2px 2px;
        transform: rotate(-15deg); /* Match arrow rotation */
    }

    .cursor-label {
        position: absolute;
        /* Tighter spacing implementation */
        top: 18px;
        left: 14px;
        background: var(--accent-primary);
        color: white;
        padding: 4px 8px;
        border-radius: 6px;
        border-top-left-radius: 0;
        font-size: 13px;
        font-weight: 500;
        white-space: nowrap;
        line-height: 1;
        transition: transform 0.2s ease;
    }

    /* Mobile Override */
    @media (max-width: 768px) {
        .cursor-wrapper {
            display: none !important;
        }
    }

    /* Click Animation (Scale Children) */
    .cursor-wrapper.clicking .cursor-icon,
    .cursor-wrapper.clicking .cursor-label {
        transform: scale(0.9);
    }
    /* We need to preserve the rotation on the arrow when scaling */
    .cursor-wrapper.clicking .arrow-icon {
        transform: rotate(-15deg) scale(0.9);
    }

    /* Over links/buttons/text, the native cursor shows instead of our arrow —
       but the "You" label stays, in green, at the exact same position/offset
       as the default blue label (no top/left override here on purpose). */
    .cursor-wrapper.native-cursor .arrow-icon {
        display: none;
    }

    .cursor-wrapper.native-cursor .cursor-label {
        background: var(--accent-secondary);
    }
</style>

<script>
    // Custom cursor disabled by user request — default OS cursors active
    const CUSTOM_CURSOR_ENABLED = false;
    if (CUSTOM_CURSOR_ENABLED) {
    let cursor = document.getElementById("custom-cursor");
    let cursorWrapper = document.querySelector(".cursor-wrapper");
    const isCoarsePointer =
        window.matchMedia("(hover: none), (pointer: coarse)").matches;

    if (!isCoarsePointer) {
        // Re-query the dynamic body elements on Astro page load/transition
        document.addEventListener("astro:page-load", () => {
            cursor = document.getElementById("custom-cursor");
            cursorWrapper = document.querySelector(".cursor-wrapper");
        });

        let isVisible = false;
        let isFullyHidden = false; // game/pdf areas — opacity 0, no label either

        // Elements where the native cursor (pointer/I-beam) shows instead of our
        // arrow icon. The "You" label stays visible over these (in green via
        // .native-cursor), just without the arrow competing with the native cursor.
        const nativeCursorSelectors =
            'a, button, [role="button"], input, select, textarea, .folder-trigger, .bio-ghost-walker, p, h1, h2, h3, h4, h5, h6, li, blockquote, dt, dd, figcaption';
        // Game Container Selector
        const gameSelector = ".ghost-game-container";

        const updateCursorState = (e: MouseEvent) => {
            if (!cursor || !cursorWrapper) return;
            const target = e.target as HTMLElement;

            // Inside Typography Inspector Widget: always show the default cursor
            if (target.closest(".typo-inspector-widget")) {
                cursorWrapper.classList.remove("native-cursor");
                isFullyHidden = false;
                if (isVisible) cursor.style.opacity = "1";
                return;
            }

            const media = target.closest("img, svg");
            const native = media ? null : target.closest(nativeCursorSelectors);
            const game = target.closest(gameSelector);
            const pdf = target.closest(".pdf-viewer-wrapper");

            // Game or PDF: always fully hide (they manage their own cursor)
            if (game || pdf) {
                isFullyHidden = true;
                cursor.style.opacity = "0";
                cursorWrapper.classList.remove("native-cursor");
                return;
            }

            isFullyHidden = false;
            cursorWrapper.classList.toggle("native-cursor", !!native);
            if (isVisible) cursor.style.opacity = "1";
        };

        document.addEventListener("mousemove", (e: MouseEvent) => {
            if (!cursor) return;

            // If we haven't set visibility yet
            if (!isVisible && !isFullyHidden) {
                cursor.style.opacity = "1";
                isVisible = true;
            }

            if (isFullyHidden) {
                cursor.style.opacity = "0";
            }

            cursor.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0)`;
        });

        document.addEventListener("mouseout", () => {
            if (!cursor || !cursorWrapper) return;
            cursor.style.opacity = "0";
            isVisible = false;
            isFullyHidden = false; // Reset on mouseout of document
            cursorWrapper.classList.remove("native-cursor");
        });

        document.addEventListener("mouseover", (e: MouseEvent) => {
            if (!cursor) return;
            if (!isVisible && !isFullyHidden) {
                cursor.style.opacity = "1";
                isVisible = true;
            }
            updateCursorState(e);
        });

        // Click animation via Class
        document.addEventListener("mousedown", () => {
            if (!cursorWrapper) return;
            cursorWrapper.classList.add("clicking");
        });

        document.addEventListener("mouseup", () => {
            if (!cursorWrapper) return;
            cursorWrapper.classList.remove("clicking");
        });
    }
    }
</script>
