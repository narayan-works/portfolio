---
import AsciiFluidFlow from "./ascii/AsciiFluidFlow.astro";
import { FaLinkedin, FaGithub, FaInstagram, FaXTwitter } from "react-icons/fa6";
---

<footer class="site-footer" id="footer">
    <AsciiFluidFlow id="footer-ascii-fluid" />

    <div class="footer-divider"></div>

    <div class="footer-content">
        <div class="footer-left">
            <p class="contact-message">
                Let's build something worth caring about. Say hi! 👀
            </p>
            <div class="contact-buttons">
                <div class="social-icons-group">
                    <a
                        href="https://linkedin.com/in/narayan-ashanahalli/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="icon-link"
                        title="LinkedIn"
                    >
                        <FaLinkedin size={24} />
                    </a>
                    <a
                        href="https://github.com/narayan-works"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="icon-link"
                        title="GitHub"
                    >
                        <FaGithub size={24} />
                    </a>
                    <a
                        href="https://www.instagram.com/narayan.3dm/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="icon-link"
                        title="Instagram"
                    >
                        <FaInstagram size={24} />
                    </a>
                    <a
                        href="https://x.com/narayan3dm"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="icon-link"
                        title="X (Twitter)"
                    >
                        <FaXTwitter size={24} />
                    </a>
                </div>
                <button
                    class="demo-btn copy-btn"
                    data-clipboard-text="412-626-2332"
                    title="Click to copy phone number"
                >
                    <span class="btn-text">412-626-2332</span>
                </button>
                <button
                    class="demo-btn copy-btn"
                    data-clipboard-text="hello@narayan.works"
                    title="Click to copy email"
                >
                    <span class="btn-text">hello@narayan.works</span>
                </button>
            </div>
        </div>
        <div class="footer-right">
            <p class="built-message">
                Designed in Figma. Built in <a
                    href="https://astro.build"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="built-link">Astro</a
                > with <a
                    href="https://antigravity.google"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="built-link">Antigravity</a
                >.
            </p>
            <p class="copyright">
                <a
                    href="/documentation.html"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="doc-link">Documentation</a
                > &nbsp;|&nbsp; © {new Date().getFullYear()} Narayan Ashnahalli
            </p>
        </div>
    </div>
</footer>

<script>
    document.addEventListener("astro:page-load", () => {
        // Clipboard Copy Logic + Green State + ASCII Shockwave Reaction
        const copyBtns = document.querySelectorAll(".copy-btn");
        copyBtns.forEach((btn) => {
            const btnTextSpan = btn.querySelector(".btn-text");
            const originalText = btnTextSpan ? btnTextSpan.textContent : "";

            btn.addEventListener("click", (e) => {
                const text = btn.getAttribute("data-clipboard-text");
                if (text) {
                    // Lock current width to prevent bento box shrink
                    const currentWidth = btn.getBoundingClientRect().width;
                    (btn as HTMLElement).style.width = `${currentWidth}px`;
                    (btn as HTMLElement).style.justifyContent = "center";

                    navigator.clipboard.writeText(text).then(() => {
                        if (btnTextSpan) btnTextSpan.textContent = "copied!";
                        btn.classList.add("copied");

                        // Trigger ASCII canvas shockwave ripple at click location
                        const container = document.querySelector(
                            "#footer-ascii-fluid-container",
                        );
                        if (container) {
                            const rect = container.getBoundingClientRect();
                            const clickX =
                                (e as MouseEvent).clientX - rect.left;
                            const clickY = (e as MouseEvent).clientY - rect.top;

                            container.dispatchEvent(
                                new CustomEvent("trigger-ascii-ripple", {
                                    detail: { x: clickX, y: clickY },
                                }),
                            );
                        }

                        setTimeout(() => {
                            if (btnTextSpan && originalText)
                                btnTextSpan.textContent = originalText;
                            btn.classList.remove("copied");
                            (btn as HTMLElement).style.width = "";
                            (btn as HTMLElement).style.justifyContent = "";
                        }, 650);
                    });
                }
            });
        });

        // Theme Sync for ASCII Vector Fluid Canvas
        const syncFooterTheme = () => {
            const isLight =
                document.documentElement.getAttribute("data-theme") === "light";
            const container = document.querySelector(
                "#footer-ascii-fluid-container",
            );
            if (container) {
                const computed = getComputedStyle(document.documentElement);
                const brandGreen =
                    computed.getPropertyValue("--accent-secondary").trim() ||
                    "#42BD49";
                const surfaceColor = computed
                    .getPropertyValue("--bg-surface")
                    .trim();

                if (isLight) {
                    container.setAttribute("data-color", brandGreen);
                    container.setAttribute(
                        "data-bg",
                        surfaceColor || "#E6E8E0",
                    );
                    container.setAttribute("data-highlight", "#111111");
                } else {
                    container.setAttribute("data-color", brandGreen);
                    container.setAttribute(
                        "data-bg",
                        surfaceColor || "#333333",
                    );
                    container.setAttribute("data-highlight", "#FFFFFF");
                }
            }
        };

        syncFooterTheme();

        const observer = new MutationObserver(() => syncFooterTheme());
        observer.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["data-theme"],
        });
    });
</script>

<style>
    .site-footer {
        position: relative;
        display: flex;
        flex-direction: column;
        margin-top: 128px;
        margin-bottom: 0px !important;
        width: calc(100% + 40px) !important;
        margin-left: -20px !important;
        margin-right: -20px !important;
        padding-top: 24px !important;
        padding-left: 20px !important;
        padding-right: 20px !important;
        padding-bottom: 20px !important;
        background: var(--bg-surface);
        border-top: 1px solid var(--border-focus);
        box-sizing: border-box;
        overflow: hidden;
    }

    :global(.home-content) .site-footer {
        width: calc(100% + 2 * var(--total-side-padding)) !important;
        margin-left: calc(-1 * var(--total-side-padding)) !important;
        margin-right: calc(-1 * var(--total-side-padding)) !important;
        padding-top: 24px !important;
        padding-left: 20px !important;
        padding-right: 20px !important;
        padding-bottom: 20px !important;
        margin-bottom: 0px !important;
    }

    .footer-divider,
    .footer-content {
        position: relative;
        z-index: 1;
        pointer-events: none;
    }

    .contact-buttons,
    .email-phone-group,
    .social-icons-group,
    .demo-btn,
    .copy-btn,
    .icon-link,
    .social-footer-link,
    .built-message a,
    .built-link,
    .copyright a,
    .doc-link,
    a,
    button {
        /* cursor is intentionally left alone here — these are real <a>/<button>
           elements, so Layout.astro's global cursor:none + CustomCursor's hand
           icon already handle them. This used to also force cursor:pointer
           !important, which — at equal specificity and later in the cascade
           than Layout.astro's (previously-broken) rule — was winning the tie
           and showing the native pointer cursor here instead of the custom one. */
        pointer-events: auto !important;
    }

    .footer-content {
        display: flex;
        justify-content: space-between;
        align-items: stretch;
        gap: 40px;
    }

    .footer-left {
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: flex-start;
        gap: 128px;
    }

    .footer-right {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: flex-end;
        gap: 4px;
        text-align: right;
    }

    /* Preserve 100% original tag line font size */
    .contact-message {
        font-family: "Bricolage Grotesque", sans-serif;
        font-size: 72px;
        font-weight: 500;
        letter-spacing: -0.065em;
        color: var(--text-primary);
        margin: 0;
        line-height: 0.9;
        text-align: left;
        max-width: 850px;
    }

    .built-message {
        font-size: 14px;
        font-family: "Bricolage Grotesque", sans-serif;
        color: var(--text-secondary);
        margin: 0;
        line-height: 1.3;
        text-align: right;
    }

    .built-link,
    .built-message a {
        color: var(--text-primary);
        text-decoration: underline;
        text-underline-offset: 2px;
        opacity: 0.85;
        transition: opacity 0.2s ease;
    }

    .built-link:hover,
    .built-message a:hover {
        opacity: 1;
    }

    .footer-divider {
        display: none !important;
    }

    .contact-buttons {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    /* Desktop order: email (last button) first, phone (2nd button) second, icons third */
    .contact-buttons > button:last-child {
        order: 1;
    } /* email */
    .contact-buttons > button:nth-child(2) {
        order: 2;
    } /* phone */
    .contact-buttons > .social-icons-group {
        order: 3;
    } /* icons */

    .email-phone-group {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 12px;
    }

    .social-icons-group {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 12px;
    }

    .demo-btn {
        display: inline-flex;
        align-items: center;
        height: 24px;
        padding: 0 10px;
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid var(--border-focus, rgba(255, 255, 255, 0.25));
        color: var(--text-primary);
        font-family: "Bricolage Grotesque", sans-serif;
        font-size: 12px;
        font-weight: 500;
        line-height: 1;
        cursor: pointer;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.18),
            inset 0 -1px 0 rgba(0, 0, 0, 0.3),
            0 2px 6px rgba(0, 0, 0, 0.18);
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

    .demo-btn:hover {
        background: rgba(255, 255, 255, 0.16);
        border-color: var(--text-primary);
        color: var(--text-highlight);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.28),
            inset 0 -1px 0 rgba(0, 0, 0, 0.4),
            0 4px 12px rgba(0, 0, 0, 0.24);
        transform: translateY(-1px);
    }

    :global([data-theme="light"]) .demo-btn {
        background: rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(0, 0, 0, 0.3);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.7),
            inset 0 -1px 0 rgba(0, 0, 0, 0.15),
            0 2px 6px rgba(0, 0, 0, 0.08);
    }

    :global([data-theme="light"]) .demo-btn:hover {
        background: rgba(0, 0, 0, 0.09);
        border-color: rgba(0, 0, 0, 0.55);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.85),
            inset 0 -1px 0 rgba(0, 0, 0, 0.22),
            0 4px 10px rgba(0, 0, 0, 0.12);
    }

    .demo-btn.copied {
        background: var(--accent-secondary, #42bd49) !important;
        color: #ffffff !important;
        border-color: var(--accent-secondary, #42bd49) !important;
        box-shadow:
            inset 0 2px 4px rgba(0, 0, 0, 0.35),
            inset 0 -1px 0 rgba(255, 255, 255, 0.25),
            0 1px 2px rgba(0, 0, 0, 0.12) !important;
        transform: translateY(1px) !important;
    }

    .demo-btn.copied .btn-text {
        color: #ffffff !important;
        font-weight: 550 !important;
    }

    .icon-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 24px;
        width: 24px;
        padding: 0;
        background: transparent;
        border: none;
        color: var(--text-secondary);
        cursor: pointer;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

    .icon-link svg {
        pointer-events: none;
        cursor: pointer;
    }

    .icon-link:hover {
        color: var(--text-primary);
        transform: translateY(-1px);
    }

    .copyright {
        font-size: 14px;
        font-family: "Bricolage Grotesque", sans-serif;
        color: var(--text-secondary);
        margin: 0;
        line-height: 1.3;
    }

    .doc-link {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 2px;
        opacity: 0.85;
        transition: opacity 0.2s ease;
    }

    .doc-link:hover {
        opacity: 1;
        color: var(--text-primary);
    }

    @media (max-width: 1024px) {
        :global(.home-content) .site-footer {
            width: calc(100% + 96px) !important;
            margin-left: -48px !important;
            margin-right: -48px !important;
            padding-left: 48px !important;
            padding-right: 48px !important;
        }
    }

    @media (max-width: 768px) {
        :global(.home-content) .site-footer {
            width: calc(100% + 48px) !important;
            margin-left: -24px !important;
            margin-right: -24px !important;
            padding-left: 24px !important;
            padding-right: 24px !important;
        }
    }

    /* Mobile Clean Vertical Stack Layout */
    @media (max-width: 600px) {
        .site-footer {
            padding-left: 20px !important;
            padding-right: 20px !important;
            padding-top: 24px !important;
            padding-bottom: 24px !important;
        }

        .footer-content {
            display: flex !important;
            flex-direction: column !important;
            align-items: flex-start !important;
            justify-content: flex-start !important;
            gap: 8px !important;
            width: 100% !important;
        }

        .footer-left {
            display: flex !important;
            flex-direction: column !important;
            align-items: flex-start !important;
            justify-content: flex-start !important;
            gap: 36px !important;
            width: 100% !important;
        }

        .contact-message {
            font-size: 44px !important;
            line-height: 0.88 !important;
            margin: 0 !important;
            text-align: left !important;
            width: 100% !important;
        }

        .contact-buttons {
            display: flex !important;
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 8px !important;
            width: 100% !important;
        }

        /* Mobile order: icons first, phone second, email third (HTML source order) */
        .contact-buttons > .social-icons-group {
            order: 1 !important;
        }
        .contact-buttons > button:nth-child(2) {
            order: 2 !important;
        } /* phone */
        .contact-buttons > button:last-child {
            order: 3 !important;
        } /* email */

        .social-icons-group {
            display: flex !important;
            flex-direction: row !important;
            align-items: center !important;
            gap: 8px !important;
            margin-top: 0 !important;
        }

        .footer-right {
            display: flex !important;
            flex-direction: column !important;
            align-items: flex-start !important;
            justify-content: flex-start !important;
            text-align: left !important;
            gap: 4px !important;
            width: 100% !important;
            margin-top: 4px !important;
        }

        .built-message {
            text-align: left !important;
            font-size: 14px !important;
        }

        .copyright {
            text-align: left !important;
            font-size: 14px !important;
        }
    }
</style>
