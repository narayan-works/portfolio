</footer>

<script>
    document.addEventListener("astro:page-load", () => {
        // Clipboard Copy Logic
        const copyBtns = document.querySelectorAll(".copy-btn");
        copyBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                const text = btn.getAttribute("data-clipboard-text");
                if (text) {
                    navigator.clipboard.writeText(text).then(() => {
                        btn.classList.add("copied");
                        setTimeout(() => {
                            btn.classList.remove("copied");
                        }, 1000);
                    });
                }
            });
        });

        // Hover Ripple Animation with Scroll Delay and Viewport Tracking
        const footer = document.querySelector(".site-footer") as HTMLElement;
        if (footer) {
            let hoverTimeout: any = null;
            let lastClientX = 0;
            let lastClientY = 0;

            // Track global viewport coordinates
            document.addEventListener("mousemove", (e) => {
                lastClientX = e.clientX;
                lastClientY = e.clientY;
            });

            const updateCoords = () => {
                const rect = footer.getBoundingClientRect();
                const x = lastClientX - rect.left;
                const y = lastClientY - rect.top;
                footer.style.setProperty("--mouse-x", `${x}px`);
                footer.style.setProperty("--mouse-y", `${y}px`);
            };

            footer.addEventListener("mouseenter", (e) => {
                if (hoverTimeout) clearTimeout(hoverTimeout);
                lastClientX = e.clientX;
                lastClientY = e.clientY;
                updateCoords();
                
                hoverTimeout = setTimeout(() => {
                    // Recalculate right before transition starts to account for scroll offsets
                    updateCoords();
                    footer.classList.add("is-hovered");
                }, 150); // Reduced delay to 150ms
            });

            footer.addEventListener("mousemove", (e) => {
                lastClientX = e.clientX;
                lastClientY = e.clientY;
                updateCoords();
            });

            footer.addEventListener("mouseleave", () => {
                if (hoverTimeout) clearTimeout(hoverTimeout);
                footer.classList.remove("is-hovered");
            });

            // Keep coords pinned to cursor during scroll
            document.addEventListener("scroll", () => {
                if (footer.classList.contains("is-hovered")) {
                    updateCoords();
                }
            });
        }
    });
</script>

<style>
    .site-footer {
        display: flex;
        flex-direction: column;
        margin-top: 128px;
        margin-bottom: 0px !important;
        width: calc(100% + 40px) !important;
        margin-left: -20px !important;
        margin-right: -20px !important;
        padding-top: 0px !important;
        padding-left: 20px !important;
        padding-right: 20px !important;
        padding-bottom: 20px !important;
        background: var(--bg-surface);
        box-sizing: border-box;
    }

    :global(.home-content) .site-footer {
        width: calc(100% + 2 * var(--total-side-padding)) !important;
        margin-left: calc(-1 * var(--total-side-padding)) !important;
        margin-right: calc(-1 * var(--total-side-padding)) !important;
        padding-top: 0px !important;
        padding-left: 20px !important;
        padding-right: 20px !important;
        padding-bottom: 20px !important;
        margin-bottom: 0px !important;
    }

    .footer-content {
        display: flex;
        justify-content: space-between;
        align-items: stretch;
        gap: 40px;
    }

    .footer-left {
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: flex-start;
        gap: 20px;
    }

    .footer-right {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: flex-end;
        gap: 4px;
        text-align: right;
    }

    .contact-message {
        font-family: "Bricolage Grotesque", sans-serif;
        font-size: 72px;
        font-weight: 500;
        letter-spacing: -0.065em;
        color: var(--text-primary);
        margin: 0;
        line-height: 0.9;
        text-align: left;
        max-width: 850px;
    }

    .built-message {
        font-size: 14px;
        color: var(--text-secondary);
        margin: 0;
        line-height: 1.3;
        text-align: right;
    }

    .built-message a {
        color: var(--text-primary);
        text-decoration: underline;
        text-underline-offset: 2px;
        opacity: 0.7;
        transition: opacity 0.2s ease;
    }

    .built-message a:hover {
        opacity: 1;
    }

    .footer-divider {
        height: 1px;
        background: var(--border-focus);
        margin-left: -20px !important;
        margin-right: -20px !important;
        width: calc(100% + 40px) !important;
        margin-bottom: 20px;
    }

    .contact-buttons {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 6px;
    }

    .copy-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        background: transparent;
        border: 1px solid transparent; /* No bento in normal state */
        border-radius: var(--radius-md);
        color: var(--text-secondary);
        font-size: 14px;
        font-family: "Bricolage Grotesque", sans-serif;
        font-weight: 450;
        letter-spacing: 0em;
        line-height: 1.1;
        cursor: pointer;
        transition: all 0.15s ease;
        position: relative;
        user-select: none;
        margin-left: -12px; /* Align text perfectly with left edge of top text */
        margin-top: -6px; /* Keep vertical spacing tight in unhovered state */
        margin-bottom: -6px;
    }

    .copy-btn:hover:not(.copied) {
        color: var(--accent-secondary);
    }

    .social-footer-link {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        background: transparent;
        border: 1px solid transparent;
        border-radius: var(--radius-md);
        color: var(--text-secondary);
        font-size: 14px;
        font-family: "Bricolage Grotesque", sans-serif;
        font-weight: 500;
        letter-spacing: 0em;
        line-height: 1.5;
        cursor: pointer;
        transition: all 0.15s ease;
        position: relative;
        user-select: none;
        margin-left: -12px;
        margin-top: -6px;
        margin-bottom: -6px;
        text-decoration: none;
    }

    .social-footer-link:hover {
        color: var(--accent-secondary);
    }

    .footer-arrow {
        font-family: var(--font-sans);
        display: inline-block;
        transition: transform 0.2s ease;
        margin-left: 2px;
    }

    .social-footer-link:hover .footer-arrow {
        transform: translate(2px, -2px);
    }

    .btn-text {
        position: relative;
        display: inline-block;
    }

    .btn-text::after {
        content: "";
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 100%;
        height: 1px;
        background-color: var(--accent-secondary);
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.2s ease;
    }

    .copy-btn:hover:not(.copied) .btn-text::after,
    .social-footer-link:hover .btn-text::after,
    .copy-btn.copied .btn-text::after {
        transform: scaleX(1);
        transform-origin: left;
    }

    .copy-btn * {
        cursor: pointer;
    }

    .copy-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        border: 1px solid transparent;
        border-radius: var(--radius-sm);
        color: var(--text-secondary);
        background: transparent;
        transition: all 0.15s ease;
        box-sizing: border-box;
        opacity: 0.5;
    }

    .copy-btn:hover:not(.copied) .copy-icon {
        border-color: var(--accent-secondary);
        color: var(--accent-secondary);
        opacity: 1;
    }

    /* Default copied state (Dark Mode: Beige background, dark text/strokes) */
    .copy-btn.copied {
        background: #f4f0ea !important;
        color: #111111 !important;
        border: 1px solid #f4f0ea !important;
        border-radius: var(--radius-md) !important;
    }

    .copy-btn.copied .copy-icon {
        background: transparent !important;
        border-color: transparent !important;
        color: #111111 !important;
        opacity: 1 !important;
    }

    .copy-btn.copied .copy-icon svg {
        stroke: #111111 !important;
    }



    /* Snappy transition for copy feedback */
    .copy-btn,
    .copy-btn .copy-icon,
    .copy-btn .copy-icon svg {
        transition: all 0.25s ease-in-out !important;
    }

    .footer-text {
        text-align: right;
    }

    .tagline {
        font-size: 12px;
        color: var(--text-secondary);
        margin: 0;
        font-style: italic;
        line-height: 1.3;
    }

    .copyright {
        font-size: 14px;
        color: var(--text-muted);
        margin: 0;
        line-height: 1.3;
    }

    @media (max-width: 1024px) {
        :global(.home-content) .site-footer {
            width: calc(100% + 96px) !important;
            margin-left: -48px !important;
            margin-right: -48px !important;
            padding-left: 48px !important;
            padding-right: 48px !important;
        }
        .footer-divider {
            margin-left: -48px !important;
            margin-right: -48px !important;
            width: calc(100% + 96px) !important;
        }
    }

    @media (max-width: 768px) {
        :global(.home-content) .site-footer {
            width: calc(100% + 48px) !important;
            margin-left: -24px !important;
            margin-right: -24px !important;
            padding-left: 24px !important;
            padding-right: 24px !important;
        }
        .footer-divider {
            margin-left: -24px !important;
            margin-right: -24px !important;
            width: calc(100% + 48px) !important;
        }
        .built-message,
        .copyright,
        .copy-btn,
        .social-footer-link {
            font-size: 14px !important;
        }
    }

    @media (max-width: 600px) {
        .site-footer {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .footer-content,
        .footer-left,
        .footer-right {
            display: contents;
        }

        .contact-message {
            order: 1;
            max-width: 100%;
            margin-bottom: 0;
            text-align: left;
            font-size: 36px;
            line-height: 1.25;
        }

        .contact-buttons {
            order: 2;
            flex-wrap: wrap;
        }

        .footer-divider {
            order: 0;
            margin-top: 0px !important;
            margin-bottom: 20px !important;
            margin-left: -24px !important;
            margin-right: -24px !important;
            width: calc(100% + 48px) !important;
        }

        .built-message {
            order: 4;
            text-align: left;
            margin-bottom: 0;
        }

        .tagline {
            display: none;
        }

        .copyright {
            order: 5;
            text-align: left;
        }
    }

    /* Footer Green Ripple & Hover Overrides */
    @property --ripple-radius {
        syntax: '<length-percentage>';
        inherits: false;
        initial-value: 0px;
    }

    .site-footer {
        position: relative;
        overflow: hidden;
        background-color: var(--bg-surface) !important;
        background-image: radial-gradient(
            circle var(--ripple-radius) at var(--mouse-x, 50%) var(--mouse-y, 50%),
            var(--accent-secondary, #42BD49) 0%,
            var(--accent-secondary, #42BD49) 100%,
            transparent 100%
        ) !important;
        /* On leave: soft shrink */
        transition: --ripple-radius 1.1s ease-in-out;
        --ripple-radius: 0px;
    }

    .site-footer.is-hovered {
        --ripple-radius: 120vw;
        /* On enter: radial expansion */
        transition: --ripple-radius 1.1s ease-in-out;
    }

    .footer-divider,
    .footer-content {
        position: relative;
        z-index: 1;
    }

    .contact-message,
    .built-message,
    .copyright,
    .social-footer-link,
    .copy-btn,
    .copy-icon svg,
    .arrow-svg path,
    .footer-divider {
        transition: color 1.1s ease-in-out, 
                    stroke 1.1s ease-in-out, 
                    background-color 1.1s ease-in-out,
                    background 1.1s ease-in-out !important;
    }

    .site-footer.is-hovered .contact-message {
        color: #111111 !important;
    }

    .site-footer.is-hovered .built-message,
    .site-footer.is-hovered .copyright {
        color: rgba(17, 17, 17, 0.7) !important;
    }

    .site-footer.is-hovered .built-message a {
        color: #111111 !important;
        opacity: 0.8 !important;
    }

    .site-footer.is-hovered .social-footer-link,
    .site-footer.is-hovered .copy-btn {
        color: #111111 !important;
    }

    .site-footer.is-hovered .copy-btn:hover:not(.copied),
    .site-footer.is-hovered .social-footer-link:hover {
        color: #000000 !important;
        opacity: 1 !important;
    }

    .site-footer.is-hovered .footer-divider {
        background: rgba(17, 17, 17, 0.12) !important;
    }

    .site-footer.is-hovered .copy-icon svg {
        stroke: #111111 !important;
    }

    .site-footer.is-hovered .arrow-svg path {
        stroke: #111111 !important;
    }

</style>
