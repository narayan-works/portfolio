---
// SoundToggle.astro
---

<button id="sound-toggle" aria-label="Toggle Sound Effects" title="Toggle sound effects">
    <span class="icon-wrap">
        <!-- Sound Unmuted Icon (Wave) -->
        <svg
            class="sound-on-icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
            <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
        </svg>

        <!-- Sound Muted Icon (Mute X) -->
        <svg
            class="sound-off-icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <line x1="23" y1="9" x2="17" y2="15"></line>
            <line x1="17" y1="9" x2="23" y2="15"></line>
        </svg>
    </span>
</button>

<style>
    #sound-toggle {
        width: 32px;
        height: 32px;
        padding: 0;
        background: rgba(128, 128, 128, 0.12);
        backdrop-filter: blur(12px) saturate(150%);
        -webkit-backdrop-filter: blur(12px) saturate(150%);
        border: 1px solid var(--border-subtle);
        color: var(--text-primary);
        cursor: pointer;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.12),
            0 2px 8px rgba(0, 0, 0, 0.1);
        transition:
            color 0.2s ease,
            border-color 0.2s ease,
            background-color 0.2s ease,
            box-shadow 0.2s ease;
    }

    #sound-toggle:hover {
        color: var(--accent-secondary, #42bd49);
        border-color: var(--accent-secondary, #42bd49);
        background: rgba(66, 189, 73, 0.14);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.16),
            0 4px 12px rgba(0, 0, 0, 0.12);
    }

    .icon-wrap {
        position: relative;
        width: 15px;
        height: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: inherit;
    }

    .sound-on-icon,
    .sound-off-icon {
        position: absolute;
        top: 0;
        left: 0;
        width: 15px;
        height: 15px;
        transition:
            opacity 0.25s ease,
            transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Sound On (Default) */
    .sound-on-icon {
        opacity: 1;
        transform: scale(1);
    }
    .sound-off-icon {
        opacity: 0;
        transform: scale(0.6);
    }

    /* Sound Muted State */
    :global([data-sound-muted="true"]) .sound-on-icon {
        opacity: 0;
        transform: scale(0.6);
    }
    :global([data-sound-muted="true"]) .sound-off-icon {
        opacity: 1;
        transform: scale(1);
    }
</style>

<script>
    import { isSoundMuted, toggleSoundMute, playSound } from "../utils/sounds";

    function updateSoundToggleState() {
        const muted = isSoundMuted();
        if (muted) {
            document.documentElement.setAttribute("data-sound-muted", "true");
        } else {
            document.documentElement.removeAttribute("data-sound-muted");
        }
    }

    function setupSoundToggle() {
        const btn = document.getElementById("sound-toggle");
        if (btn) {
            btn.onclick = () => {
                const isNowMuted = toggleSoundMute();
                updateSoundToggleState();
                if (!isNowMuted) {
                    playSound.click();
                }
            };
        }
        updateSoundToggleState();
    }

    window.addEventListener("portfolio-sound-mute-change", updateSoundToggleState);
    setupSoundToggle();
    document.addEventListener("astro:page-load", setupSoundToggle);
</script>
