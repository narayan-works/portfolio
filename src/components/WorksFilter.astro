---
// WorksFilter.astro
---

<div class="works-filter-container">
    <div class="segmented-control" id="works-segmented-control">
        <button class="filter-btn active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="hardware-ux">Hardware</button>
        <button class="filter-btn" data-filter="web-ux">Web</button>
        <button class="filter-btn" data-filter="mobile-ux">Mobile</button>
    </div>
</div>

<style>
    /* Animatable custom color properties — allows CSS to interpolate gradient stops */
    @property --c1 {
        syntax: "<color>";
        inherits: false;
        initial-value: transparent;
    }
    @property --c2 {
        syntax: "<color>";
        inherits: false;
        initial-value: transparent;
    }
    @property --c3 {
        syntax: "<color>";
        inherits: false;
        initial-value: transparent;
    }
    @property --c4 {
        syntax: "<color>";
        inherits: false;
        initial-value: transparent;
    }

    .works-filter-container {
        display: flex;
        justify-content: center;
        margin-bottom: 0;
        position: relative;
        z-index: 10;
        width: 100%;
    }

    .segmented-control {
        display: inline-flex;
        align-items: center;
        background: #e6e6e1;
        height: 30px;
        padding: 3px;
        border-radius: var(--radius-md);
        border: 1px solid rgba(0, 0, 0, 0.12);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.6),
            2px 3px 8px rgba(0, 0, 0, 0.1),
            1px 1.5px 3px rgba(0, 0, 0, 0.06);
        position: relative;
        overflow: hidden;
        max-width: 100%;
        box-sizing: border-box;
        gap: 3px;
        transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }

    :global([data-theme="dark"]) .segmented-control,
    :root:not([data-theme="light"]) .segmented-control {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.05),
            2px 3px 8px rgba(0, 0, 0, 0.3),
            1px 1.5px 4px rgba(0, 0, 0, 0.2);
    }

    /* Each button owns its own background via animatable CSS custom properties */
    .filter-btn {
        border: 1px solid transparent;
        color: var(--text-secondary);
        height: 22px;
        padding: 0 12px;
        border-radius: var(--radius-sm);
        cursor: pointer;
        font-family: var(--font-sans);
        font-size: 13px;
        font-weight: 500;
        text-transform: none;
        letter-spacing: 0;
        line-height: 1;
        flex: 0 0 auto;

        /* Default: transparent background */
        --c1: transparent;
        --c2: transparent;
        --c3: transparent;
        --c4: transparent;
        background: linear-gradient(
            90deg,
            var(--c1),
            var(--c2),
            var(--c3),
            var(--c4)
        );

        transform: translateY(0px);
        transition:
            --c1 0.4s cubic-bezier(0.22, 1, 0.36, 1),
            --c2 0.4s cubic-bezier(0.22, 1, 0.36, 1),
            --c3 0.4s cubic-bezier(0.22, 1, 0.36, 1),
            --c4 0.4s cubic-bezier(0.22, 1, 0.36, 1),
            color 0.35s cubic-bezier(0.22, 1, 0.36, 1),
            box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1),
            border-color 0.35s cubic-bezier(0.22, 1, 0.36, 1),
            transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);

        position: relative;
        z-index: 2;
        white-space: nowrap;
        outline: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
    }

    /* Bevel UP (raised key) effect on hover with short delay */
    .filter-btn:hover:not(.active) {
        box-shadow:
            inset 1px 1px 1px rgba(255, 255, 255, 0.45),
            1px 2px 4px rgba(0, 0, 0, 0.12);
        border-color: rgba(255, 255, 255, 0.3);
        /* No vertical lift: inside a 4px-padded track any offset shows up as
           uneven top/bottom padding. The inset highlight + drop shadow above
           carry the raised-key read on their own. */
        transform: translateY(0);
        transition:
            --c1 0.25s cubic-bezier(0.22, 1, 0.36, 1),
            --c2 0.25s cubic-bezier(0.22, 1, 0.36, 1),
            --c3 0.25s cubic-bezier(0.22, 1, 0.36, 1),
            --c4 0.25s cubic-bezier(0.22, 1, 0.36, 1),
            color 0.25s ease,
            box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1),
            border-color 0.35s ease,
            transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
        transition-delay: 60ms;
    }

    /* ── Hover states (each button has its own brand color) ── */
    .filter-btn[data-filter="all"]:hover {
        --c1: #000000;
        --c2: #000000;
        --c3: #000000;
        --c4: #000000;
        color: #ffffff;
    }
    .filter-btn[data-filter="hardware-ux"]:hover {
        --c1: #0d8ce9;
        --c2: #0d8ce9;
        --c3: #0d8ce9;
        --c4: #0d8ce9;
        color: #000000;
    }
    .filter-btn[data-filter="web-ux"]:hover {
        --c1: #f1614c;
        --c2: #f1614c;
        --c3: #f1614c;
        --c4: #f1614c;
        color: #000000;
    }
    .filter-btn[data-filter="mobile-ux"]:hover {
        --c1: #f4f537;
        --c2: #f4f537;
        --c3: #f4f537;
        --c4: #f4f537;
        color: #000000;
    }
    .filter-btn[data-filter="spatial-xd"]:hover {
        --c1: #41b748;
        --c2: #41b748;
        --c3: #41b748;
        --c4: #41b748;
        color: #000000;
    }
    .filter-btn[data-filter="experiments"]:hover {
        --c1: #a855f7;
        --c2: #a855f7;
        --c3: #a855f7;
        --c4: #a855f7;
        color: #ffffff;
    }

    /*
     * ── Active (selected) state with TRUE BEVELED DOWN (pressed inset) depth ──
     * Top-left inner overhang shadow + bottom-right inner catch-light
     */
    .filter-btn.active {
        color: #000000 !important;
        border-color: rgba(0, 0, 0, 0.12);
        transform: translateY(0px);
        box-shadow:
            inset 1px 1.5px 3px rgba(0, 0, 0, 0.16),
            inset -1px -1px 1.5px rgba(255, 255, 255, 0.4);
        transition:
            color 0.35s cubic-bezier(0.22, 1, 0.36, 1),
            box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1),
            border-color 0.35s cubic-bezier(0.22, 1, 0.36, 1),
            transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .filter-btn.active[data-filter="all"] {
        color: #ffffff !important;
        border-color: rgba(0, 0, 0, 0.2);
        box-shadow:
            inset 1px 1.5px 3px rgba(0, 0, 0, 0.3),
            inset -1px -1px 1.5px rgba(255, 255, 255, 0.2);
    }

    /*
     * When an active button is hovered, it shows its hover state color
     */
    .filter-btn.active[data-filter="all"]:hover {
        --c1: #000000;
        --c2: #000000;
        --c3: #000000;
        --c4: #000000;
        color: #ffffff !important;
    }
    .filter-btn.active[data-filter="hardware-ux"]:hover {
        --c1: #0d8ce9;
        --c2: #0d8ce9;
        --c3: #0d8ce9;
        --c4: #0d8ce9;
        color: #000000 !important;
    }
    .filter-btn.active[data-filter="web-ux"]:hover {
        --c1: #f1614c;
        --c2: #f1614c;
        --c3: #f1614c;
        --c4: #f1614c;
        color: #000000 !important;
    }
    .filter-btn.active[data-filter="mobile-ux"]:hover {
        --c1: #f4f537;
        --c2: #f4f537;
        --c3: #f4f537;
        --c4: #f4f537;
        color: #000000 !important;
    }
    .filter-btn.active[data-filter="spatial-xd"]:hover {
        --c1: #41b748;
        --c2: #41b748;
        --c3: #41b748;
        --c4: #41b748;
        color: #000000 !important;
    }
    .filter-btn.active[data-filter="experiments"]:hover {
        --c1: #a855f7;
        --c2: #a855f7;
        --c3: #a855f7;
        --c4: #a855f7;
        color: #ffffff !important;
    }

    .filter-btn:focus-visible {
        box-shadow: 0 0 0 2px var(--accent-secondary);
    }

    /* ── Responsive Mobile & Tablet Adjustments (Height & outer padding stay constant 36px / 4px) ── */
    @media (max-width: 768px) {
        .works-filter-container {
            justify-content: center;
            width: 100%;
            padding: 0 4px;
            box-sizing: border-box;
        }

        .segmented-control {
            gap: 3px;
            max-width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }

        .segmented-control::-webkit-scrollbar {
            display: none;
        }

        .filter-btn {
            padding: 0 8px;
            font-size: 13px;
            flex: 0 0 auto;
            white-space: nowrap;
        }
    }
</style>

<script>
    /*
     * Selected color for each filter (the color the glider would land on after click).
     * JS directly sets these as inline style properties on the button so the browser
     * interpolates from the current hover color → selected color via the 0.8s CSS transition.
     */
    const SELECTED_COLORS: Record<string, { c: string; text: string }> = {
        all: { c: "#000000", text: "#ffffff" },
        "hardware-ux": { c: "#0D8CE9", text: "#000000" },
        "web-ux": { c: "#F6631A", text: "#000000" },
        "mobile-ux": { c: "#FACC09", text: "#000000" },
        "spatial-xd": { c: "#2B923D", text: "#000000" },
    };

    function setupWorksFilter() {
        const container = document.getElementById("works-segmented-control");
        if (!container) return;

        const buttons = Array.from(
            container.querySelectorAll(".filter-btn"),
        ) as HTMLElement[];

        /**
         * Apply the selected color with staggered JS setProperty calls.
         * --c1 arrives first, --c4 arrives 180ms later, mirroring the CSS
         * transition-delay stagger — so the wave sweeps left→right on click.
         */
        function selectButton(btn: HTMLElement) {
            const filter = btn.getAttribute("data-filter") || "all";
            const { c, text } =
                SELECTED_COLORS[filter] || SELECTED_COLORS["all"];
            btn.style.setProperty("--c1", c);
            setTimeout(() => btn.style.setProperty("--c2", c), 60);
            setTimeout(() => btn.style.setProperty("--c3", c), 120);
            setTimeout(() => btn.style.setProperty("--c4", c), 180);
            btn.style.color = text;
        }

        /**
         * Remove all inline colors simultaneously — the 0.8s CSS transition
         * on the base .filter-btn rule (no stagger) fades them all at once
         * for a clean, simple vanish back to the default background.
         */
        function deselectButton(btn: HTMLElement) {
            btn.style.removeProperty("--c1");
            btn.style.removeProperty("--c2");
            btn.style.removeProperty("--c3");
            btn.style.removeProperty("--c4");
            btn.style.removeProperty("color");
        }

        // Determine active filter from URL hash
        const hash = window.location.hash.slice(1);
        const validFilters = [
            "hardware-ux",
            "web-ux",
            "mobile-ux",
            "experiments",
        ];
        const activeFilter = validFilters.includes(hash) ? hash : "all";

        // Initialize: set selected color on the correct button based on the hash
        buttons.forEach((btn) => {
            const filter = btn.getAttribute("data-filter") || "all";
            if (filter === activeFilter) {
                btn.classList.add("active");
                // Suppress transition on first paint
                btn.style.transition = "none";
                selectButton(btn);
                // Re-enable transition in next frame
                requestAnimationFrame(() => {
                    btn.style.removeProperty("transition");
                });
            } else {
                btn.classList.remove("active");
                deselectButton(btn);
            }
        });

        buttons.forEach((btn) => {
            btn.addEventListener("click", (e) => {
                const target = e.currentTarget as HTMLElement;
                if (target.classList.contains("active")) return; // already selected

                // Deselect current active button (dissolves slowly via 0.8s transition)
                const currentActive = container.querySelector(
                    ".filter-btn.active",
                ) as HTMLElement | null;
                if (currentActive) {
                    currentActive.classList.remove("active");
                    deselectButton(currentActive);
                }

                // Select new button — browser interpolates hover color → selected color
                target.classList.add("active");
                selectButton(target);

                const filterValue = target.getAttribute("data-filter") || "all";

                // Update URL Hash without jumping/scrolling
                if (filterValue === "all") {
                    history.pushState(
                        "",
                        document.title,
                        window.location.pathname + window.location.search,
                    );
                } else {
                    history.pushState("", document.title, "#" + filterValue);
                }

                window.dispatchEvent(
                    new CustomEvent("works-filter-change", {
                        detail: { filter: filterValue },
                    }),
                );
            });
        });

        // Listen for back/forward browser navigation (hashchange)
        const onHashChange = () => {
            const newHash = window.location.hash.slice(1);
            const targetFilter = validFilters.includes(newHash)
                ? newHash
                : "all";
            const targetBtn = container.querySelector(
                `.filter-btn[data-filter="${targetFilter}"]`,
            ) as HTMLElement | null;
            if (targetBtn && !targetBtn.classList.contains("active")) {
                targetBtn.click();
            }
        };

        if ((window as any)._worksFilterHashListener) {
            window.removeEventListener(
                "hashchange",
                (window as any)._worksFilterHashListener,
            );
        }
        (window as any)._worksFilterHashListener = onHashChange;
        window.addEventListener("hashchange", onHashChange);
    }

    setupWorksFilter();
    document.addEventListener("astro:page-load", setupWorksFilter);
</script>
