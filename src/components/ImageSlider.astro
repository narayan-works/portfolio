---
interface Slide {
    src: string;
    alt: string;
    label: string;
    title?: string;
}

import { Image } from "astro:assets";

interface Props {
    slides: Slide[];
    constrain?: boolean;
    autoplay?: boolean;
    interval?: number;
    showControls?: boolean;
    transitionType?: "slide" | "instant";
    indicatorType?: "segmented" | "dots";
    variant?: "standard" | "carousel";
    initialIndex?: number;
    /** Orientation-handling strategy for mixed portrait/landscape slide sets. Defaults to "cover" (existing behavior, unchanged). */
    frameStrategy?: "cover" | "adaptive" | "letterbox" | "split";
    /** Adds hover-revealed prev/next arrow buttons. Defaults to off (existing behavior, unchanged). */
    showArrows?: boolean;
}

const {
    slides,
    constrain = true,
    autoplay = false,
    interval = 3000,
    showControls = true,
    transitionType = "slide",
    indicatorType = "segmented",
    variant = "standard",
    initialIndex = 0,
    frameStrategy = "cover",
    showArrows = false,
} = Astro.props;
const sliderId = `slider-${Math.random().toString(36).substr(2, 9)}`;
---

<div
    class:list={["image-slider", { constrained: constrain }]}
    id={sliderId}
    data-transition={transitionType}
    data-variant={variant}
    data-frame={frameStrategy}
>
    <div class="slider-frame">
    <div class="slider-display">
        <div class="slider-track">
            {
                slides.map((slide, index) => (
                    <div class="slide" data-index={index}>
                        {slide.title && (
                            <div class="slide-title">{slide.title}</div>
                        )}
                        {frameStrategy === "letterbox" &&
                            typeof slide.src === "string" &&
                            !slide.src.endsWith(".mp4") && (
                                <img
                                    src={slide.src}
                                    alt=""
                                    aria-hidden="true"
                                    loading="lazy"
                                    decoding="async"
                                    class="letterbox-bg"
                                />
                            )}
                        {typeof slide.src === "string" ? (
                            slide.src.endsWith(".mp4") ? (
                                <video
                                    src={slide.src}
                                    autoplay
                                    loop
                                    muted
                                    playsinline
                                    preload="metadata"
                                    class="optimized-slide-image"
                                />
                            ) : (
                                <img
                                    src={slide.src}
                                    alt={slide.alt}
                                    loading="lazy"
                                    decoding="async"
                                    class="optimized-slide-image"
                                />
                            )
                        ) : (
                            <Image
                                src={slide.src}
                                alt={slide.alt}
                                width={1920}
                                height={1080}
                                loading="lazy"
                                decoding="async"
                                class="optimized-slide-image"
                            />
                        )}
                    </div>
                ))
            }
        </div>

        {showArrows && (
            <>
                <button
                    type="button"
                    class="slider-arrow slider-arrow-prev"
                    aria-label="Previous slide"
                    data-arrow="prev"
                >
                    ‹
                </button>
                <button
                    type="button"
                    class="slider-arrow slider-arrow-next"
                    aria-label="Next slide"
                    data-arrow="next"
                >
                    ›
                </button>
            </>
        )}
    </div>
    </div>

    {showControls && (
        indicatorType === "segmented" ? (
            <div class="slider-controls">
                <div class="active-pill"></div>
                {
                    slides.map((slide, index) => (
                        <button
                            class={`control-btn ${index === initialIndex ? "active" : ""}`}
                            data-target={index}
                        >
                            {slide.label}
                        </button>
                    ))
                }
            </div>
        ) : (
            <div class="slider-dots">
                {
                    slides.map((slide, index) => (
                        <button
                            class={`slider-dot-wrap ${index === initialIndex ? "active" : ""}`}
                            data-target={index}
                            aria-label={`Go to slide ${index + 1}`}
                        >
                            <span class="slider-dot-pill" />
                        </button>
                    ))
                }
            </div>
        )
    )}

    <div class="slider-lightbox" data-open="false" aria-hidden="true">
        <button
            type="button"
            class="slider-lightbox-close"
            aria-label="Close enlarged image"
        >
            <svg
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
            >
                <path
                    d="M3 3L13 13M13 3L3 13"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                />
            </svg>
        </button>
        <img class="slider-lightbox-img" src="" alt="" />
    </div>
</div>

<style>
    .image-slider {
        width: 100%;
        margin-top: 4rem;
        margin-bottom: 2rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding-inline: 0;
        box-sizing: border-box;
        overflow: hidden; /* Contain horizontal overflow bleed */
        user-select: none; /* Prevent accidental text highlighting during drag */
    }

    .image-slider.constrained {
        max-width: min(750px, 100%);
        margin-left: auto;
        margin-right: auto;
    }

    /* Neutral pass-through wrapper by default (only the "adaptive" frame strategy below
       gives it a fixed reserved height so indicators after it don't shift as slides change size). */
    .slider-frame {
        width: 100%;
    }

    .slider-display {
        position: relative;
        width: 100%;
        aspect-ratio: 16/9;
        border-radius: var(--radius-md);
        overflow: hidden;
        background: var(--surface-secondary);
        cursor: grab;
        touch-action: pan-y; /* Prevent browser horizontal swipe gestures from interrupting slider drag */
    }

    .slider-display:active {
        cursor: grabbing;
    }

    .slider-track {
        display: flex;
        width: 100%;
        height: 100%;
        transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
        will-change: transform;
    }

    .image-slider[data-transition="instant"] .slider-track {
        transition: none !important;
    }

    .slide {
        min-width: 100%;
        height: 100%;
        position: relative;
        z-index: 1;
    }

    .slide-title {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 2;
        padding: 0.75rem 0.9rem 1.5rem;
        font-family: var(--font-sans);
        font-size: 0.75rem;
        line-height: 1.35;
        color: #fff;
        background: linear-gradient(
            to bottom,
            rgba(0, 0, 0, 0.85) 0%,
            rgba(0, 0, 0, 0.7) 40%,
            rgba(0, 0, 0, 0.35) 75%,
            rgba(0, 0, 0, 0) 100%
        );
        opacity: 0;
        transition: opacity 0.3s ease;
        /* Overrides .image-slider's user-select:none (added to stop
           accidental highlighting while dragging the slider itself) so
           this citation text can still be selected/copied normally. */
        pointer-events: auto;
        user-select: text;
        cursor: text;
    }

    .slide.active .slide-title {
        opacity: 1;
    }

    .slide .optimized-slide-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        pointer-events: none; /* Prevent browser native image dragging */
        background: var(--bg-primary); /* Solid background to block transparency bleed through */
    }

    /* PREV/NEXT ARROWS (opt-in via showArrows) */
    .slider-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 5;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: none;
        background: rgba(0, 0, 0, 0.4);
        color: #fff;
        font-size: 20px;
        line-height: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.2s ease, background-color 0.2s ease, transform 0.15s ease;
        backdrop-filter: blur(4px);
    }

    .slider-display:hover .slider-arrow {
        opacity: 1;
    }

    .slider-arrow:hover {
        background: rgba(0, 0, 0, 0.65);
    }

    .slider-arrow:active {
        transform: translateY(-50%) scale(0.9);
    }

    .slider-arrow-prev {
        left: 12px;
    }

    .slider-arrow-next {
        right: 12px;
    }

    /* Touch devices have no hover state to reveal arrows on, so keep them dimly visible */
    @media (hover: none) {
        .slider-arrow {
            opacity: 0.85;
        }
    }

    /* FRAME STRATEGY: ADAPTIVE (each slide's own box matches its real aspect ratio).
       .slider-frame reserves a CONSTANT height sized to the tallest slide in the set
       (--reserved-ratio, computed once in JS and only ever grows) so indicators/controls
       rendered after it never shift position. .slider-display sits centered inside that
       reserved space and is the one that actually animates per active slide. */
    .image-slider[data-frame="adaptive"] .slider-frame {
        display: flex;
        align-items: center;
        justify-content: center;
        aspect-ratio: var(--reserved-ratio, 16 / 9);
    }

    .image-slider[data-frame="adaptive"] .slider-display {
        width: 100%;
        aspect-ratio: var(--active-ratio, 16 / 9);
        transition: aspect-ratio 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* Beveled top edge, as if each slide catches light from above, plus a
       hairline depth outline (pure white/black per theme, never tinted). */
    .image-slider[data-frame="adaptive"] .slide .optimized-slide-image {
        outline: 1px solid oklch(1 0 0 / 0.1);
        outline-offset: -1px;
        box-shadow:
            inset 0 1px 0 oklch(1 0 0 / 0.35),
            inset 0 -1px 0 oklch(0 0 0 / 0.25);
    }

    :global([data-theme="light"]) .image-slider[data-frame="adaptive"] .slide .optimized-slide-image {
        outline-color: oklch(0 0 0 / 0.1);
        box-shadow:
            inset 0 1px 0 oklch(1 0 0 / 0.6),
            inset 0 -1px 0 oklch(0 0 0 / 0.12);
    }

    /* FRAME STRATEGY: LETTERBOX (fixed 16:9 frame, contained image over a blurred cover fill) */
    .image-slider[data-frame="letterbox"] .slider-display {
        background: #050505;
    }

    .image-slider[data-frame="letterbox"] .slide .optimized-slide-image {
        position: relative;
        z-index: 1;
        object-fit: contain;
    }

    .image-slider[data-frame="letterbox"] .slide .letterbox-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: blur(36px) brightness(0.55) saturate(1.2);
        transform: scale(1.15);
        z-index: 0;
        pointer-events: none;
    }

    /* FRAME STRATEGY: SPLIT (landscape stays full-bleed; portrait shrinks to a narrow contained column) */
    .image-slider[data-frame="split"] .slider-display {
        margin-left: auto;
        margin-right: auto;
        transition: max-width 0.5s cubic-bezier(0.22, 1, 0.36, 1), aspect-ratio 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .image-slider[data-frame="split"] .slider-display[data-active-orientation="portrait"] {
        max-width: calc(min(750px, 100%) * var(--active-ratio, 0.75));
        aspect-ratio: var(--active-ratio, 3 / 4);
    }

    .image-slider[data-frame="split"] .slider-display[data-active-orientation="portrait"] .optimized-slide-image {
        object-fit: contain;
    }

    /* CAROUSEL VARIANT (Clean, Infinite Carousel with Equal Spacing) */
    .image-slider[data-variant="carousel"] {
        padding-top: 0;
        padding-bottom: 0;
    }

    .image-slider[data-variant="carousel"] .slider-frame {
        width: 42%;
        margin: 0 auto;
        aspect-ratio: 16/10;
    }

    .image-slider[data-variant="carousel"] .slider-display {
        width: 100%;
        height: 100%;
        overflow: visible;
        background: transparent;
        border-radius: 0;
    }

    .image-slider[data-variant="carousel"][data-frame="adaptive"] .slider-display {
        width: 100%;
        height: 100%;
    }

    .image-slider[data-variant="carousel"][data-frame="adaptive"] .slider-frame {
        width: 42%;
        margin: 0 auto;
        aspect-ratio: 16/10;
    }

    .image-slider[data-variant="carousel"] .slider-track {
        display: flex;
        width: 100%;
        height: 100%;
        transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
        will-change: transform;
    }

    .image-slider[data-variant="carousel"] .slide {
        min-width: 100%;
        height: 100%;
        padding: 0 12px; /* Constant 24px equal gap between images */
        box-sizing: border-box;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: scale(0.88);
        transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.5s cubic-bezier(0.25, 1, 0.5, 1), visibility 0.5s;
    }

    .image-slider[data-variant="carousel"] .slide.prev,
    .image-slider[data-variant="carousel"] .slide.next {
        opacity: 0.40;
        visibility: visible;
        pointer-events: auto;
        transform: scale(0.88);
        transform-origin: center center;
        cursor: pointer;
    }

    .image-slider[data-variant="carousel"] .slide.active {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: scale(1.0);
        transform-origin: center center;
        z-index: 10;
        cursor: zoom-in;
    }

    /* --- LIGHTBOX (tap the active slide to enlarge) --- */
    /* position:fixed escapes .image-slider's overflow:hidden — no ancestor
       here sets transform/filter/contain, so no containing block is created. */
    .slider-lightbox {
        position: fixed;
        top: 0;
        bottom: 0;
        /* left/width are set in JS to the project section's column so the
           sidebar stays visible and undimmed. These are the fallbacks for a
           slider used outside a project page. */
        left: 0;
        width: 100%;
        z-index: 40000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 5vh 20px;
        box-sizing: border-box;
        /* Scrim only — the solid black belongs behind the image, not the page */
        background: rgba(0, 0, 0, 0.82);
        backdrop-filter: blur(4px);
        cursor: zoom-out;
    }

    .slider-lightbox[data-open="true"] {
        display: flex;
    }

    .slider-lightbox-img {
        /* --lightbox-width is measured in JS: 80% of the case study section */
        width: var(--lightbox-width, 80vw);
        max-width: 100%;
        max-height: 90vh;
        object-fit: contain;
        border-radius: var(--radius-md);
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
        cursor: default;
        /* Solid black behind the image: the sources are transparent PNG/GIFs,
           and object-fit:contain letterboxes them, so without this the
           semi-transparent overlay showed through instead of a clean field. */
        background: #000;
    }

    .slider-lightbox-close {
        position: absolute;
        top: 20px;
        right: 20px;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, 0.25);
        background: rgba(0, 0, 0, 0.5);
        color: #fff;
        padding: 0; /* UA button padding would offset the glyph */
        line-height: 0;
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

    .slider-lightbox-close svg {
        display: block;
    }

    .slider-lightbox-close:hover {
        background: rgba(255, 255, 255, 0.18);
    }

    .image-slider[data-variant="carousel"] .slide .optimized-slide-image,
    .image-slider[data-variant="carousel"] .slide video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: var(--radius-md);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        background: var(--bg-surface);
    }

    /* Combine the carousel's ambient lift shadow with the adaptive bevel above —
       equal specificity + later source order would otherwise let this rule
       silently win and wipe out the bevel's inset box-shadow. */
    .image-slider[data-variant="carousel"][data-frame="adaptive"] .slide .optimized-slide-image {
        box-shadow:
            inset 0 1px 0 oklch(1 0 0 / 0.35),
            inset 0 -1px 0 oklch(0 0 0 / 0.25),
            0 10px 30px rgba(0, 0, 0, 0.15);
    }

    :global([data-theme="light"]) .image-slider[data-variant="carousel"][data-frame="adaptive"] .slide .optimized-slide-image {
        box-shadow:
            inset 0 1px 0 oklch(1 0 0 / 0.6),
            inset 0 -1px 0 oklch(0 0 0 / 0.12),
            0 10px 30px rgba(0, 0, 0, 0.15);
    }

    /* CONTROLS (Bento Segmented Control) */
    .slider-controls {
        display: flex;
        position: relative;
        justify-content: center;
        gap: 0;
        background: var(--bg-surface);
        padding: 4px;
        border-radius: var(--radius-md);
        border: 1px solid var(--border-subtle);
        width: fit-content;
        margin: 0 auto;
        z-index: 0;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }

    /* Default State */
    .active-pill {
        position: absolute;
        top: 4px;
        left: 4px;
        height: calc(100% - 8px);
        background: #2196F3;
        border-radius: var(--radius-sm);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        transition:
            all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1),
            background-color 0.3s ease;
        z-index: 1;
        width: 0;
        opacity: 0;
    }

    .slider-controls[data-active-index="1"] .active-pill {
        background: #2196F3;
    }

    .control-btn {
        background: transparent;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: var(--radius-sm);
        color: var(--text-secondary);
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: color 0.2s ease;
        z-index: 2;
        position: relative;
        font-family: var(--font-sans);
        letter-spacing: 0.02em;
    }

    .control-btn:hover {
        color: var(--text-primary);
    }

    .control-btn.active {
        color: var(--bg-surface);
    }

    /* HORIZONTAL DOTS TRACK */
    .slider-dots {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 4px;
        margin: 1rem auto 0 auto;
        width: fit-content;
    }

    .slider-dot-wrap {
        background: none;
        border: none;
        padding: 6px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        outline: none;
        transition: transform 0.2s ease;
    }

    .slider-dot-wrap:hover {
        transform: scale(1.25);
    }

    .slider-dot-pill {
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: var(--text-primary);
        opacity: 0.35;
        transition:
            width 0.35s cubic-bezier(0.22, 1, 0.36, 1),
            height 0.2s ease,
            border-radius 0.2s ease,
            opacity 0.25s ease,
            background-color 0.25s ease;
    }

    .slider-dot-wrap.active .slider-dot-pill {
        width: 20px;
        opacity: 0.85;
        background: var(--project-category-hover-color, var(--accent-secondary, #42bd49));
    }

    .slider-dot-wrap.active:hover .slider-dot-pill {
        height: 9px;
        border-radius: 4.5px;
    }

    @media (max-width: 1024px) {
        /* The frame is what sizes the active slide (the display fills it), so
           widen the frame rather than shrinking the display inside it.
           82% covers phones and tablets; there is no separate ≤768 width. */
        .image-slider[data-variant="carousel"] .slider-frame,
        .image-slider[data-variant="carousel"][data-frame="adaptive"] .slider-frame {
            width: 82%;
        }

        .image-slider[data-variant="carousel"] .slider-display,
        .image-slider[data-variant="carousel"][data-frame="adaptive"] .slider-display {
            width: 100%;
        }

        /* The citation overlay covers too much of an already-small slide */
        .slide-title {
            display: none;
        }
    }

    @media (max-width: 768px) {
        .slider-controls {
            margin-left: 0;
            justify-content: flex-start;
        }

        .image-slider[data-variant="carousel"] .slide {
            padding: 0 4px !important;
        }

        /* Less shrink on the neighbours so the peek reads as a slide edge
           rather than a floating sliver */
        .image-slider[data-variant="carousel"] .slide.prev,
        .image-slider[data-variant="carousel"] .slide.next {
            transform: scale(0.94);
            opacity: 0.3;
        }
    }
</style>

<script define:vars={{ sliderId, autoplay, interval, initialIndex }}>
    const initSlider = () => {
        const slider = document.getElementById(sliderId);
        if (!slider) return;

        const display = slider.querySelector(".slider-display");
        const frame = slider.querySelector(".slider-frame");
        const track = slider.querySelector(".slider-track");
        const controls = slider.querySelector(".slider-controls");
        const buttons = slider.querySelectorAll(".control-btn");
        const pill = slider.querySelector(".active-pill");
        const dotContainer = slider.querySelector(".slider-dots");

        const originalSlides = Array.from(track.children);
        const totalSlides = originalSlides.length;
        if (totalSlides <= 1) return;

        // --- RESERVED FRAME HEIGHT (frameStrategy="adaptive") ---
        // .slider-frame's height should be sized to the TALLEST slide in the whole
        // set, fixed once, so indicators/controls after it never shift as the user
        // navigates between differently-shaped slides. Only ever grows as each
        // (possibly lazy-loaded) slide's real dimensions become known.
        const considerReservedRatio = (mediaEl) => {
            if (!frame) return;
            const measure = () => {
                const w = mediaEl.tagName === "VIDEO" ? mediaEl.videoWidth : mediaEl.naturalWidth;
                const h = mediaEl.tagName === "VIDEO" ? mediaEl.videoHeight : mediaEl.naturalHeight;
                if (!w || !h) return;
                const ratio = Math.min(1.9, Math.max(0.62, w / h));
                const current = parseFloat(frame.style.getPropertyValue("--reserved-ratio"));
                if (!current || ratio < current) {
                    frame.style.setProperty("--reserved-ratio", ratio.toFixed(4));
                }
            };
            if (mediaEl.tagName === "VIDEO") {
                if (mediaEl.videoWidth) measure();
                else mediaEl.addEventListener("loadedmetadata", measure, { once: true });
            } else {
                if (mediaEl.complete && mediaEl.naturalWidth) measure();
                else mediaEl.addEventListener("load", measure, { once: true });
            }
        };
        originalSlides.forEach((slideEl) => {
            const media = slideEl.querySelector(".optimized-slide-image");
            if (media) considerReservedRatio(media);
        });

        // --- PREVENT DUPLICATE CLONING ---
        // Since initSlider can run multiple times due to view transitions, check if clones already exist.
        if (track.querySelector(".clone")) {
            return;
        }

        // --- INFINITE LOOP TRIPLE-SET CLONING SETUP ---
        const leftClones = originalSlides.map(s => {
            const clone = s.cloneNode(true);
            clone.classList.add("clone");
            return clone;
        });
        const rightClones = originalSlides.map(s => {
            const clone = s.cloneNode(true);
            clone.classList.add("clone");
            return clone;
        });

        // Append right clones
        rightClones.forEach(clone => track.appendChild(clone));

        // Prepend left clones
        const firstOriginal = originalSlides[0];
        leftClones.forEach(clone => track.insertBefore(clone, firstOriginal));

        let isDragging = false;
        let dragStarted = false;
        let startX = 0;
        let currentHoverButton = null;
        let autoplayTimer = null;
        let activeIndex = initialIndex + totalSlides;

        const movePillTo = (targetBtn) => {
            if (!targetBtn || !pill) return;

            const offsetLeft = targetBtn.offsetLeft;
            const width = targetBtn.offsetWidth;

            pill.style.width = `${width}px`;
            pill.style.transform = `translateX(${offsetLeft - 4}px)`;
            pill.style.opacity = "1";
        };

        const updateSlideActiveClasses = (targetIndex) => {
            const allSlides = track.children;
            Array.from(allSlides).forEach((s, idx) => {
                s.classList.remove("active", "prev", "next", "far-prev", "far-next");
                if (idx === targetIndex) {
                    s.classList.add("active");
                } else if (idx === targetIndex - 1) {
                    s.classList.add("prev");
                } else if (idx === targetIndex + 1) {
                    s.classList.add("next");
                } else if (idx < targetIndex - 1) {
                    s.classList.add("far-prev");
                } else {
                    s.classList.add("far-next");
                }
            });
        };

        const updateDisplayOrientation = (targetIndex) => {
            if (!display || !track) return;
            const currentSlide = track.children[targetIndex];
            if (!currentSlide) return;

            const media = currentSlide.querySelector("img, video");
            if (!media) return;

            const applyOrientation = () => {
                let isPortrait = false;
                let ratio = 16 / 9;
                if (media.tagName === "VIDEO") {
                    const v = media;
                    if (v.videoWidth && v.videoHeight) {
                        isPortrait = v.videoWidth < v.videoHeight;
                        ratio = v.videoWidth / v.videoHeight;
                    }
                } else if (media.tagName === "IMG") {
                    const img = media;
                    if (img.naturalWidth && img.naturalHeight) {
                        isPortrait = img.naturalWidth < img.naturalHeight;
                        ratio = img.naturalWidth / img.naturalHeight;
                    }
                }
                display.setAttribute("data-active-orientation", isPortrait ? "portrait" : "landscape");
                // Clamp so an extreme panorama or extreme portrait can't blow out the layout
                const clampedRatio = Math.min(1.9, Math.max(0.62, ratio));
                display.style.setProperty("--active-ratio", clampedRatio.toFixed(4));
            };

            applyOrientation();
            media.addEventListener("load", applyOrientation, { once: true });
            media.addEventListener("loadedmetadata", applyOrientation, { once: true });
        };

        const switchToSlideByIndex = (targetIndex, animate = true) => {
            activeIndex = targetIndex;

            if (!animate) {
                track.style.transition = 'none';
            } else {
                track.style.removeProperty('transition');
            }

            // Update classes & orientation state
            updateSlideActiveClasses(targetIndex);
            updateDisplayOrientation(targetIndex);

            // Calculate active index relative to original slides (0 to totalSlides - 1)
            let realIndex = (targetIndex - totalSlides) % totalSlides;
            if (realIndex < 0) {
                realIndex += totalSlides;
            }

            // Update Buttons if controls are visible
            if (buttons && buttons.length > 0 && buttons[realIndex]) {
                buttons.forEach((b) => b.classList.remove("active"));
                buttons[realIndex].classList.add("active");
                movePillTo(buttons[realIndex]);
            }

            // Update Dots if dots indicator is visible
            const dotButtons = slider.querySelectorAll(".slider-dot-wrap");
            if (dotButtons && dotButtons.length > 0) {
                dotButtons.forEach((d) => d.classList.remove("active"));
                if (dotButtons[realIndex]) {
                    dotButtons[realIndex].classList.add("active");
                }
            }

            // Update Container State (Color)
            if (controls)
                controls.setAttribute("data-active-index", realIndex);

            // Sliding Animation
            const percentage = targetIndex * 100;
            track.style.transform = `translateX(-${percentage}%)`;

            if (!animate) {
                // Force layout reflow
                track.offsetHeight;
                track.style.removeProperty('transition');
            }
        };

        const switchToSlide = (targetBtn) => {
            if (!targetBtn) return;
            const targetIndex = parseInt(targetBtn.getAttribute("data-target")) + totalSlides;
            switchToSlideByIndex(targetIndex);
        };

        // Transition End listener for silent snaps back to middle set (infinite loop wrap)
        track.addEventListener("transitionend", () => {
            if (activeIndex < totalSlides || activeIndex >= 2 * totalSlides) {
                let snappedIndex = (activeIndex % totalSlides);
                if (snappedIndex < 0) snappedIndex += totalSlides;
                snappedIndex += totalSlides;
                switchToSlideByIndex(snappedIndex, false);
            }
        });

        // Autoplay Logic
        const startAutoplay = () => {
            if (!autoplay) return;
            stopAutoplay();
            autoplayTimer = setInterval(() => {
                const nextIndex = activeIndex + 1;
                switchToSlideByIndex(nextIndex);
            }, interval);
        };

        const stopAutoplay = () => {
            if (autoplayTimer) {
                clearInterval(autoplayTimer);
                autoplayTimer = null;
            }
        };

        // Initialize active slides at middle set
        switchToSlideByIndex(initialIndex + totalSlides, false);

        setTimeout(() => {
            const activeBtn = slider.querySelector(`.control-btn[data-target="${initialIndex}"]`) || slider.querySelector(".control-btn.active");
            if (activeBtn) {
                movePillTo(activeBtn);
                if (controls) controls.setAttribute("data-active-index", initialIndex);
            }
            if (autoplay) {
                startAutoplay();
            }
        }, 50);

        // --- BUTTONS DRAG INTERACTION (Segmented thumb dragging) ---
        const handleStart = (e) => {
            stopAutoplay(); // Stop auto-sliding on manual interaction
            startX = e.clientX;
            isDragging = true;
            dragStarted = false;
            controls.setPointerCapture(e.pointerId);
        };

        const handleMove = (e) => {
            if (!isDragging) return;
            dragStarted = true;

            // Find which button we're hovering over
            const hoveredBtn = Array.from(buttons).find((btn) => {
                const rect = btn.getBoundingClientRect();
                return e.clientX >= rect.left && e.clientX <= rect.right;
            });

            if (hoveredBtn !== currentHoverButton) {
                currentHoverButton = hoveredBtn;
                if (hoveredBtn) {
                    movePillTo(hoveredBtn);
                }
            }
            
            buttons.forEach((btn) => {
                if (btn.classList.contains('active') || btn === currentHoverButton) {
                    btn.style.color = 'var(--bg-surface)'; // White text
                } else {
                    btn.style.color = ''; // Reset to default
                }
            });
        };

        const handleEnd = (e) => {
            if (!isDragging) return;
            isDragging = false;
            
            controls.releasePointerCapture(e.pointerId);

            if (dragStarted && currentHoverButton) {
                switchToSlide(currentHoverButton);
            } else if (!dragStarted) {
                const target = e.target.closest('.control-btn');
                if (target) {
                    switchToSlide(target);
                }
            }

            buttons.forEach((btn) => {
                btn.style.color = '';
            });
            
            dragStarted = false;
            currentHoverButton = null;
        };

        if (controls) {
            controls.addEventListener("pointerdown", handleStart);
            controls.addEventListener("pointermove", handleMove);
            controls.addEventListener("pointerup", handleEnd);
            controls.addEventListener("pointercancel", handleEnd);
        }

        // --- LIGHTBOX (tap the active slide to enlarge it) ---
        const lightbox = slider.querySelector(".slider-lightbox");
        const lightboxImg = slider.querySelector(".slider-lightbox-img");
        const lightboxClose = slider.querySelector(".slider-lightbox-close");

        // Pin the overlay to the project section's column (leaving the sidebar
        // visible) and size the image to that column's content box, so it lines
        // up with the case study's own full-width images.
        const sizeToSection = () => {
            const section = slider.closest(".right-content");
            if (!lightbox) return;

            if (!section) {
                lightbox.style.removeProperty("left");
                lightbox.style.removeProperty("width");
                lightbox.style.setProperty("--lightbox-width", "80vw");
                return;
            }

            const rect = section.getBoundingClientRect();
            const cs = getComputedStyle(section);
            const padX =
                parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight);

            lightbox.style.left = `${Math.round(rect.left)}px`;
            lightbox.style.width = `${Math.round(rect.width)}px`;
            lightbox.style.setProperty(
                "--lightbox-width",
                `${Math.round(rect.width - padX)}px`,
            );
        };

        const openLightbox = (imgEl) => {
            if (!lightbox || !lightboxImg || !imgEl) return;

            sizeToSection();

            lightboxImg.src = imgEl.currentSrc || imgEl.src;
            lightboxImg.alt = imgEl.alt || "";
            lightbox.setAttribute("data-open", "true");
            lightbox.setAttribute("aria-hidden", "false");
            stopAutoplay();
            // Lenis drives scrolling on project pages; body overflow alone
            // would not hold it still behind the overlay.
            if (window.lenis && window.lenis.stop) window.lenis.stop();
        };

        const closeLightbox = () => {
            if (!lightbox || lightbox.getAttribute("data-open") !== "true")
                return;
            lightbox.setAttribute("data-open", "false");
            lightbox.setAttribute("aria-hidden", "true");
            lightboxImg.src = "";
            if (window.lenis && window.lenis.start) window.lenis.start();
        };

        if (lightbox) {
            lightbox.addEventListener("click", closeLightbox);
            // Clicks on the image itself shouldn't dismiss it
            lightboxImg.addEventListener("click", (e) => e.stopPropagation());
            lightboxClose.addEventListener("click", closeLightbox);
            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape") closeLightbox();
            });
            window.addEventListener("resize", () => {
                if (lightbox.getAttribute("data-open") === "true") {
                    sizeToSection();
                }
            });
        }

        // --- DISPLAY DRAG INTERACTION (Swipe & Drag slides directly) ---
        let isDisplayDragging = false;
        let displayStartX = 0;
        let displayCurrentTranslate = 0;
        let displayPrevTranslate = 0;
        let startTargetSlide = null;

        const handleDisplayStart = (e) => {
            // Let clicks/selection on a slide's title text through instead
            // of hijacking them into a swipe-drag (which calls
            // preventDefault() below and would otherwise block selection).
            if (e.target.closest(".slide-title")) return;

            // Capture which slide was clicked before pointer capture redirects target
            startTargetSlide = e.target.closest(".slide");

            stopAutoplay();

            // Silently snap back to the middle set if currently positioned on a clone before starting drag
            if (activeIndex < totalSlides || activeIndex >= 2 * totalSlides) {
                let snappedIndex = (activeIndex % totalSlides);
                if (snappedIndex < 0) snappedIndex += totalSlides;
                snappedIndex += totalSlides;
                switchToSlideByIndex(snappedIndex, false);
            }

            isDisplayDragging = true;
            displayStartX = e.clientX;
            displayPrevTranslate = activeIndex * -100;
            displayCurrentTranslate = displayPrevTranslate;
            
            // Disable transition for real-time drag response
            track.style.transition = 'none';

            display.setPointerCapture(e.pointerId);
            e.preventDefault();
        };

        const handleDisplayMove = (e) => {
            if (!isDisplayDragging) return;
            
            const deltaX = e.clientX - displayStartX;
            const displayWidth = display.offsetWidth;
            const percentageOffset = (deltaX / displayWidth) * 100;
            
            let translation = displayPrevTranslate + percentageOffset;
            
            // Clamp within the full 3-set bounds
            const minBound = 0;
            const maxBound = (3 * totalSlides - 1) * -100;
            if (translation > minBound) {
                translation = minBound + (translation - minBound) * 0.35;
            } else if (translation < maxBound) {
                translation = maxBound + (translation - maxBound) * 0.35;
            }

            displayCurrentTranslate = translation;
            track.style.transform = `translateX(${displayCurrentTranslate}%)`;

            // DYNAMIC OPACITY & SCALING UPDATE WHILE DRAGGING
            let closestIndex = Math.round(-translation / 100);
            closestIndex = Math.max(0, Math.min(3 * totalSlides - 1, closestIndex));
            updateSlideActiveClasses(closestIndex);
        };

        const handleDisplayEnd = (e) => {
            if (!isDisplayDragging) return;
            isDisplayDragging = false;
            
            try {
                display.releasePointerCapture(e.pointerId);
            } catch (err) {}
            
            // Restore transition style
            track.style.removeProperty('transition');
            
            const deltaX = e.clientX - displayStartX;
            const percentageDifference = displayCurrentTranslate - displayPrevTranslate;
            const threshold = 15;
            let targetIndex = activeIndex;
            
            if (percentageDifference < -threshold) {
                targetIndex = activeIndex + 1;
            } else if (percentageDifference > threshold) {
                targetIndex = activeIndex - 1;
            } else if (Math.abs(deltaX) < 10) {
                // Was a click/tap (drag distance < 10px)
                if (startTargetSlide) {
                    if (startTargetSlide.classList.contains("prev")) {
                        targetIndex = activeIndex - 1;
                    } else if (startTargetSlide.classList.contains("next")) {
                        targetIndex = activeIndex + 1;
                    } else if (startTargetSlide.classList.contains("active")) {
                        // Tap on the slide already in focus: enlarge it.
                        // Videos keep their in-place playback.
                        const img = startTargetSlide.querySelector(
                            "img.optimized-slide-image",
                        );
                        if (img) openLightbox(img);
                    }
                }
            }
            
            switchToSlideByIndex(targetIndex);
            startTargetSlide = null;
        };

        if (display) {
            display.addEventListener("pointerdown", handleDisplayStart);
            display.addEventListener("pointermove", handleDisplayMove);
            display.addEventListener("pointerup", handleDisplayEnd);
            display.addEventListener("pointercancel", handleDisplayEnd);
        }

        // Handle prev/next arrow clicks
        const arrowPrev = slider.querySelector(".slider-arrow-prev");
        const arrowNext = slider.querySelector(".slider-arrow-next");
        if (arrowPrev) {
            arrowPrev.addEventListener("click", () => {
                stopAutoplay();
                switchToSlideByIndex(activeIndex - 1);
            });
        }
        if (arrowNext) {
            arrowNext.addEventListener("click", () => {
                stopAutoplay();
                switchToSlideByIndex(activeIndex + 1);
            });
        }

        // Handle dot clicks
        if (dotContainer) {
            dotContainer.addEventListener("click", (e) => {
                stopAutoplay();
                const target = e.target.closest('.slider-dot-wrap');
                if (target) {
                    const targetIndex = parseInt(target.getAttribute("data-target")) + totalSlides;
                    switchToSlideByIndex(targetIndex);
                }
            });
        }

        // Re-measure the segmented-control pill on resize. This also covers
        // sliders mounted while their container was display:none (e.g. an
        // inactive tab panel), where the initial measurement is 0.
        window.addEventListener("resize", () => {
            const activeBtn = slider.querySelector(".control-btn.active");
            if (activeBtn) movePillTo(activeBtn);
        });
    };

    // Run immediately if DOM is ready, otherwise wait
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initSlider);
    } else {
        initSlider();
    }

    // Also re-run on Astro page load if View Transitions are used
    document.addEventListener("astro:page-load", initSlider);
</script>
