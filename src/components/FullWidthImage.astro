---
import PlaceholderImage from "./PlaceholderImage.astro";
import { Image } from "astro:assets";

interface Props {
    src?: string;
    alt?: string;
    caption?: string;
    height?: string;
    loading?: "eager" | "lazy";
    fetchPriority?: "high" | "low" | "auto";
    sizes?: string;
    constrain?: boolean;
    fullBleedMobile?: boolean;
    marginTop?: string;
    scale?: number;
    objectFit?: "contain" | "cover";
    background?: string;
    padding?: string;
    overflow?: "hidden" | "visible";
    lockHeight?: boolean;
    borderRadius?: string;
    class?: string;
    isHero?: boolean;
    viewTransitionName?: string;
}
const {
    src,
    alt = "",
    caption,
    height = "auto",
    loading = "lazy",
    fetchPriority = "auto",
    sizes = "(min-width: 1200px) 750px, (min-width: 768px) 85vw, 100vw",
    constrain = true,
    fullBleedMobile = false,
    marginTop,
    scale = 1,
    objectFit = "contain",
    background,
    padding,
    overflow = "hidden",
    lockHeight = false,
    borderRadius,
    class: className,
    isHero = false,
    viewTransitionName,
} = Astro.props;

const resolvedFetchPriority =
    loading === "eager" && fetchPriority === "auto"
        ? "high"
        : fetchPriority;

const resolvedMinHeight = height && height !== "auto" ? height : (constrain ? "420px" : "500px");
const activeTransitionName = viewTransitionName || (isHero ? "project-hero-active" : undefined);
---

<figure
    class:list={[
        "full-width-image",
        { constrained: constrain, "full-bleed-mobile": fullBleedMobile, "case-study-hero-figure": isHero },
        className,
    ]}
    data-hero-image={isHero || viewTransitionName ? "true" : undefined}
    style={marginTop ? { marginTop } : {}}
>
    {
        src ? (
            <div
                class="image-wrapper"
                style={{
                    ...(lockHeight && height !== "auto" ? { height } : {}),
                    ...(background ? { background } : {}),
                    ...(padding ? { padding } : {}),
                    ...(borderRadius !== undefined ? { borderRadius } : {}),
                    overflow,
                }}
            >
                <div class="media-loading-placeholder" aria-hidden="true">
                    <div class="spinner-progress-wrap">
                        <svg class="spinner-svg" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle class="spinner-track" cx="22" cy="22" r="18" stroke="currentColor" stroke-width="3" opacity="0.2" />
                            <circle class="spinner-bar" cx="22" cy="22" r="18" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                        </svg>
                        <span class="progress-val">12%</span>
                    </div>
                    <div class="placeholder-text-group">
                        <h4 class="uhoh-heading">uh-oh</h4>
                        <p class="apology-line">sorry for the inconvenience,</p>
                        <p class="fun-line">this was supposed to load by now...</p>
                    </div>
                </div>
                {typeof src === "string" && src.endsWith(".gif") ? (
                    <img
                        src={src}
                        alt={alt}
                        class="optimized-image"
                        loading={loading}
                        decoding="async"
                        onload="const w = this.closest('.image-wrapper'); if(w){ w.classList.add('is-loaded'); const v = w.querySelector('.progress-val'); if(v) v.textContent='100%'; }"
                        style={{
                            transform: `scale(${scale})`,
                            objectFit: objectFit,
                            height:
                                lockHeight && height !== "auto" ? "100%" : "auto",
                            ...(borderRadius !== undefined ? { borderRadius } : {}),
                            ...(activeTransitionName ? { viewTransitionName: activeTransitionName } : {}),
                        }}
                    />
                ) : (
                    <Image
                        src={src}
                        alt={alt}
                        width={1920}
                        height={1080}
                        class="optimized-image"
                        loading={loading}
                        decoding="async"
                        fetchpriority={resolvedFetchPriority}
                        sizes={sizes}
                        onload="const w = this.closest('.image-wrapper'); if(w){ w.classList.add('is-loaded'); const v = w.querySelector('.progress-val'); if(v) v.textContent='100%'; }"
                        style={{
                            transform: `scale(${scale})`,
                            objectFit: objectFit,
                            height:
                                lockHeight && height !== "auto" ? "100%" : "auto",
                            ...(borderRadius !== undefined ? { borderRadius } : {}),
                            ...(activeTransitionName ? { viewTransitionName: activeTransitionName } : {}),
                        }}
                    />
                )}
            </div>
        ) : (
            <div class="placeholder-wrapper">
                <PlaceholderImage height="100%" caption={caption} />
            </div>
        )
    }
    {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
    function setupImageProgressSimulators() {
        document.querySelectorAll(".image-wrapper:not(.is-loaded):not([data-progress-init])").forEach((wrapper) => {
            wrapper.setAttribute("data-progress-init", "true");
            const bar = wrapper.querySelector(".spinner-bar") as SVGCircleElement | null;
            const val = wrapper.querySelector(".progress-val") as HTMLElement | null;
            const img = wrapper.querySelector("img") as HTMLImageElement | null;

            if (img && img.complete && img.naturalHeight !== 0) {
                wrapper.classList.add("is-loaded");
                if (val) val.textContent = "100%";
                return;
            }

            if (!bar || !val) return;

            let progress = Math.floor(Math.random() * 8) + 12;
            const circumference = 2 * Math.PI * 18;
            val.textContent = `${progress}%`;
            bar.style.strokeDasharray = `${circumference}`;
            bar.style.strokeDashoffset = `${circumference * (1 - progress / 100)}`;

            const interval = setInterval(() => {
                if (wrapper.classList.contains("is-loaded")) {
                    val.textContent = "100%";
                    bar.style.strokeDashoffset = "0";
                    clearInterval(interval);
                    return;
                }
                if (progress < 94) {
                    progress += Math.floor(Math.random() * 8) + 3;
                    if (progress > 94) progress = 94;
                    val.textContent = `${progress}%`;
                    bar.style.strokeDashoffset = `${circumference * (1 - progress / 100)}`;
                }
            }, 160);
        });
    }

    setupImageProgressSimulators();
    document.addEventListener("astro:page-load", setupImageProgressSimulators);
</script>

<style>
    .full-width-image {
        width: 100%;
        margin-top: 4rem;
        margin-bottom: 4rem;
        /* Default: transparent */
    }

    .full-width-image.constrained {
        /* Constrain to 750px body width */
        max-width: min(750px, 100%);
        margin-left: auto;
        margin-right: auto;
        box-sizing: border-box;
    }

    .full-width-image.left-align,
    .full-width-image.constrained.left-align {
        margin-left: 0 !important;
        margin-right: auto !important;
    }

    .image-wrapper {
        width: 100%;
        position: relative;
        overflow: hidden;
        border-radius: var(--radius-md);
        display: block;
        background: transparent;
        transition: border-color 0.3s ease;
    }

    .image-wrapper:not(.is-loaded) {
        min-height: 240px;
        background: var(--bg-surface, rgba(255, 255, 255, 0.03));
        border: 1px dashed var(--border-subtle, rgba(255, 255, 255, 0.15));
    }

    .image-wrapper.is-loaded {
        min-height: 0 !important;
        height: auto !important;
        display: block !important;
        border-color: transparent !important;
        background: transparent !important;
    }

    :global(html[data-theme="light"]) .image-wrapper:not(.is-loaded) {
        background: rgba(0, 0, 0, 0.02);
        border-color: rgba(0, 0, 0, 0.12);
    }

    :global(html[data-theme="light"]) .image-wrapper.is-loaded {
        border-color: transparent !important;
        background: transparent !important;
    }

    .media-loading-placeholder {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: flex-start;
        padding: 20px;
        box-sizing: border-box;
        text-align: left;
        z-index: 1;
        opacity: 1;
        transition: opacity 0.35s ease;
        pointer-events: none;
    }

    .image-wrapper.is-loaded .media-loading-placeholder {
        opacity: 0;
    }

    .spinner-progress-wrap {
        position: relative;
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #22c55e;
    }

    .spinner-svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        transform: rotate(-90deg);
    }

    .spinner-track {
        color: #22c55e;
        opacity: 0.18;
    }

    .spinner-bar {
        color: #22c55e;
        transition: stroke-dashoffset 0.25s ease;
    }

    .progress-val {
        font-family: var(--font-sans, "Google Sans", sans-serif);
        font-size: 13px;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--text-primary);
    }

    .placeholder-text-group {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        gap: 2px;
    }

    .uhoh-heading {
        font-family: var(--font-sans, "Google Sans", sans-serif);
        font-size: 18px;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--text-primary);
        margin: 0 0 4px 0;
        line-height: 1.1;
    }

    .apology-line,
    .fun-line {
        font-family: var(--font-sans, "Google Sans", sans-serif);
        font-size: 13px;
        font-weight: 400;
        color: var(--text-secondary, rgba(255, 255, 255, 0.7));
        margin: 0;
        line-height: 1.35;
        letter-spacing: -0.01em;
    }

    :global(html[data-theme="light"]) .apology-line,
    :global(html[data-theme="light"]) .fun-line {
        color: rgba(0, 0, 0, 0.65);
    }

    .full-width-image .optimized-image {
        width: 100%;
        height: auto;
        display: block !important;
        vertical-align: bottom !important;
        position: relative;
        z-index: 2;
        /* Parent .image-wrapper with overflow:hidden clips corners cleanly */
        border-radius: 0;
        margin: 0 !important;
        transition: transform 0.3s ease, opacity 0.3s ease;
    }

    /* EXPERIMENTAL: Mobile-only full bleed rule. Does not affect desktop web view. */
    @media (max-width: 768px) {
        .full-width-image.full-bleed-mobile .image-wrapper,
        .full-width-image.full-bleed-mobile .optimized-image {
            border-radius: 0 !important;
            border: none !important;
            box-shadow: none !important;
            outline: none !important;
        }
    }
    .placeholder-wrapper {
        width: 100%;
        height: 100%;
    }
    /* Ensure placeholder component fills the wrapper */
    .placeholder-wrapper :global(.placeholder-container),
    .placeholder-wrapper :global(.placeholder-box) {
        height: 100% !important;
    }
    figcaption {
        text-align: center;
        font-size: 12px;
        color: var(--text-tertiary);
        margin-top: 0.5rem;
    }
</style>
