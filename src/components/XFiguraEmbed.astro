---
// XFiguraEmbed.astro
interface Props {
    height?: string;
    aspectRatio?: string;
}

const {
    height = "750px",
    aspectRatio = "16/9"
} = Astro.props;
---

<div class="xfigura-container">
    <div
        class="xfigura-wrapper"
        style={`height: ${height};`}
    >
        <iframe
            src="/xfigura/index.html?embed=true"
            title="xFigura Interactive Prototype"
            loading="lazy"
            sandbox="allow-scripts allow-same-origin"
            allow="clipboard-write"
        ></iframe>
    </div>
</div>

<style>
    .xfigura-container {
        width: 100% !important;
        max-width: 100% !important;
        padding-inline: 0 !important;
        margin-top: 3rem;
        margin-bottom: 3rem;
        box-sizing: border-box;
        background: #09090b;
        border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.12));
        border-radius: var(--radius-md, 12px);
        overflow: hidden;
    }

    .xfigura-wrapper {
        position: relative;
        width: 100%;
        overflow: hidden;
    }

    iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: none;
        display: block;
        background: transparent;
        pointer-events: auto; /* Always interactive */
    }

    @media (max-width: 768px) {
        .xfigura-container {
            margin-top: 2rem;
            margin-bottom: 2rem;
        }
        .xfigura-wrapper {
            height: auto !important;
            aspect-ratio: 9 / 16; /* Portrait on mobile */
        }
    }
</style>
