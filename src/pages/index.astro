---
import Layout from "../layouts/Layout.astro";
import GhostRunner from "../components/GhostRunner.astro";
import BentoGrid from "../components/BentoGrid.astro";
import BentoCard from "../components/BentoCard.astro";
import HomeProjectCard from "../components/HomeProjectCard.astro";
import SidebarNavigation from "../components/SidebarNavigation.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Footer from "../components/Footer.astro";
import WorksFilter from "../components/WorksFilter.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Import hero images for optimization
import dotThreadsHero from "../assets/projects/dot-threads/hero-dothreads.gif";
import deturHero from "../assets/projects/detur/hero-detur.png";
import pikoHero from "../assets/projects/piko/hero-piko.gif";
import sanctuaryHero from "../assets/projects/santuary/hero-santuary.png";
import tirupatiHero from "../assets/projects/tirupati/hero-tirupati.gif";
import pointoHero from "../assets/projects/pointo/cover.gif";
import serendipityHero from "../assets/projects/serendipity/hero-serendipidity.png";
import musibuddyHero from "../assets/projects/musibuddy/hero-musibuddy.gif";

// Fetch all projects
const allProjects = (await getCollection("projects"))
	.filter((project) =>
		[
			"detour",
			"tirupati-campus",
			"skywalk-sanctuary",
			"dot-threads",
			"pointo",
			"serendipidity",
			"piko",
			"musibuddy",
		].includes(project.slug),
	)
	.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const heroImages: Record<string, ImageMetadata> = {
	"dot-threads": dotThreadsHero,
	detour: deturHero,
	piko: pikoHero,
	"skywalk-sanctuary": sanctuaryHero,
	"tirupati-campus": tirupatiHero,
	pointo: pointoHero,
	serendipidity: serendipityHero,
	musibuddy: musibuddyHero,
};

// Convenience references by slug for manual column layout
const dotThreadsProject = allProjects.find(
	(project) => project.slug === "dot-threads",
);
const sanctuaryProject = allProjects.find(
	(project) => project.slug === "skywalk-sanctuary",
);
const detourProject = allProjects.find((project) => project.slug === "detour");
const tirupatiProject = allProjects.find(
	(project) => project.slug === "tirupati-campus",
);
const pikoProject = allProjects.find((project) => project.slug === "piko");
const pointoProject = allProjects.find((project) => project.slug === "pointo");
const serendipityProject = allProjects.find(
	(project) => project.slug === "serendipidity",
);
const musibuddyProject = allProjects.find(
	(project) => project.slug === "musibuddy",
);
---

<Layout
	title="Narayan Ashanahalli"
	description="Hi! I’m a graduate student at CMU HCI & SoA. I work at the intersection of sensing, computing, and IxD to create playful, intentional experiences between human -human and human - AI interactions"
	fullWidth={true}
>
	<!-- Fixed Nav: Top Left -->
	<div class="fixed-nav-top-left">
		<div class="nav-wrapper-mobile">
			<SidebarNavigation isHome={true} />
		</div>
	</div>

	<div class="toggle-floater">
		<div class="sidebar-controls">
			<ThemeToggle />
		</div>
	</div>

	<div class="home-content">
		<!-- LAYER 1: HERO / INTRO -->
		<section class="hero" id="about">
			<div class="hero-container">
				<!-- Game moved to footer -->

				<div class="bio-content">
					<div class="hero-headline bio-short">
						<div class="bio-line-1">
							<span class="dynamic-color-text"
								>👋 I'm Narayan, an interaction designer</span
							>
						</div>
						<div class="bio-line-2">
							who builds my way through design <span
								class="bracket-hover-wrapper"
								><span class="bracket">[</span><span
									class="bracket-content"
									><span class="bracket-inner"
										>from idea to artifact</span
									></span
								><span class="bracket">]</span></span
							> across interfaces, tools, and hardware.
						</div>
					</div>
					<div class="hero-headline bio-long">
						<div class="bio-text">
							<span class="dynamic-color-text"
								>👋 I'm Narayan, an interaction designer</span
							> who builds my way through design <span
								class="bracket-hover-wrapper"
								><span class="bracket">[</span><span
									class="bracket-content"
									><span class="bracket-inner"
										>from idea to artifact</span
									></span
								><span class="bracket">]</span></span
							> across interfaces, tools, and hardware. With a foundation
							in architecture, I apply systems thinking and rapid prototyping
							to create digital products that feel responsive and grounded
							in existing ecosystems.
							<br /><br />
							🎯 The question I keep coming back to: how do we make
							technology feel present in the physical world rather than
							extracting people into screens? I care about interactions
							that feel natural, where the interface fades and people
							focus on what they're actually doing.
							<br /><br />
							🔧 I'm currently working as a Design Researcher at Lab
							4 Cybernetics with <a
								href="https://pangaro.com/"
								target="_blank"
								rel="noopener noreferrer">Paul Pangaro</a
							>, building the lab's digital infrastructure: <a
								href="https://lab4cybernetics.vercel.app"
								target="_blank"
								rel="noopener noreferrer">the website</a
							>, a practitioner-scholar <a
								href="https://l4cybernetics.vercel.app/matching"
								target="_blank"
								rel="noopener noreferrer">matching platform</a
							>, and a knowledge graph system organizing <a
								href="https://publish.obsidian.md/lab4c"
								target="_blank"
								rel="noopener noreferrer"
								>cybernetics concepts</a
							>.
							<br /><br />
							🤖 My thesis project, supported by the <a
								href="https://studioforcreativeinquiry.org/frff-grants-microgrants"
								target="_blank"
								rel="noopener noreferrer"
								>Frank-Ratchye Further Fund</a
							>, explores how physically embodied AI can provide
							spatial task assistance through laser-pointing,
							bridging LLM reasoning with physical spatial
							referencing.
							<br /><br />
							💡 I'm learning that the best design work happens in the
							infrastructure: building repositories, systems, and tools
							that let others create and scale. I want to build tools
							that feel like extensions of how people naturally think
							and interact, not systems they have to manage.
						</div>
					</div>
					<div class="emoji-display"></div>
				</div>

				<div class="hero-actions-row">
					<div class="hero-actions-left">
						<button
							id="read-more-btn"
							class="action-link read-more"
						>
							Read more
							<svg
								width="12"
								height="12"
								viewBox="0 0 12 12"
								fill="none"
								xmlns="http://www.w3.org/2000/svg"
								class="chevron"
							>
								<path
									d="M2.5 4.5L6 8L9.5 4.5"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</button>

						<div class="hero-actions">
							<a href="#footer" class="action-link">Contact ↙</a>

							<a
								href="https://substack.com/@narayanthinks"
								target="_blank"
								rel="noopener noreferrer"
								class="action-link">Blog ↗</a
							>

							<a
								href="https://drive.google.com/file/d/1PcdJ52A1hec-0XFzHHCelg89N1d4cDHw/view?usp=sharing"
								target="_blank"
								rel="noopener noreferrer"
								class="action-link">CV ↗</a
							>
						</div>
					</div>

					<div class="cmu-pill">
						<span class="cmu-pill-text">
							<span class="status-indicator"></span>
							Actively looking for full-time roles
						</span>
					</div>
				</div>
			</div>
			<div class="hero-divider"></div>
		</section>

		<!-- LAYER 2: WORKS -->
		<section id="works" class="layer-works">
			<div class="works-container">
				<h2 class="works-title">WORK</h2>
				<div class="works-header-sticky">
					<WorksFilter />
				</div>
				<div class="home-project-list">
					{
						pointoProject && (
							<div
								class="project-card-wrapper"
								data-categories="physical-ux"
							>
								<HomeProjectCard
									title={pointoProject.data.title}
									image={
										heroImages[pointoProject.slug] ||
										pointoProject.data.heroImage
									}
									loading="eager"
									fetchPriority="high"
									href={`/works/${pointoProject.slug}`}
									tags={pointoProject.data.tags}
									meta={pointoProject.data.meta}
									description={pointoProject.data.description}
									categories={["physical-ux"]}
								/>
							</div>
						)
					}
					{
						pikoProject && (
							<div
								class="project-card-wrapper"
								data-categories="physical-ux"
							>
								<HomeProjectCard
									title={pikoProject.data.title}
									image={
										heroImages[pikoProject.slug] ||
										pikoProject.data.heroImage
									}
									loading="eager"
									fetchPriority="high"
									href={`/works/${pikoProject.slug}`}
									tags={pikoProject.data.tags}
									meta={pikoProject.data.meta}
									description={pikoProject.data.description}
									categories={["physical-ux"]}
								/>
							</div>
						)
					}
					{
						dotThreadsProject && (
							<div
								class="project-card-wrapper"
								data-categories="web-ux"
							>
								<HomeProjectCard
									title={dotThreadsProject.data.title}
									image={
										heroImages[dotThreadsProject.slug] ||
										dotThreadsProject.data.heroImage
									}
									loading="lazy"
									href={`/works/${dotThreadsProject.slug}`}
									tags={dotThreadsProject.data.tags}
									meta={dotThreadsProject.data.meta}
									description={
										dotThreadsProject.data.description
									}
									categories={["web-ux"]}
								/>
							</div>
						)
					}
					{
						detourProject && (
							<div
								class="project-card-wrapper"
								data-categories="mobile-ux"
							>
								<HomeProjectCard
									title={detourProject.data.title}
									image={
										heroImages[detourProject.slug] ||
										detourProject.data.heroImage
									}
									loading="lazy"
									href={`/works/${detourProject.slug}`}
									tags={detourProject.data.tags}
									meta={detourProject.data.meta}
									description={detourProject.data.description}
									categories={["mobile-ux"]}
								/>
							</div>
						)
					}
					{
						tirupatiProject && (
							<div
								class="project-card-wrapper"
								data-categories="spatial-xd"
							>
								<HomeProjectCard
									title={tirupatiProject.data.title}
									image={
										heroImages[tirupatiProject.slug] ||
										tirupatiProject.data.heroImage
									}
									loading="lazy"
									href={`/works/${tirupatiProject.slug}`}
									tags={tirupatiProject.data.tags}
									meta={tirupatiProject.data.meta}
									description={
										tirupatiProject.data.description
									}
									categories={["spatial-xd"]}
								/>
							</div>
						)
					}
					{
						sanctuaryProject && (
							<div
								class="project-card-wrapper"
								data-categories="spatial-xd"
							>
								<HomeProjectCard
									title={sanctuaryProject.data.title}
									image={
										heroImages[sanctuaryProject.slug] ||
										sanctuaryProject.data.heroImage
									}
									loading="lazy"
									href={`/works/${sanctuaryProject.slug}`}
									tags={sanctuaryProject.data.tags}
									meta={sanctuaryProject.data.meta}
									description={
										sanctuaryProject.data.description
									}
									categories={["spatial-xd"]}
								/>
							</div>
						)
					}
					{
						serendipityProject && (
							<div
								class="project-card-wrapper"
								data-categories="mobile-ux"
							>
								<HomeProjectCard
									title={serendipityProject.data.title}
									image={
										heroImages[serendipityProject.slug] ||
										serendipityProject.data.heroImage
									}
									loading="lazy"
									href={`/works/${serendipityProject.slug}`}
									tags={serendipityProject.data.tags}
									meta={serendipityProject.data.meta}
									description={
										serendipityProject.data.description
									}
									categories={["mobile-ux"]}
								/>
							</div>
						)
					}
					{
						musibuddyProject && (
							<div
								class="project-card-wrapper"
								data-categories="physical-ux"
							>
								<HomeProjectCard
									title={musibuddyProject.data.title}
									image={
										heroImages[musibuddyProject.slug] ||
										musibuddyProject.data.heroImage
									}
									loading="lazy"
									href={`/works/${musibuddyProject.slug}`}
									tags={musibuddyProject.data.tags}
									meta={musibuddyProject.data.meta}
									description={
										musibuddyProject.data.description
									}
									fit="cover"
									scale={1.5}
									categories={["physical-ux"]}
								/>
							</div>
						)
					}
				</div>

				<!-- See More button: visible only when a filter is active and hides some projects -->
				<div
					id="see-more-wrap"
					class="see-more-wrap"
					aria-hidden="true"
				>
					<button
						id="see-more-btn"
						class="see-more-btn"
						type="button"
					>
						<span class="see-more-circle">
							<svg
								width="12"
								height="12"
								viewBox="0 0 12 12"
								fill="none"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									d="M6 2V10M6 10L3 7M6 10L9 7"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</span>
						<span class="see-more-label">See More</span>
					</button>
				</div>
			</div>
		</section>

		<Footer />
		<div class="game-bottom-wrapper">
			<GhostRunner />
		</div>
	</div>

	<!-- Project scroll dot indicator (fixed, viewport-centred) -->
	<nav
		id="project-scroll-nav"
		class="projects-nav"
		aria-label="Project navigation"
		aria-hidden="true"
	>
		<div class="projects-nav__track"></div>
	</nav>
</Layout>

<style>
	/* Fixed Nav Positions */
	.fixed-nav-top-left {
		position: fixed;
		top: 20px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 200;
		width: auto;
	}

	/* Desktop (3-col): fixed sidebar width */
	@media (min-width: 1200px) {
		.fixed-nav-top-left {
			width: auto;
		}
	}

	.fixed-nav-bottom-right {
		position: fixed;
		bottom: 128px;
		right: 128px;
		z-index: 100;
		width: auto; /* Allow it to shrink to content */
		display: flex; /* Ensure proper stacking if multiple items */
		justify-content: flex-end;
		transition: bottom 0.1s ease-out; /* Smooth collision movement */
	}

	.toggle-floater {
		position: fixed !important;
		bottom: 20px !important;
		right: 20px !important;
		top: auto !important;
		margin: 0 !important;
		padding: 0 !important;
		z-index: 100;
		width: auto;
		display: flex;
		justify-content: flex-end;
	}

	.sidebar-controls {
		display: flex;
		gap: 1rem;
		align-items: center;
	}

	/* Content Area */
	.home-content {
		padding: 272px var(--total-side-padding) 0 var(--total-side-padding); /* Dynamic side padding to keep middle width constant */
		max-width: 100%;
		margin: 0;
		width: 100%;
		position: relative;
		box-sizing: border-box;
	}

	.game-bottom-wrapper {
		position: relative;
		width: calc(100% + 2 * var(--total-side-padding));
		margin-left: calc(-1 * var(--total-side-padding));
		margin-top: 0px;
		margin-bottom: 0px;
		z-index: 0;
	}

	.game-bottom-wrapper :global(.ghost-game-container) {
		border-radius: 0;
		border: none;
		border-top: 1px solid var(--border-subtle);
		width: 100%;
	}

	/* Adjust Hero Container to accommodate absolute game */
	/* Since game is absolute, it doesn't take space. Bio will move up. */
	/* We need to push content down by the game height (160px + margin) */
	.hero-container {
		display: grid;
		grid-template-columns: 1fr; /* Mobile Default */
		gap: var(--space-md);
		width: 100%;
		padding-top: 0; /* Reset since game is gone */
		position: static;
	}

	/* Desktop: 3 Columns, Content starts at Col 1 (Span 2) */
	@media (min-width: 1200px) {
		.hero-container {
			grid-template-columns: 1fr 1fr 1fr;
		}

		/* Align all direct children to start at column 1 (Left Aligned Layout) */
		/* Game, Bio, Actions span first 2 columns */
		.hero-container > :global(*) {
			grid-column: 1 / 3;
		}

		.hero-container > .hero-actions-row {
			grid-column: 1 / -1;
		}
	}

	/* Tablet: 2 Columns */
	@media (min-width: 768px) and (max-width: 1199px) {
		.hero-container {
			grid-template-columns: 1fr 1fr;
		}

		/* In 2-col layout (Tablet), if Sidebar is right fixed... usually overlay or adjust */
		/* If flip keeps logic: Content in Col 1, Social/Sidebar in Col 2? */
		/* Original was: Content Col 2, Nav Col 1. */
		/* Flip: Content Col 1, Nav Col 2. */

		.hero-container > :global(*) {
			grid-column: 1 / 3;
		}
	}

	/* Bio Content */
	.bio-content {
		padding-top: 0;
		padding-inline: 0;
		grid-column: 1 / -1;
		max-width: 100%; /* Matches Game Width */
	}

	.cmu-pill {
		margin: 0;
	}

	.cmu-pill-text {
		font-family: "Geist", sans-serif;
		font-size: 12px;
		color: var(--text-secondary);
		letter-spacing: 0.01em;
		background: transparent;
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-md);
		padding: 6px 14px;
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.status-indicator {
		display: inline-block;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background-color: var(--accent-secondary);
		box-shadow: 0 0 8px var(--accent-secondary);
		position: relative;
	}

	.status-indicator::after {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		border-radius: 50%;
		background-color: var(--accent-secondary);
		animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
		z-index: -1;
	}

	@keyframes pulse-ring {
		0% {
			transform: scale(1);
			opacity: 0.8;
		}
		100% {
			transform: scale(2.5);
			opacity: 0;
		}
	}

	/* Bracket Hover Animation */
	.bracket-hover-wrapper {
		display: inline-flex;
		align-items: baseline;
		cursor: pointer;
		vertical-align: baseline;
		color: var(--text-secondary);
		transition: color 0.3s ease 0.15s;
	}

	.bracket-hover-wrapper.is-hovered {
		color: var(--text-primary);
		transition: color 0.3s ease 0s;
	}

	.bracket {
		display: inline-block;
		transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1) 0.15s;
	}

	.bracket-hover-wrapper.is-hovered .bracket {
		transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1) 0s;
	}

	.bracket-hover-wrapper.is-hovered .bracket:first-child {
		transform: translateX(-2px);
	}

	.bracket-hover-wrapper.is-hovered .bracket:last-child {
		transform: translateX(2px);
	}

	.bracket-content {
		display: inline-block;
		max-width: 0;
		overflow: hidden;
		white-space: nowrap;
		opacity: 0;
		transition:
			max-width 0.4s cubic-bezier(0.25, 1, 0.5, 1) 0.15s,
			opacity 0.25s ease-out 0.15s;
		will-change: max-width, opacity;
	}

	.bracket-inner {
		display: inline-block;
		white-space: nowrap;
		transform: translateX(-8px);
		transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1) 0.15s;
		will-change: transform;
	}

	.bracket-hover-wrapper.is-hovered .bracket-content {
		max-width: var(--expanded-width, 13.5em);
		opacity: 1;
		transition:
			max-width 0.4s cubic-bezier(0.25, 1, 0.5, 1) 0s,
			opacity 0.25s ease-out 0s;
	}

	.bracket-hover-wrapper.is-hovered .bracket-inner {
		transform: translateX(0);
		transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1) 0s;
	}

	/* Custom Tooltip Styling */
	.custom-tooltip {
		font-family: "Source Serif 4", "Georgia", serif;
		color: #c2152f;
		font-weight: 600;
	}

	.cmu-name {
		font-family: "Source Serif 4", "Georgia", serif;
		color: #c2152f;
		font-weight: 600;
	}

	.hero-actions-row {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin-top: 2rem;
		padding-inline: 0;
		width: 100%;
		box-sizing: border-box;
	}

	.hero-actions-left {
		display: flex;
		align-items: flex-end;
		gap: 1.5rem;
	}

	.hero-actions {
		display: flex;
		justify-content: flex-start; /* Align links to left */
		align-items: flex-end;
		gap: 1.5rem;
	}

	/* Responsive */
	@media (max-width: 1024px) {
		.fixed-nav-top-left {
			position: fixed;
			top: 20px;
			left: 50% !important;
			transform: translateX(-50%) !important;
			width: auto;
			margin-bottom: 0;
			display: block;
			padding: 0;
