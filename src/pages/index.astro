---
import Layout from "../layouts/Layout.astro";
import GhostRunner from "../components/GhostRunner.astro";
import HomeProjectCard from "../components/HomeProjectCard.astro";
import HomeNavigation from "../components/HomeNavigation.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Footer from "../components/Footer.astro";
import WorksFilter from "../components/WorksFilter.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Import hero images for optimization
import dotThreadsHero from "../assets/projects/dot-threads/hero-dothreads.gif";
import deturHero from "../assets/projects/detur/hero-detur.png";
import pikoHero from "../assets/projects/piko/hero-piko.gif";
import sanctuaryHero from "../assets/projects/santuary/hero-santuary.png";
import tirupatiHero from "../assets/projects/tirupati/hero-tirupati.gif";
import pointoHero from "../assets/projects/pointo/cover.gif";
import serendipityHero from "../assets/projects/serendipity/hero-serendipidity.png";
import musibuddyHero from "../assets/projects/musibuddy/hero-musibuddy.gif";
import lab4cHero from "../assets/projects/lab4c/hero.jpeg";
import clickyHero from "../assets/projects/clicky/clicky.gif";

// Fetch all projects
const allProjects = (await getCollection("projects"))
	.filter((project) =>
		[
			"hey-clicky",
			"detour",
			"working-living-innovating",
			"skywalk-sanctuary",
			"dot-threads",
			"pointo",
			"serendipidity",
			"piko",
			"musibuddy",
			"lab4c",
			"prompt-nodes",
		].includes(project.slug),
	)
	.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const heroImages: Record<string, ImageMetadata> = {
	"hey-clicky": clickyHero,
	"dot-threads": dotThreadsHero,
	detour: deturHero,
	piko: pikoHero,
	"skywalk-sanctuary": sanctuaryHero,
	"working-living-innovating": tirupatiHero,
	pointo: pointoHero,
	serendipidity: serendipityHero,
	musibuddy: musibuddyHero,
	lab4c: lab4cHero,
};

// Convenience references by slug for manual column layout
const heyClickyProject = allProjects.find(
	(project) => project.slug === "hey-clicky",
);
const dotThreadsProject = allProjects.find(
	(project) => project.slug === "dot-threads",
);
const detourProject = allProjects.find((project) => project.slug === "detour");
const pikoProject = allProjects.find((project) => project.slug === "piko");
const pointoProject = allProjects.find((project) => project.slug === "pointo");
const serendipityProject = allProjects.find(
	(project) => project.slug === "serendipidity",
);
const lab4cProject = allProjects.find((project) => project.slug === "lab4c");
const promptNodesProject = allProjects.find(
	(project) => project.slug === "prompt-nodes",
);
---

<Layout
	title="Narayan Ashanahalli"
	description="👋 I'm Narayan, a Product Designer & Prototyper building 0-to-1 experiences across AI, hardware, and digital infrastructure."
	fullWidth={true}
>
	<HomeNavigation />

	<img
		id="bio-ghost-walker"
		class="bio-ghost-walker"
		src="/logos/happy 1.png"
		alt=""
		width="53"
		height="53"
		loading="eager"
		decoding="async"
		draggable="false"
	/>

	<div class="toggle-floater">
		<div class="sidebar-controls">
			<ThemeToggle />
		</div>
	</div>

	<div class="home-content">
		<!-- LAYER 1: HERO / INTRO -->
		<section class="hero" id="about">
			<div class="hero-container">
				<!-- Game moved to footer -->

				<div class="bio-content">
					<div class="hero-headline bio-short">
						<div class="bio-line-1">
							<span class="dynamic-color-text"
								>👋 <br />I'm Narayan Ashanahalli,</span
							>
						</div>
						<div class="bio-line-1">
							<span class="dynamic-color-text"
								>a Product Designer & Prototyper</span
							>
						</div>
						<div class="bio-line-2">
							building [0-to-1]&nbsp;experiences across<br />AI,
							hardware, and digital infrastructure.
						</div>
					</div>
				</div>

				<div class="hero-actions-row">
					<div class="hero-actions-left">
						<div class="hero-actions">
							<a
								href="https://drive.google.com/file/d/1PcdJ52A1hec-0XFzHHCelg89N1d4cDHw/view?usp=sharing"
								target="_blank"
								rel="noopener noreferrer"
								class="action-link"
								>CV <svg
									viewBox="0 0 10 10"
									fill="none"
									xmlns="http://www.w3.org/2000/svg"
									class="arrow-svg arrow-up-right"
									><path d="M2 8L8 2M8 2H4M8 2V6"></path></svg
								></a
							>

							<a href="#footer" class="action-link"
								>Contact <svg
									viewBox="0 0 10 10"
									fill="none"
									xmlns="http://www.w3.org/2000/svg"
									class="arrow-svg arrow-down-left"
									><path d="M8 2L2 8M2 8H6M2 8V4"></path></svg
								></a
							>
						</div>
					</div>

					<div class="cmu-pill">
						<span class="cmu-pill-text">
							<span class="status-indicator"></span>
							Actively looking for full-time roles
						</span>
					</div>
				</div>
			</div>
			<div class="hero-divider"></div>
		</section>

		<!-- LAYER 2: WORKS -->
		<section id="works" class="layer-works">
			<div class="works-container">
				<div class="works-header-sticky">
					<WorksFilter />
				</div>
				<div class="home-project-list">
					{
						dotThreadsProject && (
							<div
								class="project-card-wrapper"
								data-categories="web-ux"
							>
								<HomeProjectCard
									title={dotThreadsProject.data.title}
									image={
										heroImages[dotThreadsProject.slug] ||
										dotThreadsProject.data.heroImage
									}
									loading="eager"
									fetchPriority="high"
									href={`/works/${dotThreadsProject.slug}`}
									tags={dotThreadsProject.data.tags}
									meta={dotThreadsProject.data.meta}
									description={
										dotThreadsProject.data.description
									}
									categories={["web-ux"]}
								/>
							</div>
						)
					}
					{
						pointoProject && (
							<div
								class="project-card-wrapper"
								data-categories="hardware-ux"
							>
								<HomeProjectCard
									title={pointoProject.data.title}
									image={
										heroImages[pointoProject.slug] ||
										pointoProject.data.heroImage
									}
									loading="lazy"
									href={`/works/${pointoProject.slug}`}
									tags={pointoProject.data.tags}
									meta={pointoProject.data.meta}
									description={pointoProject.data.description}
									categories={["hardware-ux"]}
								/>
							</div>
						)
					}
					{
						heyClickyProject && (
							<div
								class="project-card-wrapper"
								data-categories="web-ux"
							>
								<HomeProjectCard
									title={heyClickyProject.data.title}
									image={
										heroImages[heyClickyProject.slug] ||
										heyClickyProject.data.heroImage
									}
									loading="lazy"
									href={
										heyClickyProject.data.ctaUrl ||
										`/works/${heyClickyProject.slug}`
									}
									tags={heyClickyProject.data.tags}
									meta={heyClickyProject.data.meta}
									description={
										heyClickyProject.data.description
									}
									categories={["web-ux"]}
								/>
							</div>
						)
					}
					{
						promptNodesProject && (
							<div
								class="project-card-wrapper"
								data-categories="web-ux"
							>
								<HomeProjectCard
									title={promptNodesProject.data.title}
									image={
										heroImages[promptNodesProject.slug] ||
										promptNodesProject.data.heroImage
									}
									loading="lazy"
									href={`/works/${promptNodesProject.slug}`}
									tags={promptNodesProject.data.tags}
									meta={promptNodesProject.data.meta}
									description={
										promptNodesProject.data.description
									}
									categories={["web-ux"]}
								/>
							</div>
						)
					}
					{
						lab4cProject && (
							<div
								class="project-card-wrapper"
								data-categories="web-ux"
							>
								<HomeProjectCard
									title={lab4cProject.data.title}
									image={
										heroImages[lab4cProject.slug] ||
										lab4cProject.data.heroImage
									}
									loading="lazy"
									href={
										lab4cProject.data.ctaUrl ||
										`/works/${lab4cProject.slug}`
									}
									tags={lab4cProject.data.tags}
									meta={lab4cProject.data.meta}
									description={lab4cProject.data.description}
									categories={["web-ux"]}
								/>
							</div>
						)
					}
					{
						detourProject && (
							<div
								class="project-card-wrapper"
								data-categories="mobile-ux"
							>
								<HomeProjectCard
									title={detourProject.data.title}
									image={
										heroImages[detourProject.slug] ||
										detourProject.data.heroImage
									}
									loading="lazy"
									href={`/works/${detourProject.slug}`}
									tags={detourProject.data.tags}
									meta={detourProject.data.meta}
									description={detourProject.data.description}
									categories={["mobile-ux"]}
								/>
							</div>
						)
					}
					{
						serendipityProject && (
							<div
								class="project-card-wrapper"
								data-categories="mobile-ux"
							>
								<HomeProjectCard
									title={serendipityProject.data.title}
									image={
										heroImages[serendipityProject.slug] ||
										serendipityProject.data.heroImage
									}
									loading="lazy"
									href={`/works/${serendipityProject.slug}`}
									tags={serendipityProject.data.tags}
									meta={serendipityProject.data.meta}
									description={
										serendipityProject.data.description
									}
									categories={["mobile-ux"]}
								/>
							</div>
						)
					}
					{
						pikoProject && (
							<div
								class="project-card-wrapper"
								data-categories="hardware-ux"
							>
								<HomeProjectCard
									title={pikoProject.data.title}
									image={
										heroImages[pikoProject.slug] ||
										pikoProject.data.heroImage
									}
									loading="lazy"
									href={`/works/${pikoProject.slug}`}
									tags={pikoProject.data.tags}
									meta={pikoProject.data.meta}
									description={pikoProject.data.description}
									categories={["hardware-ux"]}
								/>
							</div>
						)
					}
				</div>

				<!-- See More button: visible only when a filter is active and hides some projects -->
				<div
					id="see-more-wrap"
					class="see-more-wrap"
					aria-hidden="true"
				>
					<button
						id="see-more-btn"
						class="see-more-btn"
						type="button"
					>
						<span class="see-more-circle">
							<svg
								width="12"
								height="12"
								viewBox="0 0 12 12"
								fill="none"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									d="M6 2V10M6 10L3 7M6 10L9 7"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</span>
						<span class="see-more-label">See More</span>
					</button>
				</div>
			</div>
		</section>

		<Footer />
		<div class="game-bottom-wrapper">
			<GhostRunner />
		</div>
	</div>

	<!-- Project scroll dot indicator (fixed, viewport-centred) -->
	<nav
		id="project-scroll-nav"
		class="projects-nav"
		aria-label="Project navigation"
		aria-hidden="true"
	>
		<div class="projects-nav__track"></div>
	</nav>
</Layout>

<style>
	.fixed-nav-bottom-right {
		position: fixed;
		bottom: 128px;
		right: 128px;
		z-index: 100;
		width: auto; /* Allow it to shrink to content */
		display: flex; /* Ensure proper stacking if multiple items */
		justify-content: flex-end;
		transition: bottom 0.1s ease-out; /* Smooth collision movement */
	}

	.toggle-floater {
		position: fixed !important;
		bottom: 20px !important;
		right: 20px !important;
		top: auto !important;
		margin: 0 !important;
		padding: 0 !important;
		z-index: 100;
		width: auto;
		display: flex;
		justify-content: flex-end;
	}

	.sidebar-controls {
		display: flex;
		gap: 1rem;
		align-items: center;
	}

	/* Content Area */
	.home-content {
		padding: 400px var(--total-side-padding) 0 var(--total-side-padding); /* Dynamic side padding to keep middle width constant */
		max-width: 100%;
		margin: 0;
		width: 100%;
		position: relative;
		box-sizing: border-box;
	}

	.game-bottom-wrapper {
		position: relative;
		width: calc(100% + 2 * var(--total-side-padding));
		margin-left: calc(-1 * var(--total-side-padding));
		margin-top: 0px;
		margin-bottom: 0px;
		z-index: 0;
	}

	.game-bottom-wrapper :global(.ghost-game-container) {
		border-radius: 0;
		border: none;
		border-top: 1px solid var(--border-subtle);
		width: 100%;
	}

	/* Adjust Hero Container to accommodate absolute game */
	/* Since game is absolute, it doesn't take space. Bio will move up. */
	/* We need to push content down by the game height (160px + margin) */
	.hero-container {
		display: grid;
		grid-template-columns: 1fr; /* Mobile Default */
		gap: var(--space-md);
		width: 100%;
		padding-top: 0; /* Reset since game is gone */
		position: static;
	}

	/* Desktop: 3 Columns, Content starts at Col 1 (Span 2) */
	@media (min-width: 1200px) {
		.hero-container {
			grid-template-columns: 1fr 1fr 1fr;
		}

		/* Align all direct children to start at column 1 (Left Aligned Layout) */
		/* Game, Bio, Actions span first 2 columns */
		.hero-container > :global(*) {
			grid-column: 1 / 3;
		}

		.hero-container > .hero-actions-row {
			grid-column: 1 / -1;
		}
	}

	/* Tablet: 2 Columns */
	@media (min-width: 768px) and (max-width: 1199px) {
		.hero-container {
			grid-template-columns: 1fr 1fr;
		}

		/* In 2-col layout (Tablet), if Sidebar is right fixed... usually overlay or adjust */
		/* If flip keeps logic: Content in Col 1, Social/Sidebar in Col 2? */
		/* Original was: Content Col 2, Nav Col 1. */
		/* Flip: Content Col 1, Nav Col 2. */

		.hero-container > :global(*) {
			grid-column: 1 / 3;
		}
	}

	/* Bio Content */
	.bio-content {
		padding-top: 0;
		padding-inline: 0;
		grid-column: 1 / -1;
		max-width: 100%; /* Matches Game Width */
	}

	.cmu-pill {
		margin: 0;
	}

	.cmu-pill-text {
		font-family: var(--font-sans);
		font-size: 12px;
		color: var(--text-secondary);
		letter-spacing: 0.01em;
		background: transparent;
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-md);
		padding: 6px 14px;
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.status-indicator {
		display: inline-block;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background-color: var(--accent-secondary);
		box-shadow: 0 0 8px var(--accent-secondary);
		position: relative;
	}

	.status-indicator::after {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		border-radius: 50%;
		background-color: var(--accent-secondary);
		animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
		z-index: -1;
	}

	@keyframes pulse-ring {
		0% {
			transform: scale(1);
			opacity: 0.8;
		}
		100% {
			transform: scale(2.5);
			opacity: 0;
		}
	}

	/* Bracket Hover Animation */
	.bracket-hover-wrapper {
		display: inline-flex;
		align-items: baseline;
		cursor: pointer;
		vertical-align: baseline;
		color: var(--text-secondary);
		transition: color 0.3s ease 0.15s;
	}

	.bracket-hover-wrapper.is-hovered {
		color: var(--text-primary);
		transition: color 0.3s ease 0s;
	}

	.bracket {
		display: inline-block;
		transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1) 0.15s;
	}

	.bracket-hover-wrapper.is-hovered .bracket {
		transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1) 0s;
	}

	.bracket-hover-wrapper.is-hovered .bracket:first-child {
		transform: translateX(-2px);
	}

	.bracket-hover-wrapper.is-hovered .bracket:last-child {
		transform: translateX(2px);
	}

	.bracket-content {
		display: inline-block;
		white-space: nowrap;
		opacity: 1;
	}

	.bracket-inner {
		display: inline-block;
		white-space: nowrap;
	}

	/* Custom Tooltip Styling */
	.custom-tooltip {
		font-family: var(--font-sans);
		color: #c2152f;
		font-weight: 600;
	}

	.cmu-name {
		font-family: var(--font-sans);
		color: #c2152f;
		font-weight: 600;
	}

	.hero-actions-row {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		flex-wrap: wrap;
		gap: 3rem;
		margin-top: 2rem;
		padding-inline: 0;
		width: 100%;
		box-sizing: border-box;
	}

	.hero-actions-left {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.25rem;
	}

	.hero-actions {
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		align-items: flex-start;
		gap: 0.2rem;
	}

	/* Responsive */
	@media (max-width: 1024px) {
		.toggle-floater {
			right: 48px !important;
			bottom: 20px !important;
			top: auto !important;
		}

		.fixed-nav-bottom-right {
			position: static;
			width: 100%;
			margin-bottom: 2rem;
		}

		.hero-container {
			grid-template-columns: 1fr;
			padding-left: 0;
		}

		.bio-content {
			padding-top: 0;
		}
	}

	@media (max-width: 768px) {
		.toggle-floater {
			right: 24px !important;
			bottom: 24px !important;
			top: auto !important;
		}
	}

	/* Hero Section */
	.hero {
		padding: 0;
		font-weight: 400;
		font-size: 36px;
		margin-bottom: 0px; /* Gap below line */
	}

	.bio-ghost-walker {
		position: fixed;
		top: 0;
		left: 0;
		width: 52.5px;
		height: 52.5px;
		object-fit: contain;
		pointer-events: auto;
		touch-action: none;
		user-select: none;
		-webkit-user-drag: none;
		/* Above the nav bar (200) and everything else in the page,
		   so it isn't clipped by any container's own padding/margins */
		z-index: 210;
		will-change: transform;
		transition: opacity 0.25s ease;
	}

	.hero-divider {
		height: 1px;
		background: var(--border-subtle);
		margin-inline: 0;
		margin-top: 20px;
	}

	.hero-intro {
		font-size: 1.25rem;
		color: var(--text-secondary);
		max-width: 100%;
		line-height: 1.15;
	}

	/* Works Layer */
	.layer-works {
		position: relative;
		min-height: 100vh;
		background: var(
			--bg-primary
		); /* Ensure opaque background for layering */
		padding-bottom: var(--space-4xl);
		scroll-margin-top: 0; /* Ensure flush alignment with viewport top */
	}

	.works-container {
		padding: 40px 0 136px 0;
	}

	.works-title {
		font-family: "Google Sans", sans-serif;
		font-size: 48px;
		font-weight: 500 !important;
		color: var(--pure-bg-inverse);
		text-align: center;
		text-transform: none;
		margin: 0 0 40px 0;
		letter-spacing: -0.005em;
		line-height: 1.5;
	}

	@media (max-width: 1024px) {
		.works-title {
			font-size: 20px;
			margin-bottom: 24px;
		}
	}

	.works-header-sticky {
		position: sticky;
		top: 10px;
		z-index: 210;
		padding: 0; /* Remove padding to be precise */
		margin-bottom: 20px; /* 20px gap to content */
		pointer-events: none; /* Let clicks pass through the empty areas */
	}

	@media (max-width: 1024px) {
		.works-header-sticky {
			top: 10px !important;
		}
	}

	@media (max-width: 768px) {
		.works-header-sticky {
			position: fixed !important;
			top: auto !important;
			bottom: 24px !important;
			left: 24px !important;
			right: 72px !important;
			margin-bottom: 0 !important;
		}
	}

	/* Renable pointer events for the filter itself */
	.works-header-sticky :global(*) {
		pointer-events: auto;
	}

	.categories-wrapper {
		display: flex;
		flex-direction: column;
		gap: var(--space-4xl);
	}

	/* Home project list — vertical stack of wide 2-col cards */
	.home-project-list {
		display: flex;
		flex-direction: column;
		gap: 40px;
		width: 100%;
	}

	/* See More Button */
	.see-more-wrap {
		display: flex;
		justify-content: center;
		padding: 0;
		margin-top: 0;
		overflow: hidden;
		max-height: 0;
		opacity: 0;
		transition:
			max-height 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
			opacity 0.4s ease,
