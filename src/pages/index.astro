<script>
	document.addEventListener("DOMContentLoaded", () => {
		const readMoreBtn = document.getElementById("read-more-btn");
		const navAbout = document.getElementById("nav-about");
		const bioContent = document.querySelector(
			".bio-content",
		) as HTMLElement;
		const bioShort = document.querySelector(".bio-short") as HTMLElement;
		const bioLong = document.querySelector(".bio-long") as HTMLElement;

		if (readMoreBtn && bioContent && bioShort && bioLong) {
			const toggleBio = () => {
				readMoreBtn.classList.toggle("active");

				const isShortVisible =
					getComputedStyle(bioShort).display !== "none";

				// 1. Lock Container Height (Current State)
				const startHeight = bioContent.offsetHeight;
				bioContent.style.height = `${startHeight}px`;

				if (isShortVisible) {
					// EXPANDING: Short -> Long

					// Instant Disappear Short
					bioShort.style.display = "none";

					// Prepare Long (Grid)
					bioLong.style.display = "grid";
					bioLong.style.opacity = "0";

					// Measure Target Height
					// Unset container height temporarily to measure
					bioContent.style.height = "auto";
					const targetHeight = bioContent.scrollHeight;
					// Reset to start
					bioContent.style.height = `${startHeight}px`;

					// Force Reflow
					void bioContent.offsetWidth;

					// Animate
					bioContent.style.height = `${targetHeight}px`;
					bioLong.style.opacity = "1";
				} else {
					// COLLAPSING: Long -> Short

					// Instant Disappear Long
					bioLong.style.display = "none";
					bioLong.style.opacity = "0";

					// Prepare Short
					bioShort.style.display = "block";

					// Measure Target Height
					bioContent.style.height = "auto";
					const targetHeight = bioContent.scrollHeight;
					bioContent.style.height = `${startHeight}px`;

					// Force Reflow
					void bioContent.offsetWidth;

					// Animate
					bioContent.style.height = `${targetHeight}px`;
				}

				// Cleanup after transition
				setTimeout(() => {
					bioContent.style.height = "auto";
				}, 400);
			};

			// Read More Button Click
			readMoreBtn.addEventListener("click", (e) => {
				e.preventDefault();
				const scrollY = window.scrollY;
				toggleBio();
				// Restore scroll position immediately
				window.scrollTo(0, scrollY);
			});

			// Auto-Expand if URL has #about hash (on page load)
			if (window.location.hash === "#about") {
				if (!readMoreBtn.classList.contains("active")) {
					// Delay slightly to ensure DOM is ready
					setTimeout(() => {
						toggleBio();
					}, 100);
				}
			}

			// About Link Click handler (works for both dropdown and inline nav)
			let isNavigatingToAbout = false;

			const aboutClickTargets = [
				document.getElementById("nav-about"),
				document.getElementById("nav-about-link"),
			].filter(Boolean);

			aboutClickTargets.forEach((aboutEl) => {
				aboutEl!.addEventListener("click", (e) => {
					e.preventDefault();

					// Set flag to prevent auto-collapse
					isNavigatingToAbout = true;

					// 1. Expand Bio FIRST (before navigation)
					if (
						readMoreBtn &&
						!readMoreBtn.classList.contains("active")
					) {
						toggleBio();
					}

					// 2. Scroll to top to show the bio
					window.scrollTo({ top: 0, behavior: "smooth" });

					// 3. Clear flag after a delay
					setTimeout(() => {
						isNavigatingToAbout = false;
					}, 1500);
				});
			});

			// HOME Link Click - collapse long bio back to short
			const homeLink = document.getElementById("nav-home-link");
			if (homeLink) {
				homeLink.addEventListener("click", (e) => {
					e.preventDefault();
					// If long bio is showing, collapse it
					if (readMoreBtn.classList.contains("active")) {
						const scrollY = window.scrollY;
						toggleBio();
						window.scrollTo(0, scrollY);
					}
					// Scroll to top
					window.scrollTo({ top: 0, behavior: "smooth" });
				});
			}
			// Auto-Collapse Logic (Silent with Scroll Compensation)
			let isCollapsing = false;
			window.addEventListener(
				"scroll",
				() => {
					if (isCollapsing) return; // Guard against re-entrant scroll events

					const worksSection = document.getElementById("works");

					// Only run if Expanded AND Works section exists AND not navigating to About
					if (
						readMoreBtn.classList.contains("active") &&
						worksSection &&
						!isNavigatingToAbout
					) {
						const worksTop = worksSection.offsetTop;
						const scrollY = window.scrollY;

						// Check if we have scrolled into Works (with a small buffer)
						if (scrollY > worksTop - 100) {
							isCollapsing = true;

							// 1. Snapshot relative position of the anchor element (Works)
							const worksViewportTop =
								worksSection.getBoundingClientRect().top;

							// 2. Disable smooth scroll & anchoring to prevent jump
							document.documentElement.style.scrollBehavior =
								"auto";
							document.body.style.overflowAnchor = "none";

							// 3. Hide container to prevent flash
							bioContent.style.transition = "none";
							bioContent.style.visibility = "hidden";

							// 4. Swap Content
							readMoreBtn.classList.remove("active");
							bioLong.style.display = "none";
							bioLong.style.opacity = "0";
							bioShort.style.display = "block";
							bioContent.style.height = "auto";

							// 5. Force layout update
							void bioContent.offsetHeight;

							// 6. Calculate new absolute position and scroll to restore viewport position
							const newWorksTop = worksSection.offsetTop;
							window.scrollTo(0, newWorksTop - worksViewportTop);

							// 7. Show content
							bioContent.style.visibility = "";

							// 8. Restore settings in next frame
							requestAnimationFrame(() => {
								document.documentElement.style.scrollBehavior =
									"";
								document.body.style.overflowAnchor = "";
								bioContent.style.transition = "";
								isCollapsing = false;
							});
						}
					}
				},
				{ passive: true },
			);

			// Emoji Hover Display
			const emojiDisplay = document.querySelector(
				".emoji-display",
			) as HTMLElement;
			const emojiHovers = document.querySelectorAll(".emoji-hover");

			emojiHovers.forEach((hover) => {
				hover.addEventListener("mouseenter", () => {
					const emoji = hover.getAttribute("data-emoji");
					if (emojiDisplay && emoji) {
						emojiDisplay.textContent = emoji;
						emojiDisplay.classList.remove("hidden");
					}
				});

				hover.addEventListener("mouseleave", () => {
					if (emojiDisplay) {
						emojiDisplay.classList.add("hidden");
					}
				});
			});

			// Hide emoji display initially
			if (emojiDisplay) {
				emojiDisplay.classList.add("hidden");
			}

			// Bracket Hover Transition Width Measurement & State Management
			const bracketWrappers = document.querySelectorAll(
				".bracket-hover-wrapper",
			);
			bracketWrappers.forEach((wrapper) => {
				const content = wrapper.querySelector(
					".bracket-content",
				) as HTMLElement;
				const inner = wrapper.querySelector(
					".bracket-inner",
				) as HTMLElement;
				const container =
					wrapper.closest(".bio-line-2") ||
					wrapper.closest(".bio-text");

				if (content && inner) {
					const setWidth = () => {
						const width = inner.scrollWidth;
						if (width > 0) {
							content.style.setProperty(
								"--expanded-width",
								`${width}px`,
							);
						}
					};
					// Measure immediately on DOMContentLoaded
					setWidth();
					// Fallbacks to handle font loading or dynamic adjustments
					wrapper.addEventListener("mouseenter", setWidth);
					window.addEventListener("load", setWidth);

					// Trigger expand when mouse enters the bracket itself
					wrapper.addEventListener("mouseenter", () => {
						wrapper.classList.add("is-hovered");
					});

					// Only collapse when mouse leaves the broader container (preventing layout shift flicker)
					if (container) {
						container.addEventListener("mouseleave", () => {
							wrapper.classList.remove("is-hovered");
						});
					} else {
						// Fallback if no container is found
						wrapper.addEventListener("mouseleave", () => {
							wrapper.classList.remove("is-hovered");
						});
					}
				}
			});

			// Dynamic Bio Text Color based on filter selection
			const FILTER_COLORS: Record<string, string> = {
				all: "#42BE4A", // Default state color (#42BE4A)
				"physical-ux": "#0D8CE9", // Hover state blue color
				"web-ux": "#F6631A",
				"mobile-ux": "#FACC09",
				"spatial-xd": "#2B923D",
			};

			const hash = window.location.hash.slice(1);
			const initialColor = FILTER_COLORS[hash] || FILTER_COLORS["all"];
			const dynamicTexts = document.querySelectorAll(
				".dynamic-color-text",
			);
			dynamicTexts.forEach((el) => {
				(el as HTMLElement).style.color = initialColor;
			});

			const onWorksFilterChangeColor = (e: any) => {
				const filter = e.detail.filter;
				const color = FILTER_COLORS[filter] || FILTER_COLORS["all"];
				const dynamicTexts = document.querySelectorAll(
					".dynamic-color-text",
				);
				dynamicTexts.forEach((el) => {
					(el as HTMLElement).style.color = color;
				});
			};

			if ((window as any)._worksFilterColorListener) {
				window.removeEventListener(
					"works-filter-change",
					(window as any)._worksFilterColorListener,
				);
			}
			(window as any)._worksFilterColorListener =
				onWorksFilterChangeColor;
			window.addEventListener(
				"works-filter-change",
				onWorksFilterChangeColor,
			);

			// Floating Theme Toggle Footer Collision Logic
			const toggleFloater = document.querySelector(".toggle-floater") as HTMLElement;
			const footer = document.querySelector(".site-footer") as HTMLElement;
			if (toggleFloater && footer) {
				const updateTogglePosition = () => {
					const footerRect = footer.getBoundingClientRect();
					const windowHeight = window.innerHeight;
					const margin = 20;

					if (footerRect.top < windowHeight) {
						const offset = windowHeight - footerRect.top + margin;
						toggleFloater.style.setProperty("bottom", `${offset}px`, "important");
					} else {
						toggleFloater.style.setProperty("bottom", "20px", "important");
					}
				};

				window.addEventListener("scroll", updateTogglePosition, { passive: true });
				window.addEventListener("resize", updateTogglePosition);
				updateTogglePosition();
			}
		}
	});
</script>

<script>
	function setupWorksGridFilter() {
		const list = document.querySelector(".home-project-list");
		if (!list) return;

		const wrappers = Array.from(
			list.querySelectorAll(".project-card-wrapper"),
		) as HTMLElement[];
		if (wrappers.length === 0) return;

		const seeMoreWrap = document.getElementById("see-more-wrap");
		const seeMoreBtn = document.getElementById("see-more-btn");

		// Store original order of wrappers
		const originalOrder = [...wrappers];

		// Store category data for each wrapper
		const wrapperData = wrappers.map((wrapper) => {
			const categories = (wrapper.getAttribute("data-categories") || "")
				.split(" ")
				.filter(Boolean);
			return { wrapper, categories };
		});

		let currentFilter = "all";
		let isExpanded = false;

		function applyFilter(filter: string) {
			currentFilter = filter;

			// Always restore original order first so successive filters start from a clean baseline
			originalOrder.forEach((w) => list.appendChild(w));
			isExpanded = false;

			let matching: typeof wrapperData = [];
			let nonMatching: typeof wrapperData = [];

			if (filter === "all") {
				matching = [...wrapperData];
				nonMatching = [];
			} else if (filter === "mobile-ux" || filter === "web-ux") {
				// Selected filter is primary
				const primary = wrapperData.filter((d) =>
					d.categories.includes(filter),
				);
				// The other UX filter is secondary (continuing the list)
				const otherFilter =
					filter === "mobile-ux" ? "web-ux" : "mobile-ux";
				const secondary = wrapperData.filter((d) =>
					d.categories.includes(otherFilter),
				);

				matching = [...primary, ...secondary];
				// Non-matching are items that belong to neither UX category
				nonMatching = wrapperData.filter(
					(d) =>
						!d.categories.includes("mobile-ux") &&
						!d.categories.includes("web-ux"),
				);
			} else {
				matching = wrapperData.filter((d) =>
					d.categories.includes(filter),
				);
				nonMatching = wrapperData.filter(
					(d) => !d.categories.includes(filter),
				);
			}

			// Reorder in DOM: matching first, then non-matching
			matching.forEach((d) => list.appendChild(d.wrapper));
			nonMatching.forEach((d) => list.appendChild(d.wrapper));

			// Reset classes first
			wrappers.forEach((w) => {
				w.classList.remove("collapsed");
				w.classList.remove("sneak-peek");
			});

			if (filter !== "all") {
				// For non-matching:
				// - The first one becomes a sneak-peek
				// - The rest are collapsed
				nonMatching.forEach(({ wrapper }, index) => {
					if (index === 0) {
						wrapper.classList.add("sneak-peek");
					} else {
						wrapper.classList.add("collapsed");
					}
				});
			}

			// Show see-more button only when a filter is active and hides some items
			const hasHidden = filter !== "all" && nonMatching.length > 0;
			if (seeMoreWrap) {
				seeMoreWrap.classList.toggle("visible", hasHidden);
				seeMoreWrap.setAttribute(
					"aria-hidden",
					hasHidden ? "false" : "true",
				);
			}
		}

		// See More click: expand to show all below matching ones
		if (seeMoreBtn) {
			seeMoreBtn.addEventListener("click", () => {
				isExpanded = true;

				// Hide the "See More" button section
				if (seeMoreWrap) {
					seeMoreWrap.classList.remove("visible");
					seeMoreWrap.setAttribute("aria-hidden", "true");
				}

				// Show all projects smoothly with a stagger
				let delay = 0;
				wrappers.forEach((w) => {
					w.classList.remove("sneak-peek");
					if (w.classList.contains("collapsed")) {
						setTimeout(() => {
							w.classList.remove("collapsed");
						}, delay);
						delay += 75; // Stagger effect
					}
				});

				// Notify scroll nav & lenis to rebuild after transitions start
				setTimeout(() => {
					window.dispatchEvent(
						new CustomEvent("works-filter-change", {
							detail: { filter: "__expanded" },
						}),
					);
				}, delay + 50);
			});
		}

		// Determine active filter from URL hash on load
		const hash = window.location.hash.slice(1);
		const validFilters = [
			"physical-ux",
			"web-ux",
			"mobile-ux",
			"spatial-xd",
		];
		const activeFilter = validFilters.includes(hash) ? hash : "all";

		applyFilter(activeFilter);

		if (activeFilter !== "all") {
			const worksSection = document.getElementById("works");
			if (worksSection) {
				setTimeout(() => {
					worksSection.scrollIntoView({ behavior: "smooth" });
				}, 100);
			}
		}

		// Listen for filter changes dispatched from WorksFilter
		const onWorksGridFilterChange = ((e: CustomEvent) => {
			// Don't re-process our own synthetic events
			if (e.detail.filter === "__expanded") return;
			applyFilter(e.detail.filter);
		}) as EventListener;

		if ((window as any)._worksGridFilterListener) {
			window.removeEventListener(
				"works-filter-change",
				(window as any)._worksGridFilterListener,
			);
		}
		(window as any)._worksGridFilterListener = onWorksGridFilterChange;
		window.addEventListener("works-filter-change", onWorksGridFilterChange);
	}

	// Run initial setup and listen for page loads (Astro view transitions support)
	setupWorksGridFilter();
	document.addEventListener("astro:page-load", setupWorksGridFilter);
</script>

<script>
	let cleanupProjectScroll: (() => void) | null = null;
	let cleanupLenisFriction: (() => void) | null = null;

	/* ─── Project Scroll Dot Indicator (Clément Rozé Style) ─── */
	function setupProjectScrollNav() {
		if (cleanupProjectScroll) {
			cleanupProjectScroll();
			cleanupProjectScroll = null;
		}

		const nav = document.getElementById("project-scroll-nav");
		if (!nav) return;

		const track = nav.querySelector(".projects-nav__track");
		if (!track) return;

		const worksSection = document.getElementById("works");
		const wrappers = Array.from(
			document.querySelectorAll(".project-card-wrapper"),
		) as HTMLElement[];

		if (wrappers.length === 0) return;

		// Build dots dynamically inside track
		track.innerHTML = "";
		const dots = wrappers.map((wrapper, i) => {
			const dotWrap = document.createElement("button");
			dotWrap.className = "projects-nav__dot-wrap";
			dotWrap.setAttribute("aria-label", `Scroll to project ${i + 1}`);

			const pill = document.createElement("span");
			pill.className = "projects-nav__pill";

			const label = document.createElement("span");
			label.className = "projects-nav__label";

			// Find title from within the card's markup
			const titleEl = wrapper.querySelector(".meta-project-title");
			label.textContent = titleEl
				? titleEl.textContent
				: `Project ${i + 1}`;

			dotWrap.appendChild(pill);
			dotWrap.appendChild(label);

			dotWrap.addEventListener("click", (e) => {
				e.preventDefault();
				wrapper.scrollIntoView({ behavior: "smooth", block: "center" });
			});

			track.appendChild(dotWrap);
			return { dotWrap, pill, wrapper };
		});

		// Dynamically position and show/hide the track based on scroll
		function updateVisibilityAndPosition() {
			// Toggle visibility when scrolled past a small threshold
			const isVisible = window.scrollY > 50;
			nav.classList.toggle("visible", isVisible);

			// Position the Y offset of the track
			const H = window.innerHeight;
			const Th = (track as HTMLElement).offsetHeight || 180;
			const paddingBottom = 40; // padding from the bottom edge
			const Y_bottom = H - Th - paddingBottom;
			const Y_center = (H - Th) / 2;

			// We want it to be fully centered when we scroll to the works section
			const W_top = worksSection ? worksSection.offsetTop : 400;
			const scrollThreshold = Math.max(100, W_top - 200);
			const S = window.scrollY;

			const progress = Math.max(0, Math.min(1, S / scrollThreshold));
			let Y = Y_bottom + (Y_center - Y_bottom) * progress;

			// Keep 20px padding between the bottom of the track and the top of the theme toggle
			const toggleFloater = document.querySelector(".toggle-floater") as HTMLElement | null;
			const toggleHeight = toggleFloater ? toggleFloater.offsetHeight : 44;
			let toggleBottom = 20;

			const footer = document.querySelector(".site-footer");
			if (footer) {
				const footerRect = footer.getBoundingClientRect();
				if (footerRect.top < H) {
					toggleBottom = H - footerRect.top + 20;
				}
			}

			const maxAllowedY = H - Th - toggleBottom - toggleHeight - 20;
			if (Y > maxAllowedY) {
				Y = maxAllowedY;
			}

			(track as HTMLElement).style.transform = `translateY(${Y}px)`;
		}

		// Dynamically morph dot sizes and opacities as user scrolls
		function updateActiveDotStates() {
			const visibleWrappers = wrappers.filter(
				(w) =>
					!w.classList.contains("collapsed") &&
					!w.classList.contains("sneak-peek"),
			);
			const visibleDots = dots.filter(
				(d) =>
					!d.wrapper.classList.contains("collapsed") &&
					!d.wrapper.classList.contains("sneak-peek"),
			);

			if (visibleWrappers.length === 0) return;

			// Store heights and update visibility
			dots.forEach(({ dotWrap, wrapper }) => {
				if (
					wrapper.classList.contains("collapsed") ||
					wrapper.classList.contains("sneak-peek")
				) {
					dotWrap.style.display = "none";
				} else {
					dotWrap.style.display = "";
				}
			});

			// Compare card centers with viewport center
			const centers = visibleWrappers.map((w) => {
				const rect = w.getBoundingClientRect();
				return rect.top + window.scrollY + rect.height / 2;
			});
			const T = window.scrollY + window.innerHeight / 2;

			// Find fractional index P
			let P = 0;
			for (let z = 0; z < centers.length - 1; z++) {
				const G = centers[z];
				const Y = centers[z + 1];
				if (T >= G && T < Y) {
					P = z + (T - G) / (Y - G);
					break;
				}
			}
			if (T >= centers[centers.length - 1]) {
				P = centers.length - 1;
			}
			P = Math.max(0, Math.min(centers.length - 1, P));

			// Apply continuous transition heights and opacities
			visibleDots.forEach((d, index) => {
				const diff = Math.abs(P - index);
				if (diff < 1) {
					// Morph from dot (6px) to line (20px)
					const height = 6 + (20 - 6) * (1 - diff);
					const alpha = 0.35 + 0.65 * (1 - diff);
					d.pill.style.height = `${height}px`;
					d.pill.style.setProperty("--pill-alpha", alpha.toFixed(2));
				} else {
					d.pill.style.height = "6px";
					d.pill.style.setProperty("--pill-alpha", "0.35");
				}
			});
		}

		const handleScroll = () => {
			updateActiveDotStates();
			updateVisibilityAndPosition();
		};

		const handleResize = () => {
			updateActiveDotStates();
			updateVisibilityAndPosition();
		};

		window.addEventListener("scroll", handleScroll, { passive: true });
		window.addEventListener("resize", handleResize);

		updateActiveDotStates();
		updateVisibilityAndPosition();

		// Refresh when filter updates
		const handleFilterChange = () => {
			setupProjectScrollNav();
			setupLenisFriction();
		};
		window.addEventListener(
			"works-filter-change",
			handleFilterChange as EventListener,
		);

		cleanupProjectScroll = () => {
			window.removeEventListener("scroll", handleScroll);
			window.removeEventListener("resize", handleResize);
			window.removeEventListener(
				"works-filter-change",
				handleFilterChange as EventListener,
			);
		};
	}

	/* ─── Lenis Scroll Friction & Visual Emphasis ─── */
	function setupLenisFriction() {
		if (cleanupLenisFriction) {
			cleanupLenisFriction();
			cleanupLenisFriction = null;
		}

		const w = window as any;
		const wrappers = Array.from(
			document.querySelectorAll(".project-card-wrapper:not(.collapsed)"),
		) as HTMLElement[];

		if (wrappers.length === 0) return;

		// 1. Visual Emphasis via IntersectionObserver
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("is-centered");
					} else {
						entry.target.classList.remove("is-centered");
					}
				});
			},
			{
				rootMargin: "-25% 0px -25% 0px", // Only trigger when card is in the middle 50% of screen
				threshold: 0,
			},
		);

		wrappers.forEach((w) => observer.observe(w));

		// 2. Dynamic Scroll Blur & Opacity (Gradient Blur)
		const updateScrollVisuals = () => {
			const worksSection = document.getElementById("works");
			const worksTop = worksSection
				? worksSection.getBoundingClientRect().top + window.scrollY
				: 0;
			const isNearTop = window.scrollY < worksTop - 150;

			const viewportCenter = window.scrollY + window.innerHeight / 2;
			let closestDist = Infinity;

			for (const wrapper of wrappers) {
				if (wrapper.classList.contains("collapsed")) continue;
				const rect = wrapper.getBoundingClientRect();
				const cardCenter = rect.top + window.scrollY + rect.height / 2;
				const dist = Math.abs(viewportCenter - cardCenter);

				if (dist < closestDist) {
					closestDist = dist;
				}

				// Apply dynamic gradient blur & opacity based on distance from screen center (desktop only)
				if (window.innerWidth > 768 && !isNearTop) {
					const maxDist = window.innerHeight * 0.6; // Distance at which effect is fully saturated
					const t = Math.min(dist / maxDist, 1);
					const easeT = t * t; // Quadratic easing for a smoother focus transition near the center

					const blurVal = (easeT * 3.5).toFixed(1);
					const opacityVal = (1 - easeT * 0.45).toFixed(2);

					wrapper.style.filter = `blur(${blurVal}px)`;
					wrapper.style.opacity = opacityVal;
				} else {
					wrapper.style.filter = "";
					wrapper.style.opacity = "";
				}
			}

			// 3. Physical Friction via Lenis
			if (w.lenis) {
				const radius = 150;
				if (closestDist < radius) {
					const ratio = closestDist / radius;
					w.lenis.options.wheelMultiplier =
						0.25 + 0.75 * (ratio * ratio);
				} else {
					w.lenis.options.wheelMultiplier = 1;
				}
			}
		};

		window.addEventListener("scroll", updateScrollVisuals, {
			passive: true,
		});
		// Initial execution to align states immediately
		updateScrollVisuals();

		cleanupLenisFriction = () => {
			wrappers.forEach((wrapper) => {
				observer.unobserve(wrapper);
				wrapper.style.filter = "";
				wrapper.style.opacity = "";
			});
			observer.disconnect();
			window.removeEventListener("scroll", updateScrollVisuals);
			if (w.lenis) {
				w.lenis.options.wheelMultiplier = 1;
			}
		};
	}

	function init() {
		setupProjectScrollNav();
		setupLenisFriction();
	}

	// Run initial setup and listen for page loads (Astro view transitions support)
	document.addEventListener("DOMContentLoaded", init);
	document.addEventListener("astro:page-load", init);
</script>
