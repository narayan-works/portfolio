---
// PROTOTYPE: alternate editorial-list variant of the homepage works grid.
// Lives at /works-list, standalone from index.astro — not wired into it yet.
import Layout from "../layouts/Layout.astro";
import HomeNavigation from "../components/HomeNavigation.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Footer from "../components/Footer.astro";
import WorksFilter from "../components/WorksFilter.astro";
import WorksListRow from "../components/WorksListRow.astro";
import HomeProjectCard from "../components/HomeProjectCard.astro";
import GhostRunner from "../components/GhostRunner.astro";
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";

import dotThreadsHero from "../assets/projects/dot-threads/hero-dothreads.gif";
import deturHero from "../assets/projects/detur/hero-detur.png";
import pikoHero from "../assets/projects/piko/hero-piko.gif";
import sanctuaryHero from "../assets/projects/santuary/hero-santuary.png";
import tirupatiHero from "../assets/projects/tirupati/hero-tirupati.gif";
import pointoHero from "../assets/projects/pointo/cover.gif";
import serendipityHero from "../assets/projects/serendipity/hero-serendipidity.png";
import musibuddyHero from "../assets/projects/musibuddy/hero-musibuddy.gif";
import lab4cHero from "../assets/projects/lab4c/hero.jpeg";
import clickyHero from "../assets/projects/clicky/clicky.gif";

// Same categorization used for the bento grid's filter on index.astro,
// kept 1:1 so filtering behaves identically here.
const CATEGORIES: Record<string, string[]> = {
	"dot-threads": ["web-ux"],
	pointo: ["hardware-ux"],
	"hey-clicky": ["web-ux"],
	"prompt-nodes": ["web-ux"],
	lab4c: ["web-ux"],
	detour: ["mobile-ux"],
	serendipidity: ["mobile-ux"],
	piko: ["hardware-ux"],
};

const heroImages: Record<string, ImageMetadata> = {
	"hey-clicky": clickyHero,
	"dot-threads": dotThreadsHero,
	detour: deturHero,
	piko: pikoHero,
	"skywalk-sanctuary": sanctuaryHero,
	"working-living-innovating": tirupatiHero,
	pointo: pointoHero,
	serendipidity: serendipityHero,
	musibuddy: musibuddyHero,
	lab4c: lab4cHero,
};

const PROJECT_ORDER = [
	"dot-threads",
	"pointo",
	"hey-clicky",
	"prompt-nodes",
	"lab4c",
	"detour",
	"serendipidity",
	"piko",
];

const allProjects = (await getCollection("projects"))
	.filter((project) => Object.keys(CATEGORIES).includes(project.slug))
	.sort((a, b) => {
		const indexA = PROJECT_ORDER.indexOf(a.slug);
		const indexB = PROJECT_ORDER.indexOf(b.slug);
		return (indexA === -1 ? 99 : indexA) - (indexB === -1 ? 99 : indexB);
	});
---

<Layout
	title="Works (list prototype) | Narayan Ashanahalli"
	description="Prototype: an alternate list-style layout for the works section."
	fullWidth={true}
>
	<HomeNavigation />

	<div class="works-list-layout">
		<section class="hero-bio">
			<div class="bio-content">
				<div class="hero-headline bio-short">
					<div class="bio-line-1">
						<span class="dynamic-color-text"
							>👋 <br />I'm Narayan Ashanahalli,</span
						>
					</div>
					<div class="bio-line-1">
						<span class="dynamic-color-text"
							>a Product Designer & Prototyper</span
						>
					</div>
					<div class="bio-line-2">
						building <span style="white-space: nowrap;"
							>[0-to-1]</span
						> experiences across<br />AI, hardware, and digital
						infrastructure.
					</div>
				</div>
			</div>

			<div class="hero-actions-row">
				<div class="hero-actions-left">
					<div class="hero-actions">
						<a
							href="https://drive.google.com/file/d/1PcdJ52A1hec-0XFzHHCelg89N1d4cDHw/view?usp=sharing"
							target="_blank"
							rel="noopener noreferrer"
							class="action-link"
							>CV <svg
								viewBox="0 0 10 10"
								fill="none"
								xmlns="http://www.w3.org/2000/svg"
								class="arrow-svg arrow-up-right"
								><path d="M2 8L8 2M8 2H4M8 2V6"></path></svg
							></a
						>

						<a href="#footer" class="action-link"
							>Contact <svg
								viewBox="0 0 10 10"
								fill="none"
								xmlns="http://www.w3.org/2000/svg"
								class="arrow-svg arrow-down-left"
								><path d="M8 2L2 8M2 8H6M2 8V4"></path></svg
							></a
						>
					</div>
				</div>
			</div>
		</section>

		<div class="works-deck-section">
			<div class="works-list-header-wrapper">
				<header class="works-list-header">
					<h1 class="works-list-title">Work</h1>
					<div class="works-list-filter">
						<WorksFilter />
					</div>
				</header>
				<div class="works-header-divider"></div>
			</div>

			<div class="works-list-rows" id="works-list-rows">
				{
					allProjects.map((project) => (
						<WorksListRow
							title={project.data.title}
							description={project.data.description}
							tags={project.data.tags}
							href={`/works/${project.slug}`}
							categories={CATEGORIES[project.slug]}
							image={project.data.heroImage}
							meta={project.data.meta}
						/>
					))
				}
			</div>

			<div
				class="home-project-list works-mobile-cards"
				id="works-mobile-cards"
			>
				{
					allProjects.map((project) => (
						<div
							class="project-card-wrapper"
							data-categories={(
								CATEGORIES[project.slug] || []
							).join(" ")}
						>
							<HomeProjectCard
								title={project.data.title}
								image={
									heroImages[project.slug] ||
									project.data.heroImage
								}
								loading="lazy"
								href={`/works/${project.slug}`}
								tags={project.data.tags}
								meta={project.data.meta}
								description={project.data.description}
								categories={CATEGORIES[project.slug] || []}
							/>
						</div>
					))
				}
			</div>
		</div>

		<Footer />
		<div class="game-bottom-wrapper">
			<GhostRunner />
		</div>
	</div>

	<div class="toggle-floater">
		<div class="sidebar-controls">
			<ThemeToggle />
		</div>
	</div>
</Layout>

<style>
	.works-list-layout {
		/* Single source of truth for the centered content column shared by the
		   hero bio, the works header, and the rows strip. */
		--content-col: 750px;
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
		padding: 450px 48px 0;
		margin: 0;
		background: var(--bg-primary);
		min-height: 100vh;
	}

	.hero-bio {
		max-width: var(--content-col);
		margin: 0 auto 40px;
	}

	.hero-headline {
		max-width: 100%;
		font-weight: 300;
		letter-spacing: 0em;
		color: var(--pure-bg-inverse);
	}

	.bio-content {
		position: relative;
	}

	.bio-short {
		width: 100%;
		display: block;
		font-family: "Google Sans", sans-serif;
		font-weight: 300;
		letter-spacing: -0.05em;
		text-align: left;
	}

	.bio-line-1 {
		font-family: "Google Sans", sans-serif;
		font-size: 36px;
		font-weight: 350;
		letter-spacing: -0.02em;
		line-height: 1.04;
		margin-bottom: 2px;
	}

	.dynamic-color-text {
		color: #42be4a;
		transition: color 0.4s ease;
	}

	.bio-line-2 {
		font-family: "Google Sans", sans-serif;
		font-size: 36px;
		font-weight: 350;
		letter-spacing: -0.02em;
		line-height: 1.04;
		color: var(--pure-bg-inverse);
	}

	.hero-actions-row {
		display: flex;
		/* Only one child here, so space-between would pin it left. */
		justify-content: flex-end;
		align-items: flex-start;
		flex-wrap: wrap;
		gap: 3rem;
		margin-top: 0.75rem;
		width: 100%;
		box-sizing: border-box;
	}

	.hero-actions-left {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.25rem;
	}

	/* Mirrors index.astro's computed .hero-actions: its later rule overrides
	   display/justify-content/gap but not flex-direction, so the homepage
	   stacks CV above Contact. */
	.hero-actions {
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		align-items: flex-end;
		gap: 0.2rem;
		margin-top: 0.25rem;
	}

	.action-link {
		color: var(--text-secondary);
		font-size: 14px;
		text-decoration: none;
		position: relative;
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		font-family: "Bricolage Grotesque", sans-serif;
		font-weight: 400;
		letter-spacing: 0em;
		display: inline-flex;
		align-items: center;
		line-height: 1;
		gap: 0.25rem;
		transition: color 0.2s ease;
	}

	.action-link:hover {
		color: var(--accent-secondary);
	}

	.action-link::after {
		content: "";
		position: absolute;
		bottom: -2px;
		left: 0;
		width: 100%;
		height: 1px;
		background-color: var(--accent-secondary);
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 0.3s ease;
	}

	.action-link:hover::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	@media (max-width: 768px) {
		.hero-actions-row {
			justify-content: flex-start !important;
		}
		.hero-actions-left,
		.hero-actions {
			align-items: flex-start !important;
		}
		.bio-greeting,
		.bio-line-1,
		.bio-line-2,
		.dynamic-color-text {
			font-size: 32px !important;
			font-weight: 350 !important;
			line-height: 0.98 !important;
			letter-spacing: -0.01em;
		}
		.action-link {
			font-size: 12px !important;
		}

		/* Mirrors index.astro's .works-header-sticky at this breakpoint: the
		   filter detaches from the header and floats above the bottom edge
		   instead of scrolling away with it. pointer-events are off on the
		   full-width box so it doesn't swallow taps on the rows beneath, and
		   back on for the control itself. */
		.works-list-filter {
			position: fixed;
			bottom: 24px;
			left: 16px;
			right: 16px;
			width: auto;
			z-index: 210;
			pointer-events: none;
		}

		.works-list-filter :global(*) {
			pointer-events: auto;
		}

		.toggle-floater {
			right: 16px !important;
		}
	}

	/* Scrolls away with the page like the hero bio — no sticky positioning and
	   no stacking context, so hovered row cards are never overlapped by it. */
	.works-list-header-wrapper {
		padding: 0 0 10px;
		margin-bottom: 0;
		width: 100%;
	}

	.works-list-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
		max-width: var(--content-col);
		margin: 0 auto;
	}

	/* .segmented-control insets its last tab by 4px padding + 1px border, so its
	   box edge sits 5px past the visible tab. Shift it out by that much and the
	   tab's right edge lands on the content column — level with the description
	   text and the row rules below.

	   transform, not a negative margin: the control is max-width: 100% inside a
	   width: 100% wrapper, so shrinking its margin box shrinks the wrapper too,
	   squeezing the control below its natural width and clipping "Mobile"
	   against its own overflow: hidden. A transform doesn't affect layout. */
	.works-list-filter :global(.segmented-control) {
		transform: translateX(5px);
	}

	.works-list-title {
		font-family: "Google Sans", sans-serif;
		font-size: 14px;
		font-weight: 500;
		color: var(--text-secondary);
		margin: 0;
		letter-spacing: -0.01em;
	}

	.works-header-divider {
		display: none;
	}

	.works-list-rows {
		/* The --content-col column (same as .works-list-header) plus a
		   --row-bleed gutter on each side. WorksListRow's own 20px inner padding
		   cancels the bleed back out, so titles/descriptions sit flush with the
		   header's "Works" label and filter pills while the hover card + rules
		   run wider. min()/max() keep the bleed from running off-screen once the
		   viewport is narrower than the content column. */
		--row-bleed: 10px;
		width: min(
			calc(var(--content-col) + var(--row-bleed) * 2),
			calc(100% + var(--row-bleed) * 2)
		);
		margin-left: max(
			calc((100% - var(--content-col)) / 2 - var(--row-bleed)),
			calc(var(--row-bleed) * -1)
		);
		overflow: visible;
		position: relative;
		z-index: 1;
	}

	/* Top rule lives on the first row (WorksListRow's :first-child::before) so it
	   paints above that row's opaque background instead of behind it. */

	.toggle-floater {
		position: fixed !important;
		bottom: 24px !important;
		right: 24px !important;
		top: auto !important;
		margin: 0 !important;
		padding: 0 !important;
		z-index: 9999 !important;
		width: auto;
		display: flex;
		justify-content: flex-end;
	}
	.sidebar-controls {
		display: flex;
		gap: 1rem;
		align-items: center;
	}

	.works-deck-section {
		position: relative;
		width: 100%;
	}

	:global(.works-list-layout) :global(.site-footer) {
		width: calc(100% + 96px) !important;
		margin-left: -48px !important;
		margin-right: -48px !important;
		margin-top: 450px;
	}

	.works-mobile-cards {
		display: none;
	}

	.game-bottom-wrapper {
		position: relative;
		width: calc(100% + 96px);
		margin-left: -48px;
		margin-top: 0px;
		margin-bottom: 0px;
		z-index: 0;
	}

	.game-bottom-wrapper :global(.ghost-game-container) {
		border-radius: 0;
		border: none;
		border-top: 1px solid var(--border-subtle);
		width: 100%;
	}

	@media (max-width: 768px) {
		.works-list-title {
			font-size: 12px !important;
		}
		.works-list-header-wrapper {
			padding: 0 !important;
		}
		.works-list-layout {
			padding: 280px 24px 0 !important;
		}
		:global(.works-list-layout) :global(.site-footer) {
			width: calc(100% + 48px) !important;
			margin-left: -24px !important;
			margin-right: -24px !important;
			margin-top: 80px !important;
		}
		.game-bottom-wrapper {
			width: calc(100% + 48px);
			margin-left: -24px;
		}
		.works-header-divider {
			display: block;
			height: 1px;
			background: var(--border-subtle);
			width: calc(100% + 48px);
			margin-left: -24px;
			margin-right: -24px;
			margin-top: 20px;
			margin-bottom: 24px;
		}
		.works-list-rows {
			display: none !important;
		}
		.works-mobile-cards {
			display: flex !important;
			flex-direction: column;
			gap: 0;
			width: 100%;
			margin-top: 8px;
			padding-bottom: 40px;
		}

		.works-mobile-cards .project-card-wrapper {
			position: relative;
			will-change: margin-top;
		}

		.works-mobile-cards .project-card-wrapper:not(:first-child) {
			margin-top: var(--card-margin-top, -160px);
		}

		/* Mobile Unstacking Cards: Top Rounded, Sharp Bottom Corners with Clean 10px Flex Gap */
		.works-mobile-cards :global(.home-project-card) {
			display: flex !important;
			flex-direction: column !important;
			gap: 10px !important;
			border-radius: var(--radius-md) var(--radius-md) 0 0 !important;
			padding: 10px !important;
			backdrop-filter: blur(16px) !important;
			-webkit-backdrop-filter: blur(16px) !important;
			transition: background 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease !important;
		}

		.works-mobile-cards :global(.card-meta-panel) {
			overflow: visible !important;
		}

		.works-mobile-cards :global(.card-image-panel) {
			border: none !important;
		}

		/* DEFAULT (Dark Mode): Surface Fill with Subtle 1px Border */
		.works-mobile-cards :global(.home-project-card) {
			background: #141417 !important;
			border: 1px solid var(--border-subtle, rgba(255, 255, 255, 0.15)) !important;
			box-shadow:
				inset 0 1px 0 rgba(255, 255, 255, 0.1),
				0 12px 28px -6px rgba(0, 0, 0, 0.3) !important;
		}

		.works-mobile-cards :global(.meta-project-title) {
			font-size: 32px !important;
			color: #ffffff !important;
			margin-bottom: 0 !important;
		}

		.works-mobile-cards :global(.meta-description) {
			font-size: 12px !important;
			color: #e2e4dc !important;
			opacity: 0.95 !important;
			font-weight: 400 !important;
			margin: 0 !important;
		}

		.works-mobile-cards :global(.meta-tags) {
			margin: 0 !important;
		}

		/* Tag Bento Chips: Category Text & Background Tint with Original Subtle Border */
		.works-mobile-cards :global(.meta-tag) {
			font-weight: 500 !important;
			text-transform: lowercase !important;
			border-radius: var(--radius-sm) !important;
			border: 1px solid rgba(255, 255, 255, 0.18) !important;
			display: inline-flex !important;
			align-items: center !important;
			justify-content: center !important;
			line-height: 1 !important;
			padding: 6px !important;
			box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.15) !important;
		}

		.works-mobile-cards :global(.home-project-card[data-categories~="hardware-ux"] .meta-tag) {
			color: #82c6f6 !important;
			background: rgba(85, 158, 213, 0.18) !important;
		}
		.works-mobile-cards :global(.home-project-card[data-categories~="web-ux"] .meta-tag) {
			color: #ff7e36 !important;
			background: rgba(224, 81, 5, 0.18) !important;
		}
		.works-mobile-cards :global(.home-project-card[data-categories~="mobile-ux"] .meta-tag) {
			color: #ffe53b !important;
			background: rgba(255, 229, 59, 0.22) !important;
		}
		.works-mobile-cards :global(.home-project-card[data-categories~="spatial-xd"] .meta-tag) {
			color: #61d56e !important;
			background: rgba(37, 136, 53, 0.18) !important;
		}

		.works-mobile-cards :global(.meta-tag:nth-child(n + 3)) {
			display: none !important;
		}

		.works-mobile-cards :global(.meta-divider) {
			border-top-color: rgba(255, 255, 255, 0.16) !important;
			margin: 0 !important;
		}

		/* LIGHT MODE: Light Surface (#ffffff / #e9ebe4) & Subtle 1px Grey Border */
		:global([data-theme="light"])
			.works-mobile-cards
			:global(.home-project-card) {
			background: var(--bg-surface, #ffffff) !important;
			border: 1px solid var(--border-subtle, rgba(0, 0, 0, 0.15)) !important;
			box-shadow:
				inset 0 1px 0 rgba(255, 255, 255, 0.9),
				0 2px 8px rgba(0, 0, 0, 0.05) !important;
		}

		:global([data-theme="light"]) .works-mobile-cards :global(.meta-tag) {
			border: 1px solid rgba(0, 0, 0, 0.08) !important;
			box-shadow: none !important;
		}

		:global([data-theme="light"])
			.works-mobile-cards
			:global(.home-project-card[data-categories~="hardware-ux"] .meta-tag) {
			color: #0066b3 !important;
			background: rgba(85, 158, 213, 0.12) !important;
		}
		:global([data-theme="light"])
			.works-mobile-cards
			:global(.home-project-card[data-categories~="web-ux"] .meta-tag) {
			color: #c43e00 !important;
			background: rgba(224, 81, 5, 0.12) !important;
		}
		:global([data-theme="light"])
			.works-mobile-cards
			:global(.home-project-card[data-categories~="mobile-ux"] .meta-tag) {
			color: #8c7200 !important;
			background: rgba(230, 185, 0, 0.16) !important;
		}
		:global([data-theme="light"])
			.works-mobile-cards
			:global(.home-project-card[data-categories~="spatial-xd"] .meta-tag) {
			color: #176020 !important;
			background: rgba(37, 136, 53, 0.12) !important;
		}

		:global([data-theme="light"])
			.works-mobile-cards
			:global(.meta-project-title) {
			color: #000000 !important;
		}

		:global([data-theme="light"])
			.works-mobile-cards
			:global(.meta-description) {
			color: #222222 !important;
			opacity: 0.95 !important;
		}

		:global([data-theme="light"]) .works-mobile-cards :global(.meta-tag) {
			color: #0a0a0a !important;
			background: rgba(0, 0, 0, 0.05) !important;
			border-color: rgba(0, 0, 0, 0.08) !important;
			box-shadow: none !important;
		}

		:global([data-theme="light"])
			.works-mobile-cards
			:global(.meta-divider) {
			border-top-color: rgba(0, 0, 0, 0.12) !important;
		}
	}

	@media (max-width: 640px) {
		.works-list-layout {
			padding: 260px 16px 0 !important;
		}
		.works-list-header {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--space-sm);
		}
		/* Width comes from the fixed left/right pair set at 768px — setting it
		   here too would over-constrain the box and blow past the right inset. */
		/* The 5px nudge exists only to line the last tab up with the content
		   column's right edge; once centred it just throws the control off. */
		.works-list-filter :global(.segmented-control) {
			transform: none;
		}
		:global(.works-list-layout) :global(.site-footer) {
			width: calc(100% + 32px) !important;
			margin-left: -16px !important;
			margin-right: -16px !important;
			margin-top: 80px !important;
		}
		.game-bottom-wrapper {
			width: calc(100% + 32px);
			margin-left: -16px;
		}
		.works-header-divider {
			width: calc(100% + 32px);
			margin-left: -16px;
			margin-right: -16px;
			margin-top: 20px;
			margin-bottom: 24px;
		}
	}
</style>

<script>
	// Lightweight filter: show/hide rows and mobile cards by category only
	function setupWorksListFilter() {
		const rows = Array.from(
			document.querySelectorAll("[data-categories]"),
		) as HTMLElement[];

		function applyFilter(filter: string) {
			rows.forEach((row) => {
				const categories = (
					row.getAttribute("data-categories") || ""
				).split(" ");
				const matches = filter === "all" || categories.includes(filter);
				row.style.display = matches ? "" : "none";
			});
		}

		const hash = window.location.hash.slice(1);
		const validFilters = ["hardware-ux", "web-ux", "mobile-ux"];
		applyFilter(validFilters.includes(hash) ? hash : "all");

		window.addEventListener("works-filter-change", (e) => {
			const filter = (e as CustomEvent).detail?.filter || "all";
			applyFilter(filter);
		});
	}

	setupWorksListFilter();
	document.addEventListener("astro:page-load", setupWorksListFilter);

	// Line the rows' description column up with the filter control's left edge.
	// The control is content-sized, so its width has to be measured rather than
	// assumed — it shifts with the label text and with the loaded font.
	function syncDescColumn() {
		const rows = document.getElementById("works-list-rows");
		// The first tab, not the control itself — the control's own 4px padding
		// and 1px border sit outside the visible pill, and it's the pill edge
		// the description should line up with.
		const firstTab = document.querySelector(
			".segmented-control .filter-btn",
		);
		if (!rows || !firstTab) return;

		// Under 641px the header stacks, so the filter no longer defines an edge
		// for the rows to align to — drop back to the even split.
		if (window.innerWidth <= 640) {
			rows.style.removeProperty("--desc-col");
			return;
		}

		// Measure edge-to-edge rather than rebuilding the number from the
		// control's width plus its padding/border/transform offsets — the rect
		// already accounts for all of them, and the strip's right edge doesn't
		// move when --desc-col changes, so there's no feedback loop.
		const width =
			rows.getBoundingClientRect().right -
			firstTab.getBoundingClientRect().left;
		if (width > 0) {
			rows.style.setProperty("--desc-col", `${width}px`);
		}
	}

	syncDescColumn();
	document.addEventListener("astro:page-load", syncDescColumn);
	window.addEventListener("resize", syncDescColumn);
	if (document.fonts) document.fonts.ready.then(syncDescColumn);

	// Opening a card grows the list, which would push the footer — and the gap
	// above it — further down the page. Pin the container to its collapsed
	// height so an expanded card overflows into that gap (the strip is already
	// overflow: visible) rather than displacing anything below it.
	function lockRowsHeight() {
		const rows = document.getElementById("works-list-rows");
		if (!rows) return;

		// Never measure while a card is open, or the expanded height gets
		// baked in as the resting one.
		if (
			rows.querySelector(
				".works-list-row:hover, .works-list-row--expanded",
			)
		) {
			return;
		}

		rows.style.height = "auto";
		const height = rows.getBoundingClientRect().height;
		if (height > 0) rows.style.height = `${height}px`;
	}

	// Mirrors index.astro's updateWorksFilterPosition: the floating mobile
	// filter stops above the footer instead of sliding underneath it.
	function updateFloatingElements() {
		const filter = document.querySelector(
			".works-list-filter",
		) as HTMLElement | null;
		const toggle = document.querySelector(
			".toggle-floater",
		) as HTMLElement | null;
		const footer = document.querySelector(
			".site-footer",
		) as HTMLElement | null;

		const isMobile = window.matchMedia("(max-width: 768px)").matches;
		const RESTING = 24;
		const GAP = 24;

		let offset = RESTING;
		if (footer) {
			const footerTop = footer.getBoundingClientRect().top;
			const viewportHeight = window.innerHeight;
			if (footerTop < viewportHeight) {
				offset = viewportHeight - footerTop + GAP;
			}
		}

		if (filter) {
			if (isMobile) {
				filter.style.setProperty("bottom", `${offset}px`, "important");
			} else {
				filter.style.removeProperty("bottom");
			}
		}

		if (toggle) {
			toggle.style.setProperty("bottom", `${offset}px`, "important");
		}
	}

	updateFloatingElements();
	document.addEventListener("astro:page-load", updateFloatingElements);
	window.addEventListener("scroll", updateFloatingElements, {
		passive: true,
	});
	window.addEventListener("resize", updateFloatingElements);

	lockRowsHeight();
	document.addEventListener("astro:page-load", lockRowsHeight);
	window.addEventListener("resize", lockRowsHeight);
	// Filtering hides rows, so the collapsed height changes — re-measure after
	// the display changes have been applied.
	window.addEventListener("works-filter-change", () => {
		requestAnimationFrame(lockRowsHeight);
	});
	// Wrapping depends on the loaded font, so the first measurement can be off.
	if (document.fonts) document.fonts.ready.then(lockRowsHeight);

	// Bio text color follows the active filter, same as the homepage hero.
	function setupDynamicBioColor() {
		const FILTER_COLORS: Record<string, string> = {
			all: "#42BE4A",
			"hardware-ux": "#0D8CE9",
			"web-ux": "#F6631A",
			"mobile-ux": "#FACC09",
		};

		const dynamicTexts = document.querySelectorAll(".dynamic-color-text");
		if (dynamicTexts.length === 0) return;

		const hash = window.location.hash.slice(1);
		const initialColor = FILTER_COLORS[hash] || FILTER_COLORS["all"];
		dynamicTexts.forEach((el) => {
			(el as HTMLElement).style.color = initialColor;
		});

		window.addEventListener("works-filter-change", (e) => {
			const filter = (e as CustomEvent).detail?.filter || "all";
			const color = FILTER_COLORS[filter] || FILTER_COLORS["all"];
			document.querySelectorAll(".dynamic-color-text").forEach((el) => {
				(el as HTMLElement).style.color = color;
			});
		});
	}

	setupDynamicBioColor();
	document.addEventListener("astro:page-load", setupDynamicBioColor);

	// Smooth continuous scroll-driven card unstacking animation for mobile view
	function setupMobileCardScrollAnimation() {
		if (window.innerWidth > 768) return;
		const container = document.querySelector(".works-mobile-cards");
		if (!container) return;

		const cardWrappers = Array.from(
			container.querySelectorAll(".project-card-wrapper")
		);
		if (!cardWrappers.length) return;

		function updateGradualCardScroll() {
			const vh = window.innerHeight;
			const containerRect = container.getBoundingClientRect();

			// Distance container top has scrolled past 90% screen height
			const startThreshold = vh * 0.90;
			const scrolledDistance = startThreshold - containerRect.top;
			const cardInterval = 100;

			// Index by VISIBLE position, not DOM position. The filter hides
			// cards with display:none, so the first card still on screen can
			// sit at a later DOM index — by DOM index it would keep the -160px
			// stack offset and ride up over the filter bar.
			const visibleCards = cardWrappers.filter(
				(card) => (card as HTMLElement).offsetParent !== null
			);

			visibleCards.forEach((card, index) => {
				if (index === 0) {
					// First visible card sits at rest. Set it explicitly: the
					// CSS :not(:first-child) rule still applies whenever it
					// isn't also the first DOM child.
					(card as HTMLElement).style.setProperty(
						"--card-margin-top",
						"0px"
					);
					return;
				}

				const cardStart = (index - 1) * 70;
				const rawProgress = (scrolledDistance - cardStart) / cardInterval;
				const progress = Math.max(0, Math.min(1, rawProgress));

				// Smooth mathematical linear interpolation: -160px when stacked, 24px when unstacked
				const marginTop = -160 + progress * 184;
				(card as HTMLElement).style.setProperty(
					"--card-margin-top",
					`${marginTop}px`
				);
			});
		}

		window.addEventListener("scroll", updateGradualCardScroll, {
			passive: true,
		});
		window.addEventListener("resize", updateGradualCardScroll);
		// Which cards are visible changes with the filter, so re-index then too
		window.addEventListener("works-filter-change", () =>
			requestAnimationFrame(updateGradualCardScroll)
		);
		updateGradualCardScroll();
	}

	setupMobileCardScrollAnimation();
	document.addEventListener(
		"astro:page-load",
		setupMobileCardScrollAnimation,
	);

	// Interactive Bio Ghost Walker Animation (drifts across hero, drag & drop)
	function setupBioGhost() {
		const ghost = document.getElementById(
			"bio-ghost-walker",
		) as HTMLImageElement | null;
		const navLogo = document.querySelector(
			".home-nav-logo, #nav-logo-happy, .logo-circle, .logo-img-wrapper",
		) as HTMLElement | null;
		const heroSection = document.querySelector(
			".hero-bio, .hero",
		) as HTMLElement | null;
		if (!ghost || !navLogo || !heroSection) return;

		const HAPPY_FRAMES = [
			"/logos/happy 1.png",
			"/logos/happy 2.png",
			"/logos/happy 3.png",
		];
		const DEAD_FRAMES = [
			"/logos/dead 1.png",
			"/logos/dead 2.png",
			"/logos/dead 3.png",
		];

		const w = window as any;
		if (w._bioGhostFrameInterval) clearInterval(w._bioGhostFrameInterval);
		if (w._bioGhostRAF) cancelAnimationFrame(w._bioGhostRAF);
		if (w._bioGhostStartTimeout) clearTimeout(w._bioGhostStartTimeout);

		const SIZE = 52.5;
		const scrollYAtSetup = window.scrollY;
		const toViewportY = (docY: number) =>
			docY - (window.scrollY - scrollYAtSetup);

		const logoRect = navLogo.getBoundingClientRect();
		const START_X = logoRect.left + (logoRect.width - SIZE) / 2;
		const START_Y =
			logoRect.top + (logoRect.height - SIZE) / 2 + window.scrollY;

		const heroRect = heroSection.getBoundingClientRect();
		const heroLeftX = heroRect.left;
		const heroRightX = heroRect.right;

		const clampX = (val: number) =>
			Math.max(heroLeftX, Math.min(val, heroRightX - SIZE));
		const clampY = (val: number) =>
			Math.max(0, Math.min(val, heroRect.bottom + window.scrollY - SIZE));

		ghost.style.transform = `translate(${START_X}px, ${toViewportY(START_Y)}px)`;

		let baseX = START_X;
		let anchorY = START_Y;
		let targetAnchorY = START_Y;
		let lastTime = performance.now();
		let elapsed = 0;
		let frameIndex = 0;

		let phX1 = Math.random() * Math.PI * 2;
		let phX2 = Math.random() * Math.PI * 2;
		let phY1 = Math.random() * Math.PI * 2;
		let phY2 = Math.random() * Math.PI * 2;
		let speedPhase = Math.random() * Math.PI * 2;
		let isDragging = false;
		let hasLaunched = false;

		const tick = (now: number) => {
			if (!document.contains(ghost)) return;

			const dt = Math.min((now - lastTime) / 1000, 0.05);
			lastTime = now;

			if (!hasLaunched) {
				ghost.style.transform = `translate(${START_X}px, ${toViewportY(START_Y)}px)`;
				w._bioGhostRAF = requestAnimationFrame(tick);
				return;
			}

			elapsed += dt;

			if (baseX >= heroRightX - SIZE - 4) {
				baseX = heroLeftX;
			}

			if (!isDragging) {
				const currentSpeed = 30 + Math.sin(elapsed * 0.8 + speedPhase) * 12;
				baseX = clampX(baseX + currentSpeed * dt);

				const wobbleX =
					Math.sin(elapsed * 2.1 + phX1) * 3 +
					Math.sin(elapsed * 0.9 + phX2) * 2;
				const wobbleY =
					Math.sin(elapsed * 1.7 + phY1) * 4 +
					Math.cos(elapsed * 0.8 + phY2) * 2.5;

				anchorY += (targetAnchorY - anchorY) * Math.min(dt * 3, 1);
				const y = clampY(anchorY + wobbleY);
				ghost.style.transform = `translate(${baseX + wobbleX}px, ${toViewportY(y)}px)`;
			}

			w._bioGhostRAF = requestAnimationFrame(tick);
		};

		lastTime = performance.now();
		w._bioGhostRAF = requestAnimationFrame(tick);

		const startFrameCycle = (frameList: string[]) => {
			if (w._bioGhostFrameInterval) clearInterval(w._bioGhostFrameInterval);
			ghost.src = frameList[frameIndex % frameList.length];
			w._bioGhostFrameInterval = window.setInterval(() => {
				frameIndex++;
				ghost.src = frameList[frameIndex % frameList.length];
			}, 180);
		};

		let dragOffsetX = 0;
		let dragOffsetY = 0;

		ghost.addEventListener("pointerdown", (e: PointerEvent) => {
			isDragging = true;
			ghost.setPointerCapture(e.pointerId);

			const rect = ghost.getBoundingClientRect();
			dragOffsetX = e.clientX - rect.left;
			dragOffsetY = e.clientY - rect.top;

			startFrameCycle(DEAD_FRAMES);
		});

		ghost.addEventListener("pointermove", (e: PointerEvent) => {
			if (!isDragging) return;
			baseX = clampX(e.clientX - dragOffsetX);
			const docY =
				e.clientY - dragOffsetY + (window.scrollY - scrollYAtSetup);
			anchorY = clampY(docY);
			targetAnchorY = anchorY;
			ghost.style.transform = `translate(${baseX}px, ${toViewportY(anchorY)}px)`;
		});

		const endDrag = (e: PointerEvent) => {
			if (!isDragging) return;
			isDragging = false;
			try {
				ghost.releasePointerCapture(e.pointerId);
			} catch (_) {}

			hasLaunched = true;
			clearTimeout(w._bioGhostStartTimeout);
			startFrameCycle(HAPPY_FRAMES);
		};

		ghost.addEventListener("pointerup", endDrag);
		ghost.addEventListener("pointercancel", endDrag);

		w._bioGhostStartTimeout = window.setTimeout(() => {
			hasLaunched = true;
			if (isDragging) return;
			startFrameCycle(HAPPY_FRAMES);
		}, 2000);
	}

	setupBioGhost();
	document.addEventListener("astro:page-load", setupBioGhost);
</script>
