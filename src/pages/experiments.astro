<script>
  function setupTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>(".sidebar-tab");
    const panels = document.querySelectorAll<HTMLElement>(".tab-panel");

    tabs.forEach((tab) => {
      if (tab.dataset.bound) return;
      tab.dataset.bound = "1";

      tab.addEventListener("click", () => {
        const targetTab = tab.getAttribute("data-tab");
        if (!targetTab) return;

        tabs.forEach((t) => t.classList.remove("active"));
        panels.forEach((p) => p.classList.remove("active"));

        tab.classList.add("active");

        const targetPanel = document.querySelector<HTMLElement>(
          `.tab-panel[data-tab-panel="${targetTab}"]`
        );
        if (targetPanel) {
          targetPanel.classList.add("active");
        }

        window.dispatchEvent(
          new CustomEvent("experiments-tab-change", { detail: { tab: targetTab } })
        );
      });
    });
  }

  // ---------------------------------------------------------------------
  // Card Deck Stack
  //
  // The header and cards pin together as one block (.deck-exp-stage) inside a
  // tall runway container. So a card that has converted HOLDS its position
  // while later cards convert, and only when the runway is spent does the
  // whole block release and leave as a unit.
  //
  // Rows are absolutely slotted at i * step instead of sitting in flow. That
  // kills the feedback loop that caused every earlier bug: an opening card
  // cannot push the cards below it, so nothing it does can perturb the scroll
  // progress that drives it. Overlap becomes exact rather than emergent.
  //
  // `step` is fitted to the viewport, not hardcoded. Six cards at their full
  // 30% height need ~1300px; a laptop has ~720px. Rather than pick a constant
  // that only works on one screen, the step is whatever lets the last card
  // open fully with the rest still stacked above it, capped at the card's own
  // 30% height (past that they would separate and leave gaps). The surplus of
  // step over a card's header is how much of each body stays visible — so the
  // real lever on that is the height of the card content, not this number.
  //
  // Progress is one scalar: how far we have scrolled into the pinned runway.
  // Card i converts across [i * CONVERT, (i+1) * CONVERT]; the last card then
  // runs on across RUNWAY to open fully.
  // ---------------------------------------------------------------------
  let deckTeardown: (() => void) | null = null;

  function setupDeckExperiment() {
    deckTeardown?.();
    deckTeardown = null;

    const container = document.querySelector<HTMLElement>(".deck-exp-container");
    const list = document.getElementById("deck-exp-rows");
    const headerWrapper = document.querySelector<HTMLElement>(".deck-exp-header-wrapper");
    if (!container || !list || !headerWrapper) return;

    const NAV_TOP = 64; // fixed site nav top bar offset
    const PEEK_RATIO = 0.30; // 30% reveal expansion
    const HOVER_EASE = 0.22;

    interface Model {
      el: HTMLElement;
      reveal: HTMLElement;
      revealH: number;
      chromeH: number;
      hover: number;
      hoverTarget: number;
      progress: number;
    }

    let models: Model[] = [];
    let isAnimating = false;
    let rafId = 0;

    function visibleRows() {
      return Array.from(list!.querySelectorAll<HTMLElement>(".deck-exp-row")).filter(
        (r) => r.style.display !== "none"
      );
    }

    function measure() {
      const rowEls = visibleRows();
      const headerH = headerWrapper!.offsetHeight || 57;

      let accumulatedStickyTop = NAV_TOP + headerH;

      models = rowEls.map((rowEl, i) => {
        rowEl.style.setProperty("--stack-index", `${i + 1}`);

        const reveal = rowEl.querySelector<HTMLElement>(".deck-exp-row__reveal")!;
        reveal.style.maxHeight = "none";
        const revealH = reveal.scrollHeight;
        const chromeH = rowEl.offsetHeight - reveal.offsetHeight;
        const expandedH = chromeH + PEEK_RATIO * revealH;

        // Position each card stickily below the preceding cards' expanded headers
        rowEl.style.position = "sticky";
        rowEl.style.top = `${Math.round(accumulatedStickyTop)}px`;

        accumulatedStickyTop += expandedH;

        const prevHover = models[i]?.hover ?? 0;
        const prevProgress = models[i]?.progress ?? 0;

        return {
          el: rowEl,
          reveal,
          revealH,
          chromeH,
          hover: prevHover,
          hoverTarget: prevHover,
          progress: prevProgress
        };
      });

      if (models.length > 0) {
        // Set total container scroll length so sticky release happens after the stack completes
        const totalDeckH = accumulatedStickyTop - NAV_TOP;
        container!.style.minHeight = `${Math.round(totalDeckH + 240)}px`;
      }

      updateTargets();
      renderReveals();
    }

    function updateTargets() {
      models.forEach((m) => {
        const rect = m.el.getBoundingClientRect();
        const stickyTop = parseFloat(m.el.style.top || "0");
        
        // Distance from card to its assigned sticky top line
        const dist = stickyTop - rect.top;
        // Card smoothly unfolds to 30% preview as it reaches its sticky top line
        const p = Math.min(1, Math.max(0, (dist + 60) / 120));
        m.progress = p;

        m.hoverTarget = m.el.matches(":hover") ? 1 : 0;
      });
    }

    function renderReveals() {
      models.forEach((m) => {
        const targetRatio = m.progress * PEEK_RATIO;
        const effectiveRatio = targetRatio + m.hover * (1 - targetRatio);
        
        m.reveal.style.maxHeight = `${Math.round(effectiveRatio * m.revealH)}px`;
        m.el.classList.toggle("deck-exp-row--carded", effectiveRatio > 0.05);
      });
    }

    function step() {
      updateTargets();
      
      let needsNextFrame = false;
      models.forEach((m) => {
        const diff = m.hoverTarget - m.hover;
        if (Math.abs(diff) > 0.001) {
          m.hover += diff * HOVER_EASE;
          if (Math.abs(m.hoverTarget - m.hover) < 0.002) m.hover = m.hoverTarget;
          else needsNextFrame = true;
        }
      });

      renderReveals();

      if (needsNextFrame) {
        rafId = requestAnimationFrame(step);
      } else {
        isAnimating = false;
      }
    }

    function requestUpdate() {
      if (!isAnimating) {
        isAnimating = true;
        rafId = requestAnimationFrame(step);
      }
    }

    function onFilterClick(this: HTMLElement) {
      const cat = this.getAttribute("data-filter");
      filterBtns.forEach((b) => b.classList.toggle("active", b === this));

      list!.querySelectorAll<HTMLElement>(".deck-exp-row").forEach((r) => {
        r.style.display = cat === "all" || r.getAttribute("data-category") === cat ? "" : "none";
      });

      measure();
    }

    const filterBtns = Array.from(document.querySelectorAll<HTMLElement>(".deck-filter-btn"));
    filterBtns.forEach((btn) => btn.addEventListener("click", onFilterClick));

    list.querySelectorAll(".deck-exp-row").forEach((row) => {
      row.addEventListener("mouseenter", requestUpdate, { passive: true });
      row.addEventListener("mouseleave", requestUpdate, { passive: true });
    });

    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", measure);
    window.addEventListener("experiments-tab-change", measure);

    measure();

    deckTeardown = () => {
      cancelAnimationFrame(rafId);
      isAnimating = false;
      filterBtns.forEach((btn) => btn.removeEventListener("click", onFilterClick));
      window.removeEventListener("scroll", requestUpdate);
      window.removeEventListener("resize", measure);
      window.removeEventListener("experiments-tab-change", measure);
    };
  }

  function init() {
    setupTabs();
    setupDeckExperiment();
  }

  document.addEventListener("DOMContentLoaded", init);
  document.addEventListener("astro:page-load", init);
</script>

