      <!-- Tab Panel 3: Image Slider -->
      <section class="tab-panel" data-tab-panel="slider">
        <header class="experiments-header">
          <h1 class="experiments-title">Image Slider</h1>
          <p class="experiments-subtitle">3 ways to handle mixed portrait/landscape slides in the About page carousel. Same 5 photos in each.</p>
        </header>

        <div class="experiments-list slider-list">
          <section class="experiment-card" id="slider-opt-1">
            <div class="card-header">
              <span class="option-badge">01</span>
              <h2>Adaptive Frame</h2>
              <p>The frame matches each slide's own shape.</p>
            </div>
            <div class="slider-stage">
              <ImageSlider
                slides={sliderTestSlides}
                variant="carousel"
                indicatorType="dots"
                frameStrategy="adaptive"
                constrain={false}
              />
            </div>
          </section>

          <section class="experiment-card" id="slider-opt-2">
            <div class="card-header">
              <span class="option-badge">02</span>
              <h2>Blurred Letterbox</h2>
              <p>Fixed frame, blurred fill behind portrait slides.</p>
            </div>
            <div class="slider-stage">
              <ImageSlider
                slides={sliderTestSlides}
                variant="carousel"
                indicatorType="dots"
                frameStrategy="letterbox"
                constrain={false}
              />
            </div>
          </section>

          <section class="experiment-card" id="slider-opt-3">
            <div class="card-header">
              <span class="option-badge">03 · Recommended</span>
              <h2>Orientation-Aware Split</h2>
              <p>Landscape stays full-bleed, portrait shrinks to fit.</p>
            </div>
            <div class="slider-stage">
              <ImageSlider
                slides={sliderTestSlides}
                variant="carousel"
                indicatorType="dots"
                frameStrategy="split"
                constrain={false}
              />
            </div>
          </section>
        </div>
      </section>

      <!-- Tab Panel 4: Card Deck Stack Sandbox (DEFAULT ACTIVE) -->
      <section class="tab-panel active" data-tab-panel="deck">
        <header class="experiments-header">
          <h1 class="experiments-title">Card Deck Stack Sandbox</h1>
          <p class="experiments-subtitle">
            Only the Works header pins. Each flat list row converts to a vibrant card and opens to 30% of its body as it crosses the trigger line below the header, then holds there and scrolls away with the page &mdash; cards sit edge to edge with their whole 30% visible, and the upward shadow from each card onto the one before it is what reads as a deck. Sequencing is self-correcting: opening a card pushes the next one down, which is exactly what delays its own turn. The last card runs on past 30% to fully open. Hover any card to open it without disturbing the ones below.
          </p>
        </header>

        <div class="deck-exp-container">
          <div class="deck-exp-stage">
          <div class="deck-exp-header-wrapper">
