                <div class="footer-divider"></div>
                <div class="footer-content">
                  <div class="footer-left">
                    <p class="contact-message">Let's build something worth caring about. Say hi! 👀</p>
                    <div class="contact-buttons">
                      <button class="demo-btn">hello@narayan.works</button>
                      <button class="demo-btn">412-626-2332</button>
