  /* ── Card Deck Stack Sandbox ──────────────────────────────────────────
     Only the Works header is sticky. The rows stay in normal flow and simply
     open as they pass the trigger line, so each card's full 30% height stays
     visible — they sit edge to edge rather than clipping one another, and the
     upward shadow from the card below is what reads as a stacked deck. */
  /* The container is pure scroll runway; its height (set in JS) is how much
     scrolling the deck consumes while it assembles. */
  .deck-exp-container {
    position: relative;
    width: 100%;
    max-width: 880px;
    margin: 0 auto;
    overflow-anchor: none;
  }

  /* Header and cards pin together as one block, so a converted card holds its
     position instead of scrolling away while later cards convert. When the
     container's runway runs out the whole block releases and leaves as a unit. */
  .deck-exp-stage {
    position: relative;
    width: 100%;
  }

