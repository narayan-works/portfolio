<script>
  function setupThemePicker() {
    const chips = document.querySelectorAll('.theme-chip');
    const wrappers = document.querySelectorAll('.footer-preview-wrapper:not(.light-mode-wrapper)');
    const containers = document.querySelectorAll('.ascii-canvas-container:not(#option-2-light-canvas-container)');

    const lightContainer = document.querySelector('#option-2-light-canvas-container');
    if (lightContainer) {
      lightContainer.setAttribute('data-color', '#2E7D32');
      lightContainer.setAttribute('data-bg', '#F4F0EA');
      lightContainer.setAttribute('data-highlight', '#000000');
      lightContainer.setAttribute('data-mode', 'light');
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');

        const color = chip.getAttribute('data-color') || '#42BD49';
        const bg = chip.getAttribute('data-bg') || '#0a0a0a';
        const highlight = chip.getAttribute('data-highlight') || '#FFFFFF';

        containers.forEach((container) => {
          container.setAttribute('data-color', color);
          container.setAttribute('data-bg', bg);
          container.setAttribute('data-highlight', highlight);
        });

        wrappers.forEach((wrapper) => {
          (wrapper as HTMLElement).style.backgroundColor = bg;
        });
      });
    });
  }

  function setupExperimentTabs() {
    const tabButtons = document.querySelectorAll('.sidebar-tab');
    const panels = document.querySelectorAll('.tab-panel');
    if (!tabButtons.length) return;

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-tab');
        tabButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        panels.forEach((panel) => {
          panel.classList.toggle('active', panel.getAttribute('data-tab-panel') === target);
        });
        // Sliders mounted inside a display:none panel measure their
        // segmented-control pill at 0 width on init; re-dispatch resize
        // once the panel is actually visible so it re-measures correctly.
        window.dispatchEvent(new Event('resize'));
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupThemePicker);
  document.addEventListener('astro:page-load', setupThemePicker);
  document.addEventListener('DOMContentLoaded', setupExperimentTabs);
  document.addEventListener('astro:page-load', setupExperimentTabs);
</script>

