---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Typography Specs Audit & Playground" fullWidth={true}>
    <div class="playground-container">
        <!-- Control Panel Sidebar -->
        <aside class="control-panel">
            <div class="panel-header">
                <h2>Typography Audit</h2>
                <p>Dynamically adjust font sizes, weights (thickness), and spacings to tune your layout. Click copy at the bottom to export variables.</p>
            </div>

            <div class="control-group">
                <h3>Font Family Selector</h3>
                <div class="slider-item">
                    <label>
                        <span>Title Font</span>
                    </label>
                    <select id="select-font-title" class="font-select">
                        <option value="geist">Geist (Default)</option>
                        <option value="google-sans">Google Sans</option>
                        <option value="public-sans">Public Sans</option>
                        <option value="noto-sans">Noto Sans</option>
                        <option value="general-sans">General Sans</option>
                        <option value="inter">Inter</option>
                        <option value="instrument-sans">Instrument Sans</option>
                        <option value="serif">System Serif</option>
                        <option value="nunito-sans">Nunito Sans</option>
                        <option value="ibm-plex">IBM Plex Sans</option>
                        <option value="bricolage-grotesque">Bricolage Grotesque</option>
                        <option value="open-sans">Open Sans</option>
                    </select>
                </div>
                <div class="slider-item" style="margin-top: 12px;">
                    <label>
                        <span>Body Font</span>
                    </label>
                    <select id="select-font-body" class="font-select">
                        <option value="geist">Geist (Default)</option>
                        <option value="google-sans">Google Sans</option>
                        <option value="public-sans">Public Sans</option>
                        <option value="noto-sans">Noto Sans</option>
                        <option value="general-sans">General Sans</option>
                        <option value="inter">Inter</option>
                        <option value="instrument-sans">Instrument Sans</option>
                        <option value="serif">System Serif</option>
                        <option value="nunito-sans">Nunito Sans</option>
                        <option value="ibm-plex">IBM Plex Sans</option>
                        <option value="bricolage-grotesque">Bricolage Grotesque</option>
                        <option value="open-sans">Open Sans</option>
                    </select>
                </div>
            </div>

            <div class="control-group">
                <h3>Global Base</h3>
                <div class="slider-item">
                    <label>
                        <span>Base Font Size</span>
                        <span class="value-display" id="val-base-px">18px</span>
                    </label>
                    <input type="range" id="input-base-px" min="14" max="24" value="18" step="1" />
                    <span class="helper">Controls proportional scaling of all <code>rem</code> units.</span>
                </div>
            </div>

            <div class="control-group">
                <h3>Titles & Headings (Geist Sans)</h3>
                <div class="slider-item">
                    <label>
                        <span>H2 Title Size</span>
                        <span class="value-display" id="val-title-size">2.667rem</span>
                    </label>
                    <input type="range" id="input-title-size" min="1.5" max="4.0" value="2.667" step="0.05" />
                </div>
                <div class="slider-item">
                    <label>
                        <span>Title Weight (Thickness)</span>
                        <span class="value-display" id="val-title-weight">800</span>
                    </label>
                    <input type="range" id="input-title-weight" min="100" max="900" value="800" step="100" />
                </div>
                <div class="slider-item">
                    <label>
                        <span>Title Letter Spacing</span>
                        <span class="value-display" id="val-title-spacing">-0.025em</span>
                    </label>
                    <input type="range" id="input-title-spacing" min="-0.08" max="0.05" value="-0.025" step="0.005" />
                </div>
            </div>

            <div class="control-group">
                <h3>Body Paragraphs (Geist Sans)</h3>
                <div class="slider-item">
                    <label>
                        <span>Body Size</span>
                        <span class="value-display" id="val-body-size">1rem</span>
                    </label>
                    <input type="range" id="input-body-size" min="0.8" max="1.5" value="1" step="0.05" />
                </div>
                <div class="slider-item">
                    <label>
                        <span>Body Weight (Thickness)</span>
                        <span class="value-display" id="val-body-weight">300</span>
                    </label>
                    <input type="range" id="input-body-weight" min="100" max="900" value="300" step="100" />
                </div>
                <div class="slider-item">
                    <label>
                        <span>Body Line Spacing</span>
                        <span class="value-display" id="val-body-lh">1.5</span>
                    </label>
                    <input type="range" id="input-body-lh" min="1.1" max="2.0" value="1.5" step="0.05" />
                </div>
                <div class="slider-item">
                    <label>
                        <span>Body Letter Spacing</span>
                        <span class="value-display" id="val-body-spacing">0em</span>
                    </label>
                    <input type="range" id="input-body-spacing" min="-0.05" max="0.1" value="0" step="0.005" />
                </div>
            </div>

            <div class="control-group">
                <h3>Tags & Mono Text (Geist Mono)</h3>
                <div class="slider-item">
                    <label>
                        <span>Tag Size</span>
                        <span class="value-display" id="val-tag-size">0.667rem</span>
                    </label>
                    <input type="range" id="input-tag-size" min="0.5" max="1.2" value="0.667" step="0.02" />
                </div>
                <div class="slider-item">
                    <label>
                        <span>Tag Weight (Thickness)</span>
                        <span class="value-display" id="val-tag-weight">600</span>
                    </label>
                    <input type="range" id="input-tag-weight" min="100" max="900" value="600" step="100" />
                </div>
                <div class="slider-item">
                    <label>
                        <span>Tag Line Spacing</span>
                        <span class="value-display" id="val-tag-lh">1.1</span>
                    </label>
                    <input type="range" id="input-tag-lh" min="1.0" max="1.6" value="1.1" step="0.05" />
                </div>
                <div class="slider-item">
                    <label>
                        <span>Tag Letter Spacing</span>
                        <span class="value-display" id="val-tag-spacing">0.05em</span>
                    </label>
                    <input type="range" id="input-tag-spacing" min="0" max="0.2" value="0.05" step="0.01" />
                </div>
            </div>

            <div class="control-group export-group">
                <h3>CSS Export</h3>
                <pre class="css-output" id="css-output-code">{`:root {
  font-size: 18px;
  --text-base: 1rem;
  --text-3xl: 2.667rem;
  --text-xs: 0.667rem;
}`}</pre>
                <button class="copy-btn" id="btn-copy-css">Copy CSS Variables</button>
            </div>
        </aside>

        <!-- Specimen Content Viewport -->
        <main class="specimen-area">
            <div class="specimen-card">
                <div class="badge-row">
                    <span class="specimen-tag tag-interactive">Interactive Preview</span>
                    <span class="specimen-tag tag-category">Physical UX</span>
                </div>

                <h1 class="specimen-title">Pointobot Specimen</h1>

                <div class="specimen-tags-container">
                    <span class="specimen-mono-tag">EMBODIED AI</span>
                    <span class="specimen-tag-dot">•</span>
                    <span class="specimen-mono-tag">SPATIAL INTERACTION</span>
                    <span class="specimen-tag-dot">•</span>
                    <span class="specimen-mono-tag">PROTOTYPING</span>
                </div>

                <hr class="divider" />

                <p class="specimen-body">
                    An embodied AI prototype that explores pointing, gesture, and shared physical presence as a way to make spatial references legible. Making physical pointing accurate at room scale is non-trivial: it requires <strong>custom inverse kinematics, coordinate mapping, laser offset calculation, and servo calibration</strong>. Embodied AI communication carries a real technical cost that screen and voice-based systems simply do not have to pay.
                </p>

                <!-- Metadata speculative table -->
                <div class="metadata-table">
                    <div class="meta-row">
                        <span class="meta-label">Role</span>
                        <span class="meta-val">Interaction Design, Prototyping</span>
                    </div>
                    <div class="meta-row">
                        <span class="meta-label">Duration</span>
                        <span class="meta-val">6 Months</span>
                    </div>
                    <div class="meta-row">
                        <span class="meta-label">Year</span>
                        <span class="meta-val">2025</span>
                    </div>
                </div>
            </div>
        </main>
    </div>
</Layout>

<style>
    .playground-container {
        display: flex;
        min-height: calc(100vh - 120px);
        background: #060606;
        color: #DADDD0;
    }

    /* Control Panel Styles */
    .control-panel {
        width: 380px;
        background: #0e0e0e;
        border-right: 1px solid rgba(255, 255, 255, 0.08);
        padding: 24px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 24px;
        box-sizing: border-box;
    }

    .font-select {
        width: 100%;
        background: #1a1a1a;
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 6px;
        padding: 8px 12px;
        font-family: var(--font-sans);
        font-size: 0.85rem;
        outline: none;
        cursor: pointer;
        transition: border 0.2s ease;
        margin-top: 4px;
    }

    .font-select:focus {
        border-color: var(--accent-secondary, #42BD49);
    }

    .panel-header h2 {
        font-family: var(--font-sans);
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0 0 8px 0;
        color: #fff;
    }

    .panel-header p {
        font-family: var(--font-sans);
        font-size: 0.8rem;
        color: var(--text-secondary);
        margin: 0;
        line-height: 1.4;
    }

    .control-group {
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        padding-bottom: 20px;
    }

    .control-group h3 {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        text-transform: uppercase;
        color: var(--accent-secondary, #42BD49);
        letter-spacing: 0.08em;
        margin: 0 0 16px 0;
    }

    .slider-item {
        margin-bottom: 16px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .slider-item label {
        display: flex;
        justify-content: space-between;
        font-family: var(--font-sans);
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--text-primary);
    }

    .slider-item label .value-display {
        font-family: var(--font-mono);
        color: var(--accent-secondary, #42BD49);
        font-size: 0.75rem;
    }

    .slider-item input[type="range"] {
        width: 100%;
        accent-color: var(--accent-secondary, #42BD49);
        background: rgba(255, 255, 255, 0.1);
        border-radius: 4px;
        height: 6px;
        outline: none;
        transition: background 0.3s ease;
    }

    .slider-item .helper {
        font-size: 0.7rem;
        color: var(--text-muted);
        line-height: 1.3;
    }

    .export-group {
        border: none;
        padding-bottom: 0;
    }

    .css-output {
        background: #000;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 6px;
        padding: 12px;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: #88ee88;
        line-height: 1.4;
        overflow-x: auto;
        white-space: pre;
        margin-bottom: 12px;
    }

    .copy-btn {
        width: 100%;
        padding: 10px;
        background: var(--text-primary);
        color: #000;
        border: none;
        border-radius: 6px;
        font-family: var(--font-sans);
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .copy-btn:hover {
        background: #fff;
        transform: translateY(-1px);
    }

    .copy-btn:active {
        transform: translateY(0);
    }

    /* Specimen Preview Area Styles */
    .specimen-area {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
        box-sizing: border-box;
        overflow-y: auto;
    }

    .specimen-card {
        background: #0e0e0e;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 40px;
        max-width: 680px;
        width: 100%;
        box-sizing: border-box;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    }

    .badge-row {
        display: flex;
        gap: 8px;
        margin-bottom: 24px;
    }

    .specimen-tag {
        font-family: var(--font-sans);
        font-size: 11px;
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: 0.05em;
        padding: 2px 8px;
        border-radius: 4px;
    }

    .tag-interactive {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .tag-category {
        background: rgba(104, 181, 237, 0.15);
        color: #68B5ED;
        border: 1px solid rgba(104, 181, 237, 0.25);
    }

    .specimen-title {
        font-family: var(--font-title, var(--font-sans));
        font-size: var(--text-3xl); /* bound dynamically */
        font-weight: 800; /* bound dynamically */
        letter-spacing: -0.025em; /* bound dynamically */
        margin: 0 0 16px 0;
        color: #fff;
        line-height: 1.1;
    }

    .specimen-tags-container {
        display: flex;
        flex-wrap: wrap;
        column-gap: 0.5rem;
        row-gap: 0.15rem; /* bound dynamically */
        margin-bottom: 24px;
    }

    .specimen-mono-tag {
        font-family: var(--font-mono);
        font-size: var(--text-xs); /* bound dynamically */
        font-weight: 600; /* bound dynamically */
        letter-spacing: 0.05em; /* bound dynamically */
        color: var(--text-secondary);
        text-transform: uppercase;
        line-height: 1.1; /* bound dynamically */
    }

    .specimen-tag-dot {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
        opacity: 0.3;
    }

    .divider {
        border: none;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        margin: 0 0 24px 0;
    }

    .specimen-body {
        font-family: var(--font-sans);
        font-size: var(--text-base); /* bound dynamically */
        font-weight: 300; /* bound dynamically */
        line-height: 1.5; /* bound dynamically */
        color: var(--text-secondary);
        margin: 0 0 32px 0;
    }

    .specimen-body strong {
        color: #fff;
        font-weight: 600;
    }

    /* Metadata Table Specs */
    .metadata-table {
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .meta-row {
        display: grid;
        grid-template-columns: 120px 1fr;
        padding: 10px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        font-family: var(--font-sans);
        font-size: 14px;
    }

    .meta-label {
        font-weight: 600;
        color: #fff;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 0.05em;
        display: flex;
        align-items: center;
    }

    .meta-val {
        color: var(--text-secondary);
    }
</style>

<script>
    // Elements
    const root = document.documentElement;

    // Font Family Map & Loading Logic
    const FONTS_MAP: Record<string, { family: string; cdn?: string }> = {
        geist: {
            family: "'Geist', sans-serif"
        },
        "google-sans": {
            family: "'Google Sans', sans-serif",
            cdn: "https://cdn.jsdelivr.net/npm/@fontsource/google-sans@5.0.1/index.min.css"
        },
        "public-sans": {
            family: "'Public Sans', sans-serif",
            cdn: "https://fonts.googleapis.com/css2?family=Public+Sans:wght@100..900&display=swap"
        },
        "noto-sans": {
            family: "'Noto Sans', sans-serif",
            cdn: "https://fonts.googleapis.com/css2?family=Noto+Sans:wght@100..900&display=swap"
        },
        "general-sans": {
            family: "'General Sans', sans-serif",
            cdn: "https://api.fontshare.com/v2/css?f[]=general-sans@200,300,400,500,600,700,800&display=swap"
        },
        inter: {
            family: "'Inter', sans-serif",
            cdn: "https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap"
        },
        "instrument-sans": {
            family: "'Instrument Sans', sans-serif",
            cdn: "https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400..700&display=swap"
        },
        serif: {
            family: "Georgia, 'Times New Roman', serif"
        },
        "nunito-sans": {
            family: "'Nunito Sans', sans-serif",
            cdn: "https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@200..900&display=swap"
        },
        "ibm-plex": {
            family: "'IBM Plex Sans', sans-serif",
            cdn: "https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@100..700&display=swap"
        },
        "bricolage-grotesque": {
            family: "'Bricolage Grotesque', sans-serif",
            cdn: "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@200..800&display=swap"
        },
        "open-sans": {
            family: "'Open Sans', sans-serif",
            cdn: "https://fonts.googleapis.com/css2?family=Open+Sans:wght@300..800&display=swap"
        }
    };

    const selectFontTitle = document.getElementById('select-font-title') as HTMLSelectElement;
    const selectFontBody = document.getElementById('select-font-body') as HTMLSelectElement;

    function getSelectedFontFamily(selectEl: HTMLSelectElement | null) {
        if (!selectEl) return "'Geist', sans-serif";
        const val = selectEl.value;
        return FONTS_MAP[val]?.family || "'Geist', sans-serif";
    }

    function loadFont(fontId: string, cssVar: string) {
        const fontData = FONTS_MAP[fontId];
        if (!fontData) return;

        // Apply font-family override directly to the CSS variable
        root.style.setProperty(cssVar, fontData.family);

        // Dynamically insert link tag if it has a CDN link and isn't loaded yet
        if (fontData.cdn) {
            const linkId = `font-cdn-${fontId}`;
            if (!document.getElementById(linkId)) {
                const link = document.createElement('link');
                link.id = linkId;
                link.rel = 'stylesheet';
                link.href = fontData.cdn;
                document.head.appendChild(link);
            }
        }
        
        updateTypography();
    }

    if (selectFontTitle) {
        selectFontTitle.addEventListener('change', (e) => {
            const target = e.target as HTMLSelectElement;
            loadFont(target.value, '--font-title');
        });
    }

    if (selectFontBody) {
        selectFontBody.addEventListener('change', (e) => {
            const target = e.target as HTMLSelectElement;
            loadFont(target.value, '--font-sans');
        });
    }

    // Sliders
    const inputBasePx = document.getElementById('input-base-px') as HTMLInputElement;
    const inputTitleSize = document.getElementById('input-title-size') as HTMLInputElement;
    const inputTitleWeight = document.getElementById('input-title-weight') as HTMLInputElement;
    const inputTitleSpacing = document.getElementById('input-title-spacing') as HTMLInputElement;
    const inputBodySize = document.getElementById('input-body-size') as HTMLInputElement;
    const inputBodyWeight = document.getElementById('input-body-weight') as HTMLInputElement;
    const inputBodyLh = document.getElementById('input-body-lh') as HTMLInputElement;
    const inputBodySpacing = document.getElementById('input-body-spacing') as HTMLInputElement;
    const inputTagSize = document.getElementById('input-tag-size') as HTMLInputElement;
    const inputTagWeight = document.getElementById('input-tag-weight') as HTMLInputElement;
    const inputTagLh = document.getElementById('input-tag-lh') as HTMLInputElement;
    const inputTagSpacing = document.getElementById('input-tag-spacing') as HTMLInputElement;

    // Displays
    const valBasePx = document.getElementById('val-base-px');
    const valTitleSize = document.getElementById('val-title-size');
    const valTitleWeight = document.getElementById('val-title-weight');
    const valTitleSpacing = document.getElementById('val-title-spacing');
    const valBodySize = document.getElementById('val-body-size');
    const valBodyWeight = document.getElementById('val-body-weight');
    const valBodyLh = document.getElementById('val-body-lh');
    const valBodySpacing = document.getElementById('val-body-spacing');
    const valTagSize = document.getElementById('val-tag-size');
    const valTagWeight = document.getElementById('val-tag-weight');
    const valTagLh = document.getElementById('val-tag-lh');
    const valTagSpacing = document.getElementById('val-tag-spacing');

    // Specimen nodes to modify directly
    const specTitle = document.querySelector('.specimen-title') as HTMLElement;
    const specBody = document.querySelector('.specimen-body') as HTMLElement;
    const specMonoTags = document.querySelectorAll('.specimen-mono-tag');
    const specTagDots = document.querySelectorAll('.specimen-tag-dot');
    const specTagContainer = document.querySelector('.specimen-tags-container') as HTMLElement;
    const cssOutputCode = document.getElementById('css-output-code') as HTMLElement;
    const btnCopyCss = document.getElementById('btn-copy-css') as HTMLButtonElement;

    function updateTypography() {
        const basePx = inputBasePx.value;
        const titleSize = inputTitleSize.value;
        const titleWeight = inputTitleWeight.value;
        const titleSpacing = inputTitleSpacing.value;
        const bodySize = inputBodySize.value;
        const bodyWeight = inputBodyWeight.value;
        const bodyLh = inputBodyLh.value;
        const bodySpacing = inputBodySpacing.value;
        const tagSize = inputTagSize.value;
        const tagWeight = inputTagWeight.value;
        const tagLh = inputTagLh.value;
        const tagSpacing = inputTagSpacing.value;

        // 1. Update text displays
        if (valBasePx) valBasePx.textContent = `${basePx}px`;
        if (valTitleSize) valTitleSize.textContent = `${titleSize}rem`;
        if (valTitleWeight) valTitleWeight.textContent = titleWeight;
        if (valTitleSpacing) valTitleSpacing.textContent = `${titleSpacing}em`;
        if (valBodySize) valBodySize.textContent = `${bodySize}rem`;
        if (valBodyWeight) valBodyWeight.textContent = bodyWeight;
        if (valBodyLh) valBodyLh.textContent = bodyLh;
        if (valBodySpacing) valBodySpacing.textContent = `${bodySpacing}em`;
        if (valTagSize) valTagSize.textContent = `${tagSize}rem`;
        if (valTagWeight) valTagWeight.textContent = tagWeight;
        if (valTagLh) valTagLh.textContent = tagLh;
        if (valTagSpacing) valTagSpacing.textContent = `${tagSpacing}em`;

        // 2. Apply styling changes to the document base and specimen container
        // Changing global root font-size scales all rem units dynamically!
        root.style.fontSize = `${basePx}px`;

        // Apply title specimen overrides
        if (specTitle) {
            specTitle.style.fontSize = `${titleSize}rem`;
            specTitle.style.fontWeight = titleWeight;
            specTitle.style.letterSpacing = `${titleSpacing}em`;
        }

        // Apply body specimen overrides
        if (specBody) {
            specBody.style.fontSize = `${bodySize}rem`;
            specBody.style.fontWeight = bodyWeight;
            specBody.style.lineHeight = bodyLh;
            specBody.style.letterSpacing = `${bodySpacing}em`;
        }

        // Apply tag overrides
        specMonoTags.forEach(tag => {
            const el = tag as HTMLElement;
            el.style.fontSize = `${tagSize}rem`;
            el.style.fontWeight = tagWeight;
            el.style.lineHeight = tagLh;
            el.style.letterSpacing = `${tagSpacing}em`;
        });

        specTagDots.forEach(dot => {
            const el = dot as HTMLElement;
            el.style.fontSize = `${tagSize}rem`;
        });

        // Apply row-gap calculation based on line height and spacing
        if (specTagContainer) {
            // Scale row-gap with tag size
            const parsedTagSize = parseFloat(tagSize);
            specTagContainer.style.rowGap = `${parsedTagSize * 0.22}rem`;
        }

        // 3. Generate Copyable CSS Output
        const fontTitleFamily = getSelectedFontFamily(selectFontTitle);
        const fontBodyFamily = getSelectedFontFamily(selectFontBody);
        cssOutputCode.textContent = 
`:root {
  font-size: ${basePx}px;
  
  /* Font Family Defaults */
  --font-title: ${fontTitleFamily};
  --font-sans: ${fontBodyFamily};
  --font-mono: 'Geist Mono', monospace;

  /* Typography Spec scale overrides */
  --text-xs: ${tagSize}rem;
  --text-base: ${bodySize}rem;
  --text-3xl: ${titleSize}rem;
  
  /* Weights & Spacings */
  --title-weight: ${titleWeight};
  --title-spacing: ${titleSpacing}em;
  
  --body-weight: ${bodyWeight};
  --body-line-height: ${bodyLh};
  --body-spacing: ${bodySpacing}em;

  --tag-weight: ${tagWeight};
  --tag-line-height: ${tagLh};
  --tag-spacing: ${tagSpacing}em;
}`;
    }

    // Bind slider events
    const inputs = [
        inputBasePx, inputTitleSize, inputTitleWeight, inputTitleSpacing,
        inputBodySize, inputBodyWeight, inputBodyLh, inputBodySpacing,
        inputTagSize, inputTagWeight, inputTagLh, inputTagSpacing
    ];

    inputs.forEach(input => {
        if (input) {
            input.addEventListener('input', updateTypography);
        }
    });

    // Copy to clipboard functionality
    if (btnCopyCss) {
        btnCopyCss.addEventListener('click', () => {
            const codeText = cssOutputCode.textContent || '';
            navigator.clipboard.writeText(codeText).then(() => {
                const originalText = btnCopyCss.textContent;
                btnCopyCss.textContent = "Copied to Clipboard!";
                btnCopyCss.style.background = "#42BD49";
                btnCopyCss.style.color = "#000";
                setTimeout(() => {
                    btnCopyCss.textContent = originalText;
                    btnCopyCss.style.background = "";
                    btnCopyCss.style.color = "";
                }, 2000);
            });
        });
    }

    // Initialize specimen styles and font bindings on load
    if (selectFontTitle) loadFont(selectFontTitle.value, '--font-title');
    if (selectFontBody) loadFont(selectFontBody.value, '--font-sans');
    updateTypography();
</script>
