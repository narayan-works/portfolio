---
import SpeedInsights from "@vercel/speed-insights/astro";
import "../styles/global.css";
import CustomCursor from "../components/CustomCursor.astro";
import TypographyInspector from "../components/TypographyInspector.astro";
import { ViewTransitions } from "astro:transitions";

interface Props {
	title: string;
	description?: string;
	fullWidth?: boolean;
	preloadImageHref?: string;
}

const {
	title,
	description = "Design Technologist Portfolio",
	fullWidth = false,
	preloadImageHref,
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href="/happy.png" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@200..800&family=Geist:wght@100..900&family=Geist+Mono:wght@100..900&family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<link
			href="https://cdn.jsdelivr.net/npm/@fontsource/google-sans@5.0.1/300.css"
			rel="stylesheet"
		/>
		<link
			href="https://cdn.jsdelivr.net/npm/@fontsource/google-sans@5.0.1/400.css"
			rel="stylesheet"
		/>
		<link
			href="https://cdn.jsdelivr.net/npm/@fontsource/google-sans@5.0.1/500.css"
			rel="stylesheet"
		/>
		<link
			href="https://cdn.jsdelivr.net/npm/@fontsource/google-sans@5.0.1/700.css"
			rel="stylesheet"
		/>
		{
			preloadImageHref && (
				<link
					rel="preload"
					as="image"
					href={preloadImageHref}
					fetchpriority="high"
				/>
			)
		}
		<meta property="og:site_name" content="Narayan Ashanahalli" />
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "WebSite",
				"name": "Narayan Ashanahalli",
				"url": "https://www.narayan.works/"
			}
		</script>
		<title>{title}</title>
		<script defer src="/_vercel/insights/script.js"></script>
		<!-- Google tag (gtag.js) -->
		<script
			async
			src="https://www.googletagmanager.com/gtag/js?id=G-E94KJKFM6G"
		></script>
		<script>
			const w = window as typeof window & {
				dataLayer?: unknown[][];
				requestIdleCallback?: (
					callback: () => void,
					options?: { timeout?: number },
				) => void;
			};

			w.dataLayer = w.dataLayer || [];
			function gtag(...args: unknown[]) {
				w.dataLayer?.push(args);
			}
			gtag("js", new Date());

			const initAnalytics = () => gtag("config", "G-E94KJKFM6G");
			if (typeof w.requestIdleCallback === "function") {
				w.requestIdleCallback(() => initAnalytics(), { timeout: 2000 });
			} else {
				window.addEventListener("load", initAnalytics, { once: true });
			}
		</script>
		<!-- Microsoft Clarity -->
		<script type="text/javascript" is:inline>
			(function (c, l, a, r, i, t, y) {
				c[a] =
					c[a] ||
					function () {
						(c[a].q = c[a].q || []).push(arguments);
					};
				t = l.createElement(r);
				t.async = 1;
				t.src = "https://www.clarity.ms/tag/" + i;
				y = l.getElementsByTagName(r)[0];
				y.parentNode.insertBefore(t, y);
			})(window, document, "clarity", "script", "x4yo8ojdri");
		</script>
		<script is:inline>
			(() => {
				const theme = (() => {
					if (
						typeof localStorage !== "undefined" &&
						localStorage.getItem("theme")
					) {
						return localStorage.getItem("theme");
					}
					if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
						return "dark";
					}
					return "light";
				})();

				if (theme === "light") {
					document.documentElement.setAttribute("data-theme", "light");
				} else {
					document.documentElement.removeAttribute("data-theme");
				}
				window.localStorage.setItem("theme", theme);
			})();
		</script>
		<ViewTransitions />
	</head>
	<body>
		<CustomCursor />
		<TypographyInspector />
		<div class={`universal-layout ${fullWidth ? "full-width" : ""}`}>
			<!-- Sidebar Slot (Universal Left) -->
			<aside class="layout-sidebar">
				<slot name="sidebar" />
			</aside>

			<!-- Main Content Slot (Universal Right) -->
			<main class="layout-content">
				<slot />
			</main>
		</div>
		<SpeedInsights />
		<script>
			import Lenis from "lenis";

			// Initialize Lenis for buttery smooth scrolling
			const w = window as any;
			if (!w.lenis) {
				const lenis = new Lenis({
					duration: 1.2,
					easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
					orientation: "vertical",
					gestureOrientation: "vertical",
					smoothWheel: true,
					wheelMultiplier: 1,
					touchMultiplier: 2,
					infinite: false,
				});

				function raf(time: number) {
					lenis.raf(time);
					requestAnimationFrame(raf);
				}

				requestAnimationFrame(raf);
				w.lenis = lenis;

				// Intercept local anchor link clicks on the document for smooth Lenis scrolling
				document.addEventListener("click", (e) => {
					const target = e.target as HTMLElement;
					const anchor = target.closest("a");
					if (anchor) {
						const href = anchor.getAttribute("href");
						if (href && href.startsWith("#") && href.length > 1) {
							const targetEl = document.querySelector(href);
							if (targetEl) {
								e.preventDefault();
								lenis.scrollTo(targetEl, { duration: 1.2 });
							}
						}
					}
				});
			}

			// Reset scroll on Astro view transitions
			document.addEventListener("astro:after-swap", () => {
				if (w.lenis) {
					w.lenis.scrollTo(0, { immediate: true });
				}
			});
		</script>
	</body>
</html>

<style>
	/* Reset body */
	body {
		margin: 0;
		padding: 0;
		min-height: 100vh;
		background: var(--bg-primary);
		color: var(--text-primary);
	}

	@media (min-width: 769px) {
		body {
			cursor: none; /* Hide default cursor only on desktop */
		}
		/* Ensure links also don't show cursor */
		a,
		a *,
		button,
		button *,
		[role="button"],
		[role="button"] * {
			cursor: none !important;
		}
	}

	.universal-layout {
		display: grid;
		grid-template-columns: 320px minmax(0, 1fr); /* Fixed Sidebar (Left), Fluid Content (Right) */
		min-height: 100vh;
	}

	.universal-layout.full-width {
		display: block;
	}

	.layout-sidebar {
		background: #000000; /* Dark mode: pure black */
		border-right: 1px solid var(--border-subtle);
		border-left: none;
		padding: 20px;
		position: sticky;
		top: 0;
		height: 100vh;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		width: 320px;
		box-sizing: border-box;
		grid-column: 1 / 2;
		grid-row: 1;
		z-index: 10000; /* High z-index to elevate child stacking contexts (theme toggle) above right content */
	}

	[data-theme="light"] .layout-sidebar {
		background: #e5e6df; /* Light mode: dark beige */
	}

	.layout-content {
		min-width: 0; /* Prevent grid blowout */
		/* Ensure it sits in the second column */
		grid-column: 2 / 3;
		grid-row: 1;
	}

	.full-width .layout-sidebar {
		display: none;
	}

	.full-width .layout-content {
		grid-column: auto; /* Reset for full width */
	}

	@media (max-width: 1024px) {
		.universal-layout {
			display: block; /* Prevent grid height stretching */
		}

		.layout-sidebar {
			position: relative;
			height: auto;
			min-height: 0; /* Safety */
			border-left: none; /* Reset border */
			border-bottom: none; /* Removed line per request */
			overflow: visible; /* Ensure sticky children work */
			display: block;
			padding-bottom: 20px; /* Force 20px update */
			width: 100%; /* Reset width */
			grid-column: auto;
		}

		/* Show default cursor on mobile/touch devices if needed, 
		   though 'cursor: none' is usually fine as they don't have a cursor. 
		   But if a mouse is connected to iPad: */
	}
</style>
