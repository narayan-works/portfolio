---
import Layout from "./Layout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import HomeNavigation from "../components/HomeNavigation.astro";
import Footer from "../components/Footer.astro";
import NextProjectBanner from "../components/NextProjectBanner.astro";
import GhostRunner from "../components/GhostRunner.astro";
import { Image } from "astro:assets";

interface Props {
    title: string;
    description?: string;
    meta?: Record<string, string>; // Flexible key-value pairs
    tags?: string[];
    ctaUrl?: string;
    ctaText?: string;
    sections?: { id: string; label: string }[];
    heroImage?: string;
    category?: string;
    nextProject?: {
        slug: string;
        title: string;
        description?: string;
        tags?: string[];
        heroImage?: string;
        category?: string;
        ctaUrl?: string;
    };
}

const {
    title,
    description,
    meta = {},
    tags = [],
    ctaUrl,
    ctaText,
    sections: propSections,
    heroImage,
    category,
    nextProject,
} = Astro.props;

// Convert meta object to array for iteration
const metaEntries = Object.entries(meta).filter(
    ([_, value]) => value && value.trim() !== "",
);

const sections = propSections || [];

// Map project slugs to their category-specific active colors (matching homepage WorksFilter colors)
const slug = Astro.url.pathname.split("/").filter(Boolean).pop() || "";
const categoryColors: Record<string, string> = {
    pointo: "var(--category-hardware-ux)",
    piko: "var(--category-hardware-ux)",
    musibuddy: "var(--category-hardware-ux)",
    "dot-threads": "var(--category-web-ux)",
    lab4c: "var(--category-web-ux)",
    "prompt-nodes": "var(--category-web-ux)",
    detour: "var(--category-mobile-ux)",
    serendipidity: "var(--category-mobile-ux)",
    "working-living-innovating": "var(--category-spatial-xd)",
    "skywalk-sanctuary": "var(--category-spatial-xd)",
};

const categoryHoverColors: Record<string, string> = {
    pointo: "var(--category-hardware-ux-hover)",
    piko: "var(--category-hardware-ux-hover)",
    musibuddy: "var(--category-hardware-ux-hover)",
    "dot-threads": "var(--category-web-ux-hover)",
    lab4c: "var(--category-web-ux-hover)",
    "prompt-nodes": "var(--category-web-ux-hover)",
    detour: "var(--category-mobile-ux-hover)",
    serendipidity: "var(--category-mobile-ux-hover)",
    "working-living-innovating": "var(--category-spatial-xd-hover)",
    "skywalk-sanctuary": "var(--category-spatial-xd-hover)",
};

// Fallback category-to-color mapping (for archives / other project files)
const fallbackColors: Record<string, string> = {
    embodied: "var(--category-hardware-ux)",
    thinking: "var(--category-web-ux)",
    spatial: "var(--category-spatial-xd)",
    strategy: "var(--category-spatial-xd)",
    archive: "var(--category-hardware-ux)",
};

const fallbackHoverColors: Record<string, string> = {
    embodied: "var(--category-hardware-ux-hover)",
    thinking: "var(--category-web-ux-hover)",
    spatial: "var(--category-spatial-xd-hover)",
    strategy: "var(--category-spatial-xd-hover)",
    archive: "var(--category-hardware-ux-hover)",
};

// Clean category string (handles e.g. "embodied[work in progess]")
const cleanCategory = (category || "")
    .toLowerCase()
    .replace(/\[.*\]/, "")
    .trim();

const activeColor =
    categoryColors[slug] ||
    fallbackColors[cleanCategory] ||
    "var(--accent-secondary)";
const hoverColor =
    categoryHoverColors[slug] ||
    fallbackHoverColors[cleanCategory] ||
    "var(--accent-secondary)";
---

<Layout title={`${title} | Narayan Ashanahalli`} preloadImageHref={heroImage}>
    <HomeNavigation />
    <div
        class="case-study-controls"
        style={`--project-category-color: ${activeColor}; --project-category-hover-color: ${hoverColor};`}
    >
        <button
            id="text-mode-toggle"
            class="text-mode-toggle"
            aria-label="Toggle text mode"
            type="button"
        >
            <span class="mode-option mode-text active" data-mode="text"
                >text</span
            >
            <span class="mode-divider">/</span>
            <span class="mode-option mode-notext" data-mode="notext"
                >no text</span
            >
        </button>
    </div>
    <!-- LEFT SIDEBAR SLOT -->
    <div slot="sidebar" class="project-sidebar-content">
        <div class="sidebar-scroll-container">
            <div class="sidebar-top">
                <div class="sidebar-header-divider"></div>
                <h1 class="sidebar-project-title">{title}</h1>

                {
                    description && (
                        <p class="sidebar-project-desc">{description}</p>
                    )
                }

                {
                    tags.length > 0 && (
                        <div class="sidebar-tags">
                            {tags.map((tag) => (
                                <span>{tag}</span>
                            ))}
                        </div>
                    )
                }

                {
                    metaEntries.length > 0 && (
                        <div class="project-meta-table">
                            {metaEntries.map(([label, value]) => (
                                <div class="meta-row">
                                    <span class="meta-label">{label}</span>
                                    <span class="meta-value">{value}</span>
                                </div>
                            ))}
                        </div>
                    )
                }

                {
                    ctaUrl && (
                        <a
                            href={ctaUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="sidebar-cta-button"
                            style={`--cta-active-color: ${activeColor}; --cta-hover-color: ${hoverColor};`}
                        >
                            {ctaText || "Try it out"}
                            <svg
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                                class="sidebar-cta-arrow"
                            >
                                <path
                                    d="M5 12H19M19 12L12 5M19 12L12 19"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                />
                            </svg>
                        </a>
                    )
                }
            </div>
        </div>

        <div class="sidebar-bottom">
            <nav class="toc-nav" style={`--toc-active-color: ${activeColor};`}>
                <ul class="toc-track">
                    {
                        sections.map((section, i) => (
                            <li class="toc-item">
                                <span class="toc-pill-wrap">
                                    <span class="toc-pill" />
                                </span>
                                <a
                                    href={`#${section.id}`}
                                    class="toc-link"
                                    data-target={section.id}
                                    data-index={i}
                                >
                                    {section.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>
            <div class="theme-toggle-wrapper">
                <ThemeToggle />
            </div>
        </div>
    </div>

    <article
        class={`right-content ${nextProject ? "has-next-project" : ""}`}
        style={`--project-category-color: ${activeColor}; --project-category-hover-color: ${hoverColor};`}
    >
        <slot />
        {
            nextProject && (
                <NextProjectBanner
                    slug={nextProject.slug}
                    title={nextProject.title}
                    description={nextProject.description}
                    tags={nextProject.tags}
                    heroImage={nextProject.heroImage}
                    category={nextProject.category}
                    ctaUrl={nextProject.ctaUrl}
                />
            )
        }
        <Footer />
        <div class="game-bottom-wrapper">
            <GhostRunner />
        </div>
    </article>
</Layout>

<script>
    let cleanupTOC: (() => void) | null = null;
    let cleanupThemeToggle: (() => void) | null = null;
    let cleanupSidebarFade: (() => void) | null = null;

    function setupTOCScroll() {
        if (cleanupTOC) {
            cleanupTOC();
            cleanupTOC = null;
        }

        const tocLinks = Array.from(
            document.querySelectorAll(".toc-link"),
        ) as HTMLAnchorElement[];

        const targets = tocLinks
            .map((link) => {
                const targetId = link.getAttribute("data-target");
                const element = targetId
                    ? document.getElementById(targetId)
                    : null;
                const pill = link.parentElement?.querySelector(
                    ".toc-pill",
                ) as HTMLElement | null;
                return { link, element, pill };
            })
            .filter((item) => item.element && item.pill) as {
            link: HTMLAnchorElement;
            element: HTMLElement;
            pill: HTMLElement;
        }[];

        if (targets.length === 0) return;

        function updateActiveDotStates() {
            // Compare card/section centers with viewport center
            const centers = targets.map((t) => {
                const rect = t.element.getBoundingClientRect();
                return rect.top + window.scrollY + rect.height / 2;
            });
            const T = window.scrollY + window.innerHeight / 2;

            // Find fractional index P
            let P = 0;

            // Check if user is scrolled near top of the page
            if (window.scrollY < 120) {
                P = 0;
            } else if (
                window.scrollY + window.innerHeight >=
                document.documentElement.scrollHeight - 60
            ) {
                // If at the very bottom, highlight the last section
                P = centers.length - 1;
            } else {
                for (let z = 0; z < centers.length - 1; z++) {
                    const G = centers[z];
                    const Y = centers[z + 1];
                    if (T >= G && T < Y) {
                        P = z + (T - G) / (Y - G);
                        break;
                    }
                }
                if (T >= centers[centers.length - 1]) {
                    P = centers.length - 1;
                }
            }

            P = Math.max(0, Math.min(centers.length - 1, P));

            // Apply continuous transition heights and opacities
            targets.forEach((t, index) => {
                const diff = Math.abs(P - index);
                if (diff < 1) {
                    // Morph from dot (5px) to line (16px)
                    const height = 5 + (16 - 5) * (1 - diff);
                    const alpha = 0.35 + 0.65 * (1 - diff);
                    t.pill.style.height = `${height}px`;
                    t.pill.style.opacity = `${alpha}`;
                    t.pill.style.backgroundColor = `var(--toc-active-color, var(--accent-secondary))`;

                    // Also dim/brighten the link text
                    const linkAlpha = 0.4 + 0.6 * (1 - diff);
                    t.link.style.opacity = `${linkAlpha}`;
                    t.link.style.fontWeight = diff < 0.5 ? "600" : "500";
                } else {
                    t.pill.style.height = "5px";
                    t.pill.style.opacity = "0.35";
                    t.pill.style.backgroundColor = "var(--text-muted)";

                    t.link.style.opacity = "0.4";
                    t.link.style.fontWeight = "500";
                }
            });
        }

        const handleScroll = () => {
            updateActiveDotStates();
        };

        const handleResize = () => {
            updateActiveDotStates();
        };

        window.addEventListener("scroll", handleScroll, { passive: true });
        window.addEventListener("resize", handleResize);

        cleanupTOC = () => {
            window.removeEventListener("scroll", handleScroll);
            window.removeEventListener("resize", handleResize);
        };

        updateActiveDotStates();
    }

    function setupThemeTogglePosition() {
        if (cleanupThemeToggle) {
            cleanupThemeToggle();
            cleanupThemeToggle = null;
        }

        const floaters = [
            document.querySelector(".theme-toggle-wrapper"),
            document.querySelector(".case-study-controls"),
        ].filter(Boolean) as HTMLElement[];

        // They stop with the case study: above the next-project card when there
        // is one, otherwise above the footer.
        const boundary =
            document.querySelector(".next-project-section") ||
            document.querySelector(".site-footer");
        if (floaters.length === 0 || !boundary) return;

        function updateThemeTogglePosition() {
            if (!boundary) return;

            const boundaryRect = boundary.getBoundingClientRect();
            const windowHeight = window.innerHeight;
            const margin = 20;

            floaters.forEach((el) => {
                const style = getComputedStyle(el);

                // Which edge this element is pinned to at the current
                // breakpoint. Can't be read from `style.top`: for a positioned
                // element that resolves to a used px value, never "auto".
                if (style.getPropertyValue("--anchor").trim() !== "bottom") {
                    return;
                }

                // Resting offset differs per breakpoint; --rest-bottom carries it.
                const rest =
                    parseFloat(style.getPropertyValue("--rest-bottom")) || 20;
                const bottom =
                    boundaryRect.top < windowHeight
                        ? windowHeight - boundaryRect.top + margin
                        : rest;
                el.style.setProperty("bottom", `${bottom}px`, "important");
            });
        }

        const handleScroll = () => {
            updateThemeTogglePosition();
        };
        const handleResize = () => {
            updateThemeTogglePosition();
        };

        window.addEventListener("scroll", handleScroll, { passive: true });
        window.addEventListener("resize", handleResize);

        cleanupThemeToggle = () => {
            window.removeEventListener("scroll", handleScroll);
            window.removeEventListener("resize", handleResize);
        };

        updateThemeTogglePosition();
    }

    function setupTextModeToggle() {
        const btn = document.getElementById("text-mode-toggle");
        const article = document.querySelector(".right-content");
        if (!btn || !article) return;

        const textOpt = btn.querySelector('.mode-option[data-mode="text"]');
        const noTextOpt = btn.querySelector('.mode-option[data-mode="notext"]');

        const savedMode = localStorage.getItem("caseStudyTextMode") || "text";
        applyMode(savedMode);

        const handleToggle = (e: Event) => {
            e.preventDefault();
            e.stopPropagation();

            const target = e.target as HTMLElement;
            const clickedOption = target.closest(
                ".mode-option",
            ) as HTMLElement | null;

            let newMode: string;
            if (clickedOption) {
                newMode =
                    clickedOption.getAttribute("data-mode") === "notext"
                        ? "notext"
                        : "text";
            } else {
                newMode = article.classList.contains("mode-no-text")
                    ? "text"
                    : "notext";
            }

            applyMode(newMode);
            localStorage.setItem("caseStudyTextMode", newMode);
        };

        btn.addEventListener("click", handleToggle);

        function applyMode(mode: string) {
            if (mode === "notext") {
                article?.classList.add("mode-no-text");
                textOpt?.classList.remove("active");
                noTextOpt?.classList.add("active");
            } else {
                article?.classList.remove("mode-no-text");
                textOpt?.classList.add("active");
                noTextOpt?.classList.remove("active");
            }
        }
    }

    // Fade the sidebar out as the next-project section scrolls in — fully
    // faded once 80% of that section is on screen.
    function setupSidebarFade() {
        if (cleanupSidebarFade) {
            cleanupSidebarFade();
            cleanupSidebarFade = null;
        }

        const sidebar = document.querySelector(
            ".project-sidebar-content",
        ) as HTMLElement | null;
        const nextSection = document.querySelector(
            ".next-project-section",
        ) as HTMLElement | null;
        if (!sidebar || !nextSection) return;

        let frame = 0;

        const update = () => {
            frame = 0;

            // Stacked layout below 1024px — nothing to fade against
            if (window.innerWidth <= 1024) {
                sidebar.style.opacity = "";
                sidebar.style.pointerEvents = "";
                return;
            }

            const rect = nextSection.getBoundingClientRect();
            const viewport = window.innerHeight;
            // How much of the section is visible, as a fraction of the most
            // that ever can be (its height, capped at one viewport).
            const span = Math.min(rect.height, viewport) || 1;
            const visible = Math.min(
                span,
                Math.max(0, viewport - rect.top),
            );
            const progress = Math.min(1, visible / span / 0.8);

            sidebar.style.opacity = String(1 - progress);
            sidebar.style.pointerEvents = progress > 0.95 ? "none" : "";
        };

        const onScroll = () => {
            if (frame) return;
            frame = requestAnimationFrame(update);
        };

        update();
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);

        cleanupSidebarFade = () => {
            if (frame) cancelAnimationFrame(frame);
            window.removeEventListener("scroll", onScroll);
            window.removeEventListener("resize", onScroll);
            sidebar.style.opacity = "";
            sidebar.style.pointerEvents = "";
        };
    }

    function init() {
        setupTOCScroll();
        setupThemeTogglePosition();
        setupTextModeToggle();
        setupSidebarFade();
    }

    // Run initial setup and listen for page loads (Astro view transitions support)
    document.addEventListener("DOMContentLoaded", init);
    document.addEventListener("astro:page-load", init);
</script>

<style>
    /* Sidebar Internal Styling */
    .project-sidebar-content {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
        font-family: var(--font-sans);
        /* Scroll-driven fade near the next-project section (see script) */
        transition: opacity 0.15s linear;
        will-change: opacity;
    }

    /* Allow scrolling if content is too tall */
    .sidebar-scroll-container {
        display: flex;
        flex-direction: column;
        gap: var(--space-xl);
    }

    .sidebar-top {
        display: flex;
        flex-direction: column;
        gap: 0;
        padding-top: 34px;
    }

    .sidebar-header-divider {
        width: calc(100% + 40px);
        height: 1px;
        background: var(--border-subtle, rgba(255, 255, 255, 0.15));
        margin-left: -20px;
        margin-right: -20px;
        margin-top: 0;
        margin-bottom: 20px;
    }

    .sidebar-project-title {
        font-family: "Bricolage Grotesque", sans-serif;
        font-size: 54px;
        line-height: 0.9;
        font-weight: 400;
        margin-top: 0;
        margin-bottom: 9px;
        letter-spacing: -0.05em;
    }

    .sidebar-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 2px 4px;
        margin-bottom: 0.75rem;
    }

    .sidebar-tags span {
        font-family: "Google Sans", sans-serif;
        font-size: 14px;
        color: var(--text-muted);
        text-transform: lowercase;
        font-weight: 400;
        line-height: 1.1;
        display: inline-flex;
        align-items: center;
    }

    .sidebar-tags span:not(:last-child)::after {
        content: "•";
        margin-left: 4px;
        opacity: 0.3;
    }

    .sidebar-project-desc {
        font-family: "Google Sans", sans-serif;
        font-size: 14px;
        font-weight: 300;
        color: var(--text-secondary);
        line-height: 1.4;
        margin-bottom: 1rem;
    }

    .sidebar-cta-button {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5em;
        position: relative;
        background: var(--bg-surface, #ffffff);
        color: var(--cta-active-color, var(--accent-secondary)) !important;
        border: 1px solid var(--border-subtle, rgba(0, 0, 0, 0.15));
        padding: 9px 16px;
        border-radius: var(--radius-md);
        text-decoration: none;
        font-family: "Google Sans", sans-serif;
        font-weight: 600;
        font-size: 14px;
        letter-spacing: 0.05em;
        margin-top: 1.5rem;
        margin-bottom: 1rem;
        width: 100%;
        box-sizing: border-box;
        transition:
            background-color 0.3s ease,
            border-color 0.3s ease,
            color 0.3s ease;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        cursor: pointer;
    }
    .sidebar-cta-button .sidebar-cta-arrow {
        display: inline-block;
        width: 26px;
        height: 26px;
        flex-shrink: 0;
        transition: transform 0.3s ease;
    }
    .sidebar-cta-button:hover {
        background: var(--cta-hover-color, var(--accent-secondary));
        border-color: var(--cta-hover-color, var(--accent-secondary));
        color: #000000 !important;
    }
    .sidebar-cta-button:hover .sidebar-cta-arrow {
        transform: rotate(-45deg);
    }
    .sidebar-cta-button:active {
        background: var(--cta-active-color, var(--accent-secondary));
        border-color: var(--cta-active-color, var(--accent-secondary));
        color: #000000 !important;
        filter: brightness(0.95);
    }

    /* TABLET/MOBILE STYLES */
    @media (max-width: 1024px) {
        .sidebar-cta-button {
            display: none;
        }

        .toc-nav {
            display: none;
        }
    }

    .toc-nav {
        margin: 0.5rem 0;
    }

    .toc-track {
        list-style: none;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 1px; /* Reduced gap to compress spacing between lines */
        margin: 0;
        position: relative;
    }

    .toc-item {
        display: flex;
        align-items: center;
        gap: 16px; /* Compressed gap between dot and text */
        margin: 0;
        padding: 0;
        text-align: left;
        position: relative;
        cursor: pointer;
    }

    .toc-pill-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 8px;
        height: 16px; /* Compressed boundary */
        position: relative;
    }

    .toc-pill {
        display: block;
        width: 5px; /* Slightly smaller dot */
        height: 5px;
        background-color: var(--text-muted);
        opacity: 0.35;
        border-radius: 2.5px;
        will-change: height, opacity;
        transition:
            height 0.35s cubic-bezier(0.22, 1, 0.36, 1),
            background-color 0.25s ease,
            opacity 0.25s ease;
    }

    .toc-link {
        color: var(--text-primary);
        text-decoration: none;
        font-size: 24px;
        line-height: 1.2;
        transition:
            opacity 0.25s ease,
            font-weight 0.25s ease;
        display: inline-block;
        font-weight: 500;
        opacity: 0.4; /* Default muted opacity */
        font-family: "Bricolage Grotesque", sans-serif;
    }

    .toc-item:hover .toc-pill {
        height: 16px !important;
        opacity: 1 !important;
        background-color: var(
            --toc-active-color,
            var(--accent-secondary)
        ) !important;
    }

    .toc-item:hover .toc-link {
        opacity: 1 !important;
        font-weight: 600 !important;
    }

    /* META TABLE STYLES */
    .sidebar-bottom {
        display: flex;
        flex-direction: column;
        padding-top: 2rem;
    }

    .project-meta-table {
        display: flex;
        flex-direction: column;
        border-top: 1px solid var(--border-subtle);
        padding-top: 0; /* Removed 16px padding */
    }

    .meta-row {
        display: grid;
        grid-template-columns: 100px 1fr; /* Fixed Label width, increased to prevent overlap */
        gap: 1rem;
        padding: 0.3rem 0;
        border-bottom: 1px solid var(--border-subtle);
        font-size: var(--text-sm);
    }

    .meta-label {
        font-family: "Google Sans", sans-serif;
        font-size: 14px;
        font-weight: 400;
        color: var(--text-muted);
        letter-spacing: 0.015em;
        line-height: 1.5;
    }

    .meta-value {
        font-family: "Google Sans", sans-serif;
        font-size: 14px;
        font-weight: 300;
        color: var(--text-secondary);
        letter-spacing: 0em;
        line-height: 1.15;
    }

    /* Bottom-right of the project section (the content column), 10px in from
       the bottom edge. 340px = 320px sidebar + 20px content padding, matching
       the text/no-text toggle's right edge. JS lifts it above the
       next-project card on scroll. */
    .theme-toggle-wrapper {
        --anchor: bottom;
        --rest-bottom: 10px;
        position: fixed !important;
        bottom: 10px !important;
        right: 340px !important;
        left: auto !important;
        z-index: 100;
        margin: 0 !important;
        padding: 0 !important;
    }

    /* Case Study Text/No-Text Toggle Controls (Positioned at top right of main content area) */
    /* Top-right of the project section: sits on the content column's right
       edge (320px sidebar + 20px pad). Vertically it sits in the nav band,
       which is empty on this side since works-page nav links are confined to
       the 280px sidebar column. */
    .case-study-controls {
        --anchor: top;
        position: fixed;
        top: 14px;
        right: 340px;
        z-index: 30000;
        display: flex;
        align-items: center;
        margin: 0;
        padding: 0;
    }

    @media (max-width: 1024px) {
        /* Floats bottom-left; JS lifts it above the next-project card */
