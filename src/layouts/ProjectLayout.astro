---
import Layout from "./Layout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import SidebarNavigation from "../components/SidebarNavigation.astro";
import Footer from "../components/Footer.astro";
import NextProjectBanner from "../components/NextProjectBanner.astro";
import { Image } from "astro:assets";

interface Props {
    title: string;
    description?: string;
    meta?: Record<string, string>; // Flexible key-value pairs
    tags?: string[];
    ctaUrl?: string;
    ctaText?: string;
    sections?: { id: string; label: string }[];
    heroImage?: string;
    category?: string;
    nextProject?: {
        slug: string;
        title: string;
        description?: string;
        tags?: string[];
        heroImage?: string;
        category?: string;
    };
}

const {
    title,
    description,
    meta = {},
    tags = [],
    ctaUrl,
    ctaText,
    sections: propSections,
    heroImage,
    category,
    nextProject,
} = Astro.props;

// Convert meta object to array for iteration
const metaEntries = Object.entries(meta).filter(
    ([_, value]) => value && value.trim() !== "",
);

const sections = propSections || [];

// Map project slugs to their category-specific active colors (matching homepage WorksFilter colors)
const slug = Astro.url.pathname.split("/").filter(Boolean).pop() || "";
const categoryColors: Record<string, string> = {
    pointo: "var(--category-hardware-ux)",
    piko: "var(--category-hardware-ux)",
    musibuddy: "var(--category-hardware-ux)",
    "dot-threads": "var(--category-web-ux)",
    lab4c: "var(--category-web-ux)",
    xfigura: "var(--category-web-ux)",
    detour: "var(--category-mobile-ux)",
    serendipidity: "var(--category-mobile-ux)",
    "tirupati-campus": "var(--category-spatial-xd)",
    "skywalk-sanctuary": "var(--category-spatial-xd)",
};

const categoryHoverColors: Record<string, string> = {
    pointo: "var(--category-hardware-ux-hover)",
    piko: "var(--category-hardware-ux-hover)",
    musibuddy: "var(--category-hardware-ux-hover)",
    "dot-threads": "var(--category-web-ux-hover)",
    lab4c: "var(--category-web-ux-hover)",
    xfigura: "var(--category-web-ux-hover)",
    detour: "var(--category-mobile-ux-hover)",
    serendipidity: "var(--category-mobile-ux-hover)",
    "tirupati-campus": "var(--category-spatial-xd-hover)",
    "skywalk-sanctuary": "var(--category-spatial-xd-hover)",
};

// Fallback category-to-color mapping (for archives / other project files)
const fallbackColors: Record<string, string> = {
    embodied: "var(--category-hardware-ux)",
    thinking: "var(--category-web-ux)",
    spatial: "var(--category-spatial-xd)",
    strategy: "var(--category-spatial-xd)",
    archive: "var(--category-hardware-ux)",
};

const fallbackHoverColors: Record<string, string> = {
    embodied: "var(--category-hardware-ux-hover)",
    thinking: "var(--category-web-ux-hover)",
    spatial: "var(--category-spatial-xd-hover)",
    strategy: "var(--category-spatial-xd-hover)",
    archive: "var(--category-hardware-ux-hover)",
};

// Clean category string (handles e.g. "embodied[work in progess]")
const cleanCategory = (category || "")
    .toLowerCase()
    .replace(/\[.*\]/, "")
    .trim();

const activeColor =
    categoryColors[slug] ||
    fallbackColors[cleanCategory] ||
    "var(--accent-secondary)";
const hoverColor =
    categoryHoverColors[slug] ||
    fallbackHoverColors[cleanCategory] ||
    "var(--accent-secondary)";
---

<Layout title={`${title} | Narayan Ashanahalli`} preloadImageHref={heroImage}>
    <!-- LEFT SIDEBAR SLOT -->
    <div slot="sidebar" class="project-sidebar-content">
        <div class="sidebar-scroll-container">
            <div class="sidebar-top">
                <SidebarNavigation title={title} />

                <h1 class="sidebar-project-title">{title}</h1>

                {
                    tags.length > 0 && (
                        <div class="sidebar-tags">
                            {tags.map((tag) => (
                                <span>{tag}</span>
                            ))}
                        </div>
                    )
                }

                {
                    description && (
                        <p class="sidebar-project-desc">{description}</p>
                    )
                }

                {
                    metaEntries.length > 0 && (
                        <div class="project-meta-table">
                            {metaEntries.map(([label, value]) => (
                                <div class="meta-row">
                                    <span class="meta-label">{label}</span>
                                    <span class="meta-value">{value}</span>
                                </div>
                            ))}
                        </div>
                    )
                }

                {
                    ctaUrl && (
                        <a
                            href={ctaUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="sidebar-cta-button"
                            style={`--cta-active-color: ${activeColor}; --cta-hover-color: ${hoverColor};`}
                        >
                            {ctaText || "Try it out"}
                            <svg
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                                class="sidebar-cta-arrow"
                            >
                                <path
                                    d="M5 12H19M19 12L12 5M19 12L12 19"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                ></path>
                            </svg>
                        </a>
                    )
                }
            </div>
        </div>

        <div class="sidebar-bottom">
            <nav class="toc-nav" style={`--toc-active-color: ${activeColor};`}>
                <ul class="toc-track">
                    {
                        sections.map((section, i) => (
                            <li class="toc-item">
                                <span class="toc-pill-wrap">
                                    <span class="toc-pill" />
                                </span>
                                <a
                                    href={`#${section.id}`}
                                    class="toc-link"
                                    data-target={section.id}
                                    data-index={i}
                                >
                                    {section.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>
            <div class="theme-toggle-wrapper">
                <ThemeToggle />
            </div>
        </div>
    </div>

    <article
        class={`right-content ${nextProject ? "has-next-project" : ""}`}
        style={`--project-category-color: ${activeColor}; --project-category-hover-color: ${hoverColor};`}
    >
        <slot />
        {nextProject && (
            <NextProjectBanner
                slug={nextProject.slug}
                title={nextProject.title}
                description={nextProject.description}
                tags={nextProject.tags}
                heroImage={nextProject.heroImage}
                category={nextProject.category}
            />
        )}
        <Footer />
    </article>
</Layout>

<script>
    let cleanupTOC: (() => void) | null = null;
    let cleanupThemeToggle: (() => void) | null = null;

    function setupTOCScroll() {
        if (cleanupTOC) {
            cleanupTOC();
            cleanupTOC = null;
        }

        const tocLinks = Array.from(
            document.querySelectorAll(".toc-link"),
        ) as HTMLAnchorElement[];

        const targets = tocLinks
            .map((link) => {
                const targetId = link.getAttribute("data-target");
                const element = targetId
                    ? document.getElementById(targetId)
                    : null;
                const pill = link.parentElement?.querySelector(
                    ".toc-pill",
                ) as HTMLElement | null;
                return { link, element, pill };
            })
            .filter((item) => item.element && item.pill) as {
            link: HTMLAnchorElement;
            element: HTMLElement;
            pill: HTMLElement;
        }[];

        if (targets.length === 0) return;

        function updateActiveDotStates() {
            // Compare card/section centers with viewport center
            const centers = targets.map((t) => {
                const rect = t.element.getBoundingClientRect();
                return rect.top + window.scrollY + rect.height / 2;
            });
            const T = window.scrollY + window.innerHeight / 2;

            // Find fractional index P
            let P = 0;

            // Check if user is scrolled near top of the page
            if (window.scrollY < 120) {
                P = 0;
            } else if (
                window.scrollY + window.innerHeight >=
                document.documentElement.scrollHeight - 60
            ) {
                // If at the very bottom, highlight the last section
                P = centers.length - 1;
            } else {
                for (let z = 0; z < centers.length - 1; z++) {
                    const G = centers[z];
                    const Y = centers[z + 1];
                    if (T >= G && T < Y) {
                        P = z + (T - G) / (Y - G);
                        break;
                    }
                }
                if (T >= centers[centers.length - 1]) {
                    P = centers.length - 1;
                }
            }

            P = Math.max(0, Math.min(centers.length - 1, P));

            // Apply continuous transition heights and opacities
            targets.forEach((t, index) => {
                const diff = Math.abs(P - index);
                if (diff < 1) {
                    // Morph from dot (5px) to line (16px)
                    const height = 5 + (16 - 5) * (1 - diff);
                    const alpha = 0.35 + 0.65 * (1 - diff);
                    t.pill.style.height = `${height}px`;
                    t.pill.style.opacity = `${alpha}`;
                    t.pill.style.backgroundColor = `var(--toc-active-color, var(--accent-secondary))`;

                    // Also dim/brighten the link text
                    const linkAlpha = 0.4 + 0.6 * (1 - diff);
                    t.link.style.opacity = `${linkAlpha}`;
                    t.link.style.fontWeight = diff < 0.5 ? "600" : "500";
                } else {
                    t.pill.style.height = "5px";
                    t.pill.style.opacity = "0.35";
                    t.pill.style.backgroundColor = "var(--text-muted)";

                    t.link.style.opacity = "0.4";
                    t.link.style.fontWeight = "500";
                }
            });
        }

        const handleScroll = () => {
            updateActiveDotStates();
        };

        const handleResize = () => {
            updateActiveDotStates();
        };

        window.addEventListener("scroll", handleScroll, { passive: true });
        window.addEventListener("resize", handleResize);

        cleanupTOC = () => {
            window.removeEventListener("scroll", handleScroll);
            window.removeEventListener("resize", handleResize);
        };

        updateActiveDotStates();
    }

    function setupThemeTogglePosition() {
        if (cleanupThemeToggle) {
            cleanupThemeToggle();
            cleanupThemeToggle = null;
        }

        const themeToggleWrapper = document.querySelector(
            ".theme-toggle-wrapper",
        ) as HTMLElement;
        const footer = document.querySelector(".site-footer");
        if (!themeToggleWrapper || !footer) return;

        function updateThemeTogglePosition() {
            if (!footer || !themeToggleWrapper) return;

            const footerRect = footer.getBoundingClientRect();
            const windowHeight = window.innerHeight;
            const margin = 20;

            if (footerRect.top < windowHeight) {
                const offset = windowHeight - footerRect.top + margin;
                themeToggleWrapper.style.setProperty(
                    "bottom",
                    `${offset}px`,
                    "important",
                );
            } else {
                themeToggleWrapper.style.setProperty(
                    "bottom",
                    "20px",
                    "important",
                );
            }
        }

        const handleScroll = () => {
            updateThemeTogglePosition();
        };
        const handleResize = () => {
            updateThemeTogglePosition();
        };

        window.addEventListener("scroll", handleScroll, { passive: true });
        window.addEventListener("resize", handleResize);

        cleanupThemeToggle = () => {
            window.removeEventListener("scroll", handleScroll);
            window.removeEventListener("resize", handleResize);
        };

        updateThemeTogglePosition();
    }

    function init() {
        setupTOCScroll();
        setupThemeTogglePosition();
    }

    // Run initial setup and listen for page loads (Astro view transitions support)
    document.addEventListener("DOMContentLoaded", init);
    document.addEventListener("astro:page-load", init);
</script>

<style>
    /* Sidebar Internal Styling */
    .project-sidebar-content {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
        font-family: var(--font-sans);
    }

    /* Allow scrolling if content is too tall */
    .sidebar-scroll-container {
        display: flex;
        flex-direction: column;
        gap: var(--space-xl);
    }

    .sidebar-top {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .sidebar-project-title {
        font-family: "Bricolage Grotesque", sans-serif;
        font-size: 54px;
        line-height: 0.9;
        font-weight: 400;
        margin-top: 9px;
        margin-bottom: 9px;
        letter-spacing: -0.05em;
    }

    .sidebar-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .sidebar-tags span {
        font-family: "Geist", sans-serif;
        font-size: 12px;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.035em;
        font-weight: 400;
        line-height: 1.2;
        display: inline-flex;
        align-items: center;
    }

    .sidebar-tags span:not(:last-child)::after {
        content: "•";
        margin-left: 0.5rem;
        opacity: 0.3;
    }

    .sidebar-project-desc {
        font-family: "Google Sans", sans-serif;
        font-size: 14px;
        font-weight: 300;
        color: var(--text-secondary);
        line-height: 1.2;
        letter-spacing: -0.01em;
        margin-bottom: 2rem;
    }

    .sidebar-cta-button {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5em;
        position: relative;
        background: var(--bg-surface, #ffffff);
        color: var(--cta-active-color, var(--accent-secondary)) !important;
        border: 1px solid var(--border-subtle, rgba(0, 0, 0, 0.15));
        padding: 9px 16px;
        border-radius: var(--radius-md);
        text-decoration: none;
        font-family: "Google Sans", sans-serif;
        font-weight: 600;
        font-size: 14px;
        letter-spacing: 0.05em;
        margin-top: 1.5rem;
        margin-bottom: 1rem;
        width: 100%;
        box-sizing: border-box;
        transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        cursor: pointer;
    }
    .sidebar-cta-button .sidebar-cta-arrow {
        display: inline-block;
        width: 26px;
        height: 26px;
        flex-shrink: 0;
        transition: transform 0.3s ease;
    }
    .sidebar-cta-button:hover {
        background: var(--cta-hover-color, var(--accent-secondary));
        border-color: var(--cta-hover-color, var(--accent-secondary));
        color: var(--bg-surface, #ffffff) !important;
    }
    .sidebar-cta-button:hover .sidebar-cta-arrow {
        transform: rotate(-45deg);
    }
    .sidebar-cta-button:active {
        background: var(--cta-active-color, var(--accent-secondary));
        border-color: var(--cta-active-color, var(--accent-secondary));
        color: var(--bg-surface, #ffffff) !important;
        filter: brightness(0.95);
    }

    /* TABLET/MOBILE STYLES */
    @media (max-width: 1024px) {
        .sidebar-cta-button {
            display: none;
        }

        .toc-nav {
            display: none;
        }

        .project-meta-table {
            display: none !important;
        }
    }

    .toc-nav {
        margin: 0.5rem 0;
    }

    .toc-track {
        list-style: none;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 1px; /* Reduced gap to compress spacing between lines */
        margin: 0;
        position: relative;
    }

    .toc-item {
        display: flex;
        align-items: center;
        gap: 16px; /* Compressed gap between dot and text */
        margin: 0;
        padding: 0;
        text-align: left;
        position: relative;
        cursor: pointer;
    }

    .toc-pill-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 8px;
        height: 16px; /* Compressed boundary */
        position: relative;
    }

    .toc-pill {
        display: block;
        width: 5px; /* Slightly smaller dot */
        height: 5px;
        background-color: var(--text-muted);
        opacity: 0.35;
        border-radius: 2.5px;
        will-change: height, opacity;
        transition:
            height 0.35s cubic-bezier(0.22, 1, 0.36, 1),
            background-color 0.25s ease,
            opacity 0.25s ease;
    }

    .toc-link {
        color: var(--text-primary);
        text-decoration: none;
        font-size: 24px;
        line-height: 1.2;
        transition:
            opacity 0.25s ease,
            font-weight 0.25s ease;
        display: inline-block;
        font-weight: 500;
        opacity: 0.4; /* Default muted opacity */
        font-family: "Bricolage Grotesque", sans-serif;
    }

    .toc-item:hover .toc-pill {
        height: 16px !important;
        opacity: 1 !important;
        background-color: var(
            --toc-active-color,
            var(--accent-secondary)
        ) !important;
    }

    .toc-item:hover .toc-link {
        opacity: 1 !important;
        font-weight: 600 !important;
    }

    /* META TABLE STYLES */
    .sidebar-bottom {
        display: flex;
        flex-direction: column;
        padding-top: 2rem;
    }

    .project-meta-table {
        display: flex;
        flex-direction: column;
        border-top: 1px solid var(--border-subtle);
        padding-top: 0; /* Removed 16px padding */
    }

    .meta-row {
        display: grid;
        grid-template-columns: 100px 1fr; /* Fixed Label width, increased to prevent overlap */
        gap: 1rem;
        padding: 0.3rem 0;
        border-bottom: 1px solid var(--border-subtle);
        font-size: var(--text-sm);
    }

    .meta-label {
        font-family: "Google Sans", sans-serif;
        font-size: 14px;
        font-weight: 400;
        color: var(--text-primary);
        letter-spacing: 0.015em;
        line-height: 1.5;
    }

    .meta-value {
        font-family: "Google Sans", sans-serif;
        font-size: 14px;
        font-weight: 300;
        color: var(--text-secondary);
        letter-spacing: 0em;
        line-height: 1.15;
    }

    .theme-toggle-wrapper {
        position: fixed !important;
        bottom: 20px !important;
        right: 20px !important;
        z-index: 100;
        margin: 0 !important;
        padding: 0 !important;
    }

    /* RIGHT CONTENT STYLES (Hero Section) */
    /* Note: Content is positioned on the right side on desktop */
    .right-content {
        padding: 20px 20px 0px 20px; /* 20px top/left/right, bottom 0px */
        max-width: none; /* Use full available width */
        margin: 0;
        font-family: var(--font-sans);
        scroll-behavior: auto;
    }

    /* Remove redundant top margin from first element (Hero Image usually) */
    .right-content > :global(:first-child) {
        margin-top: 0 !important;
    }

    /* Ensure scroll margin for anchors so sticky headers don't cover them */
    .right-content :global(section) {
        scroll-margin-top: 2rem;
    }

    @media (max-width: 1024px) {
        .right-content {
            padding: 20px;
        }

        /* Hide TOC on mobile */
        .toc-nav {
            display: none;
        }

        /* Fixed Theme Toggle on Mobile */
        .theme-toggle-wrapper {
            position: fixed !important;
            right: 48px !important;
            left: auto !important;
            z-index: 90;
            margin-top: 0;
        }

        /* Allow sidebar to collapse vertically */
        .project-sidebar-content {
            height: auto;
            display: block;
        }
    }

    @media (max-width: 768px) {
        .theme-toggle-wrapper {
            right: 24px !important;
        }

        .project-meta-table {
            display: none !important;
        }
    }

    /* Force 240px margin for footer on project pages */
    .right-content :global(.site-footer) {
        margin-top: 240px !important;
    }

    .right-content.has-next-project :global(.site-footer) {
        margin-top: 0 !important;
    }

    /* Smart Spacing: If section follows a visual, keep tight margin (new topic separation handled by image's bottom margin) */
    .right-content :global(.full-width-image + .project-section),
    .right-content :global(iframe + .project-section),
    .right-content :global(.figma-container + .project-section),
    .right-content :global(.pdf-viewer-wrapper + .project-section) {
        margin-top: 0.5rem !important; /* Tight - image's large bottom margin provides separation */
    }

    /* Images/PDFs after sections get REDUCED top margin (text above describes the image) */
    .right-content :global(.project-section + .full-width-image),
    .right-content :global(.project-section + .figma-container),
    .right-content :global(.project-section + .pdf-viewer-wrapper) {
        margin-top: 1rem !important; /* Tight - text above describes this image */
    }

    /* Style inline section headings to match ProjectSection title styling */
    .right-content :global(.inline-section-title) {
        font-family: "Google Sans", sans-serif !important;
        font-size: 12px !important;
        font-weight: 800 !important;
        color: var(--project-category-hover-color, var(--accent-secondary, #42bd49)) !important;
        line-height: 1.2 !important;
        letter-spacing: 0.05em !important;
        text-transform: uppercase !important;
        margin-top: 3.5rem !important;
        margin-bottom: 1.5rem !important;
        display: block !important;
    }
</style>
